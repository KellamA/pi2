#!/bin/bash
# Keeps a GitHub issue for each piece of agent work, so the repository has a
# record of what was done and a backlog of what might come next.
#
# Every command that changes an issue's state prints one line starting with
# "[pi2-issue]", at the start of a line. The hooks in scripts/issue-hook read
# those lines back from the output of the commands in the session transcript
# that ran this script, to know which issue a session is working on, so keep
# the wording stable.
#
# See CLAUDE.md for when agents use each command.

set -euo pipefail

usage() {
	cat <<'EOF'
Usage: scripts/issue <command> [arguments]

  start "Title" [-b body] [-l label]...   Open an issue for work you are starting
  take N                                   Pick up an existing issue (or resume a paused one)
  note N "text"                            Add a progress note
  wait N "what for"                        Mark it waiting on the person (keeps it open)
  block N "why"                            Mark it blocked (keeps it open)
  done N "summary"                         Close it as finished, with a summary
  drop N "why"                             Close it as not going ahead
  idea "Title" [-b body] [-l label]...     File something for later in the backlog
  skip "why"                               Go ahead without an issue (GitHub unreachable,
                                           or the person said not to track this)
  list                                     Show open issues by status
  audit [--since DATE]                     List what is wrong on the board; exits 1 if anything
                                           is (changes nothing). DATE limits the check for a
                                           missing Done summary to issues closed since then.

A text can be given as --body-file FILE instead, for a long one that should not
pass through the shell: in place of -b for start and idea, and in place of the
text for note, wait, block, done and drop. Give a text or a file, not both.
EOF
}

die() { echo "issue: $*" >&2; exit 1; }

# Issues are public: never publish a home folder path.
clean() { local s=${1-} t='~'; printf '%s' "${s//"$HOME"/$t}"; }

branch() { git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown"; }

STATUS_LABELS=("in progress" "waiting" "blocked" "backlog")

ensure_labels() {
	local stamp
	stamp="$(git rev-parse --git-common-dir)/pi2-issue-labels"
	[[ -f $stamp ]] && return
	gh label create "agent" --color 5319e7 --description "Opened by an agent session" --force >/dev/null
	gh label create "in progress" --color fbca04 --description "Being worked on now" --force >/dev/null
	gh label create "waiting" --color c5def5 --description "Waiting on a decision or review" --force >/dev/null
	gh label create "blocked" --color b60205 --description "Cannot go on until something else changes" --force >/dev/null
	gh label create "backlog" --color ededed --description "Not started; a candidate for later" --force >/dev/null
	touch "$stamp"
}

# Replace whichever status label the issue has with the given one (or none).
set_status() {
	local n=$1 status=${2-} args=() l
	ensure_labels
	for l in "${STATUS_LABELS[@]}"; do
		[[ $l == "$status" ]] || args+=(--remove-label "$l")
	done
	[[ -n $status ]] && args+=(--add-label "$status")
	gh issue edit "$n" "${args[@]}" >/dev/null
}

# "audit" looks for a missing Done summary only on issues closed after this, when
# "done" started posting its summary on issues that were closed already (#147).
AUDIT_SINCE=2026-11-17T04:00:00Z

need_number() { [[ ${1-} =~ ^[0-9]+$ ]] || die "expected an issue number, got '${1-}'"; }

# A long text goes in a file given with --body-file rather than in the command,
# since a body with backticks in a shell argument or here-document can be run as
# commands. Both ways put the text in $text. A file that is not there, or cannot
# be read, is an error naming it, before anything is asked of GitHub.
read_body_file() {
	local f=$1
	[[ -f $f && -r $f ]] || die "cannot read the body file $f"
	text=$(<"$f")
}

# The text that follows an issue number: given directly, or with --body-file.
read_text() {
	local file=""
	text=""
	while (($#)); do
		case $1 in
			--body-file)
				[[ -z $file ]] || die "one --body-file at most"
				file=${2-}; shift 2 || die "--body-file needs a file name"
				;;
			*)
				[[ -z $text ]] || die "expected one text"
				text=$1; shift ;;
		esac
	done
	[[ -z $text || -z $file ]] || die "give the text or --body-file, not both"
	[[ -z $file ]] || read_body_file "$file"
}

create() {
	local status=$1; shift
	local title=${1-}; shift || true
	[[ -n $title ]] || die "a title is required"
	local body="" body_file="" labels=(agent "$status")
	while (($#)); do
		case $1 in
			-b|--body) body=$2; shift 2 ;;
			--body-file) body_file=${2-}; shift 2 || die "--body-file needs a file name" ;;
			-l|--label) labels+=("$2"); shift 2 ;;
			*) die "unknown option $1" ;;
		esac
	done
	[[ -z $body || -z $body_file ]] || die "give -b or --body-file, not both"
	if [[ -n $body_file ]]; then
		read_body_file "$body_file"
		body=$text
	fi
	local footer
	if [[ $status == "backlog" ]]; then
		footer="_Filed by an agent session on branch \`$(branch)\`._"
	else
		footer="_Opened by an agent session on branch \`$(branch)\`._"
	fi
	body="${body:+$body

}$footer"
	local args=(--title "$(clean "$title")" --body "$(clean "$body")")
	local l
	for l in "${labels[@]}"; do args+=(--label "$l"); done
	[[ $status == "in progress" ]] && args+=(--assignee @me)
	gh issue create "${args[@]}"
}

cmd=${1-}; shift || true
case $cmd in
	start)
		ensure_labels
		url=$(create "in progress" "$@")
		echo "[pi2-issue] opened #${url##*/} $url"
		;;
	idea)
		ensure_labels
		url=$(create "backlog" "$@")
		echo "[pi2-issue] filed #${url##*/} $url"
		;;
	take)
		need_number "${1-}"
		ensure_labels
		state=$(gh issue view "$1" --json state -q .state)
		# Label it before reopening it: the issue-labels workflow puts "backlog" on
		# an issue reopened with no status label, and would race with this.
		set_status "$1" "in progress"
		[[ $state == "CLOSED" ]] && gh issue reopen "$1" >/dev/null
		gh issue edit "$1" --add-label agent --add-assignee @me >/dev/null
		gh issue comment "$1" --body "Picked up by an agent session on branch \`$(branch)\`." >/dev/null
		echo "[pi2-issue] working on #$1 $(gh issue view "$1" --json url -q .url)"
		;;
	note)
		need_number "${1-}"; read_text "${@:2}"; [[ -n $text ]] || die "note text is required"
		gh issue comment "$1" --body "$(clean "$text")" >/dev/null
		echo "Noted on #$1."
		;;
	wait|block)
		need_number "${1-}"; read_text "${@:2}"; [[ -n $text ]] || die "say what it is waiting on"
		if [[ $cmd == wait ]]; then label=waiting; title=Waiting; else label=blocked; title=Blocked; fi
		set_status "$1" "$label"
		gh issue comment "$1" --body "$(clean "**$title:** $text")" >/dev/null
		echo "[pi2-issue] paused #$1 ($label)"
		;;
	done|drop)
		need_number "${1-}"; read_text "${@:2}"; [[ -n $text ]] || die "a summary is required"
		sha=$(git rev-parse --short HEAD 2>/dev/null || true)
		if [[ $cmd == done ]]; then
			msg="**Done.** $text"$'\n\n'"Branch \`$(branch)\`${sha:+, at $sha}."
			reason=completed api_reason=completed gh_reason=COMPLETED
		else
			msg="**Not going ahead.** $text"
			reason="not planned" api_reason=not_planned gh_reason=NOT_PLANNED
		fi
		# The issue is usually closed already, by a pull request with "Fixes #N",
		# and "gh issue close --comment" posts nothing on a closed issue. So the
		# summary goes on as a comment of its own, first, and the issue is closed
		# only if it is still open.
		gh issue comment "$1" --body "$(clean "$msg")" >/dev/null
		set_status "$1" ""
		closed=$(gh issue view "$1" --json state,stateReason -q '.state + " " + (.stateReason // "")')
		if [[ $closed == OPEN* ]]; then
			gh issue close "$1" --reason "$reason" >/dev/null
			echo "[pi2-issue] closed #$1 ($reason)"
		else
			# Closed already, perhaps for another reason: make the reason this one.
			[[ $closed == "CLOSED $gh_reason" ]] ||
				gh api -X PATCH "repos/{owner}/{repo}/issues/$1" -f state=closed -f state_reason="$api_reason" >/dev/null
			echo "[pi2-issue] closed #$1 ($reason, was already closed; summary posted)"
		fi
		;;
	skip)
		[[ -n ${1-} ]] || die "say why this work is not tracked"
		echo "[pi2-issue] skipped: $1"
		;;
	list)
		for status in "in progress" "waiting" "blocked" "backlog"; do
			echo "== $status"
			gh issue list --label "$status" --state open --limit 50 \
				--json number,title -q '.[] | "  #\(.number)  \(.title)"'
		done
		echo "== other open"
		gh issue list --state open --limit 50 --json number,title,labels \
			-q '.[] | select([.labels[].name] | any(. == "in progress" or . == "waiting" or . == "blocked" or . == "backlog") | not) | "  #\(.number)  \(.title)"'
		;;
	audit)
		since=$AUDIT_SINCE
		while (($#)); do
			case $1 in
				--since) since=${2-}; shift 2 || die "--since needs a date" ;;
				*) die "unknown option $1" ;;
			esac
		done
		[[ $since =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] && since+="T00:00:00Z"
		[[ $since =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]] ||
			die "--since takes a date such as 2026-11-17, or a UTC time such as 2026-11-17T09:00:00Z"
		issues=$(gh issue list --state all --limit 5000 \
			--json number,state,stateReason,labels,updatedAt,closedAt)
		# One line per problem, "<number>\t<what is wrong>", in order of number.
		problems=$(jq -r '
			def status: [.labels[].name | select(. == "in progress" or . == "waiting" or . == "blocked" or . == "backlog")];
			sort_by(.number)[] |
			(status) as $s |
			if .state == "CLOSED" then
				if ($s | length) > 0 then "\(.number)\tclosed, but still labelled \($s | map("\"\(.)\"") | join(" and "))" else empty end
			else
				if ($s | length) == 0 then "\(.number)\topen with no status label"
				elif ($s | length) > 1 then "\(.number)\topen with \($s | length) status labels: \($s | join(", "))"
				elif $s[0] == "in progress" and (.updatedAt | fromdateiso8601) < (now - 86400) then
					"\(.number)\tin progress, but nothing has happened on it since \(.updatedAt)"
				else empty end
			end' <<<"$issues")
		# Closed as completed by agent work since $since: it should carry the
		# summary that "done" posts. Comments are fetched only for these.
		candidates=$(jq -r --arg since "$since" '
			.[] | select(.state == "CLOSED" and .stateReason == "COMPLETED"
				and any(.labels[]; .name == "agent")
				and .closedAt != null and (.closedAt | fromdateiso8601) >= ($since | fromdateiso8601)) |
			.number' <<<"$issues" | sort -n)
		for n in $candidates; do
			summaries=$(gh issue view "$n" --json comments \
				-q '[.comments[] | select(.body | startswith("**Done.**"))] | length')
			if [[ $summaries == 0 ]]; then
				problems+="${problems:+$'\n'}$n"$'\t'"closed as completed, but has no **Done.** summary"
			fi
		done
		if [[ -z $problems ]]; then
			echo "The board is in order."
		else
			sort -n -s -k1,1 <<<"$problems" | awk -F '\t' '{ printf "#%s  %s\n", $1, $2 }'
			count=$(wc -l <<<"$problems" | tr -d ' ')
			echo "$count problem$( ((count == 1)) || echo s) on the board."
			exit 1
		fi
		;;
	""|-h|--help|help) usage ;;
	*) usage >&2; exit 1 ;;
esac
