	answers 0 "Yes: computer use can read and click test-7 now" can-click test-7
kill "$RESPONDER_PID" 2>/dev/null
rm -f -- "$T/reach-asked"
# A no only where the copy says the tool's search would not find its window.
respond '{"error":"the app does not give its main window to accessibility, even after raising it: it is not the app'\''s main or focused window, nor among its windows, so the computer tool would not find it"}'
PATH="$T/bin:$PATH" CAN_CLICK_APP=yes CAN_CLICK_WINDOW=yes HOME="$T/home" \
	answers 1 "no, computer use cannot click in test-7: the app does not give its main window to accessibility" can-click test-7
kill "$RESPONDER_PID" 2>/dev/null
# And where the copy says the tool, having found the window, would turn it down for the window server's record (#748).
respond '{"error":"the window server has the main window at 1120×740 at (2880, 1130) and accessibility gives it at 1120×700 at (1760, 1130), so the computer tool would not take it as the same window"}'
PATH="$T/bin:$PATH" CAN_CLICK_APP=yes CAN_CLICK_WINDOW=yes HOME="$T/home" \
	answers 1 "no, computer use cannot click in test-7: the window server has the main window at 1120×740" can-click test-7
kill "$RESPONDER_PID" 2>/dev/null
respond '{"error":"the window server has no record of the main window, which accessibility gives at 1120×740 at (1760, 1130), so the computer tool would not take it"}'
PATH="$T/bin:$PATH" CAN_CLICK_APP=yes CAN_CLICK_WINDOW=yes HOME="$T/home" \
	answers 1 "no, computer use cannot click in test-7: the window server has no record of the main window" can-click test-7
kill "$RESPONDER_PID" 2>/dev/null
# The size alone is taken only for the app's main window, and only with no other window of the copy that size (#770).
respond '{"error":"the window server has the main window at 1120×740 at (3560, 1130) and accessibility gives it at 1120×740 at (1760, 1130), and another window of the copy is that size too, so it cannot be told by its size alone, so the computer tool would not take it as the same window"}'
PATH="$T/bin:$PATH" CAN_CLICK_APP=yes CAN_CLICK_WINDOW=yes HOME="$T/home" \
	answers 1 "no, computer use cannot click in test-7: the window server has the main window at 1120×740 at (3560, 1130) and accessibility gives it at 1120×740 at (1760, 1130), and another window of the copy is that size too" can-click test-7
kill "$RESPONDER_PID" 2>/dev/null
# What #612 was: a copy's answer that is not that, such as the window list's "did not join", which the tool read
# through regardless, is never a no.
respond '{"error":"the main window did not join the app'\''s accessibility window list when raised"}'
PATH="$T/bin:$PATH" CAN_CLICK_APP=yes CAN_CLICK_WINDOW=yes HOME="$T/home" \
	answers 2 "cannot tell from here whether computer use can click in test-7: the copy did not say" can-click test-7
kill "$RESPONDER_PID" 2>/dev/null
respond '{"error":"unknown test-copy window command"}'
PATH="$T/bin:$PATH" CAN_CLICK_APP=yes CAN_CLICK_WINDOW=yes HOME="$T/home" \
	answers 2 "predates the request that raises its parked window" can-click test-7
kill "$RESPONDER_PID" 2>/dev/null
# Put back the symlinked data folder the reopen refusal below expects, and stop the stand-in app.
