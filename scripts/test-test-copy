respond "{\"result\":\"$raised\"}"
PATH="$T/bin:$PATH" CAN_CLICK_APP=yes CAN_CLICK_WINDOW=yes HOME="$T/home" \
	answers 0 "cannot be told from here: whether pi² has the Accessibility permission" can-click test-7
kill "$RESPONDER_PID" 2>/dev/null
# Asked at once after start or reopen, before the window is drawn, it waits for the window rather than saying no (#612).
