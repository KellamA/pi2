#!/bin/bash
# Checks what scripts/test-copy refuses before it changes anything, in a stand-in checkout in a temporary folder:
# suffixes that are not its own, a missing build, a release build, a build of another checkout, a suffix already
# started, a stop, call or picture for a copy that was not started, malformed call params, socket symlinks and a
# picture outside the checkout. Also checks shot's retry and permission handling with stand-ins for macOS.
# Launches no app and touches nothing outside the temporary folder. Starting, capturing and stopping a real copy
# is checked by hand, as CONTRIBUTING.md says.
#
#   scripts/test-test-copy

set -uo pipefail

script="$(cd -P -- "$(dirname -- "$0")" && pwd -P)/test-copy"

T=$(mktemp -d)
trap 'rm -rf "$T"' EXIT
T=$(cd -P -- "$T" && pwd -P)

root=$T/checkout
mkdir -p "$root/scripts" "$root/app/build"
cp "$script" "$root/scripts/test-copy"
cp "$(dirname -- "$script")/test-copy-send.mjs" "$(dirname -- "$script")/test-copy-drive.mjs" "$root/scripts/"
copy=$root/scripts/test-copy

failures=0
# expect <what it should say> <arguments...>: the command must fail, say that, and leave the stand-in as it was.
expect() {
	local want=$1; shift
	local before after out
	before=$(cd "$T" && find . | sort)
	out=$("$copy" "$@" 2>&1)
	local status=$?
	after=$(cd "$T" && find . | sort)
	if ((status == 0)) || [[ $out != *"$want"* ]]; then
		echo "FAIL: test-copy $*"
		echo "  wanted a refusal saying: $want"
		echo "  got (exit $status): $out"
		failures=$((failures + 1))
	elif [[ $before != "$after" ]]; then
		echo "FAIL: test-copy $* changed the stand-in checkout"
		diff <(echo "$before") <(echo "$after") | sed 's/^/  /'
		failures=$((failures + 1))
	else
		echo "ok: test-copy $* ($want)"
	fi
}

expect "a suffix is required" start
expect "a suffix is required" start ""
expect "is not a suffix" start Test-7
expect "is not a suffix" start ../pi2
expect "is not a suffix" start "a b"
expect "is not a suffix" start -x
expect "is not a suffix" start test-7-
expect "is not a suffix" start "test.7"
expect "is too long" start test-7-with-a-suffix-much-too-long-for-a-socket
expect "'dev' is the suffix every development build has" start dev
expect "a suffix is required" stop
expect "a suffix is required" shot
expect "a suffix is required" call
expect "a suffix is required" send
expect "'dev' is the suffix every development build has" send dev 8 hello
expect "is not a suffix" send ../pi2 8 hello
expect "is too long" send test-7-with-a-suffix-much-too-long-for-a-socket 8 hello
expect "use: scripts/test-copy send" send test-7
expect "use: scripts/test-copy send" send test-7 8
expect "--timeout needs seconds" send test-7 8 hello --timeout
expect "unknown option --bogus" send test-7 8 hello --bogus
expect "a suffix is required" reopen
expect "'dev' is the suffix every development build has" reopen dev
expect "is not a suffix" reopen ../pi2
expect "is too long" reopen test-7-with-a-suffix-much-too-long-for-a-socket
expect "--show needs what to open on" reopen test-7 --show
expect "--show takes one line" reopen test-7 --show $'one\ntwo'
expect "unknown option --bogus" reopen test-7 --bogus
for command in show size sidebar choose answer fill answer-of can-click pair attach; do
	expect "a suffix is required" "$command"
	expect "is not a suffix" "$command" ../pi2
	expect "'dev' is the suffix every development build has" "$command" dev
done
expect "use: scripts/test-copy show" show test-7
expect "--hub needs both" show test-7 'project:Demo project#work' --hub folded
expect "use: scripts/test-copy show" show test-7 8 --hub both
expect "use: scripts/test-copy answer-of" answer-of test-7
expect "use: scripts/test-copy answer-of" answer-of test-7 8
expect "--timeout needs seconds" answer-of test-7 8 42 --timeout
expect "unknown option --bogus" answer-of test-7 8 42 --bogus
expect "--appearance needs light or dark" start test-8 --appearance purple
expect "--appearance needs light or dark" start test-8 --appearance
expect "--appearance needs light or dark" reopen test-7 --appearance system
expect "--hub needs both" reopen test-7 --hub
expect "use: scripts/test-copy size" size test-7 820
expect "use: scripts/test-copy size" size test-7 smallest 532
expect "use: scripts/test-copy sidebar" sidebar test-7
expect "use: scripts/test-copy sidebar" sidebar test-7 widest
expect "use: scripts/test-copy sidebar" sidebar test-7 0
expect "use: scripts/test-copy sidebar" sidebar test-7 250 300
expect "use: scripts/test-copy answer" answer test-7 8 always
expect "use: scripts/test-copy fill" fill test-7 600 extra
expect "use: scripts/test-copy choose" choose test-7
expect "use: scripts/test-copy can-click" can-click test-7 extra
# A phone in the simulator (#681): pair and attach's options, checked before anything is asked of a copy.
for command in pair attach; do
	expect "unknown option --bogus" "$command" test-7 --bogus
	expect "--sim needs the name of a simulator" "$command" test-7 --sim
	expect "--show needs the phone's route" "$command" test-7 --show
	expect "--show takes one line" "$command" test-7 --show $'home\nsettings'
	expect "--env needs NAME=VALUE for the phone's app" "$command" test-7 --env
	expect "--env needs NAME=VALUE for the phone's app" "$command" test-7 --env PI2_HUB_ACT
	expect "--env needs NAME=VALUE for the phone's app" "$command" test-7 --env 'lower=case'
	for key in PI2_PAIR PI2_TRANSPORT PI2_SHOW; do
		expect "--env does not take $key: this script sets it" "$command" test-7 --env "$key=x"
	done
done
expect "a suffix is required" last-copy
expect "is not a suffix" last-copy ../pi2
expect "use: scripts/test-copy last-copy" last-copy test-7 extra
for suffix in dev ../pi2 Test-7 test-7-with-a-suffix-much-too-long-for-a-socket; do
	case $suffix in
		dev) want="'dev' is the suffix every development build has" ;;
		*-socket) want="is too long" ;;
		*) want="is not a suffix" ;;
	esac
	expect "$want" call "$suffix" engine.info
done
expect "use: scripts/test-copy call" call test-7
expect "use: scripts/test-copy call" call test-7 engine.info '{}' extra
expect "a suffix is required" socket
expect "is not a suffix" socket ../pi2
expect "'dev' is the suffix every development build has" socket dev
expect "use: scripts/test-copy socket" socket test-7 extra
expect "a suffix is required" conversations
expect "is not a suffix" conversations ../pi2
expect "'dev' is the suffix every development build has" conversations dev
expect "use: scripts/test-copy conversations" conversations test-7 extra

expect "there is no development build" start test-7

mkdir -p "$root/app/build/pi².app/Contents"
expect "there is only a release build here" start test-7
rm -rf "$root/app/build/pi².app"

dev="$root/app/build/pi² dev.app"
mkdir -p "$dev/Contents/Resources/engine"
/usr/libexec/PlistBuddy -c "Add :CFBundleIdentifier string dev.pi2.app" "$dev/Contents/Info.plist" >/dev/null
expect "is not a development build" start test-7
rmdir "$dev/Contents/Resources/engine"
expect "is not a development build" start test-7
/usr/libexec/PlistBuddy -c "Add :PI2EngineMain string /elsewhere/engine/src/main.ts" "$dev/Contents/Info.plist"
expect "not this checkout's" start test-7

mkdir -p "$root/engine/src"
touch "$root/engine/src/main.ts"
/usr/libexec/PlistBuddy -c "Set :PI2EngineMain $root/engine/src/main.ts" "$dev/Contents/Info.plist"
expect "the engine's packages are not installed" start test-7
mkdir "$root/engine/node_modules"

# A copy of that name started from this checkout already, or starting: its folder is there.
mkdir -p "$root/app/build/test-copies/test-7"
expect "is already started, or starting, from this checkout" start test-7
expect "no copy named test-7 was started from this checkout" call test-7 engine.info
expect "unknown option --bogus" start test-8 --bogus
expect "--show needs what to open on" start test-8 --show
# --welcome is an option of start's, taking no value: the option after it is still read, and refused.
expect "unknown option --bogus" start test-8 --welcome --bogus
expect "unknown option --bogus" start test-8 --no-app-nap --bogus
expect "unknown option --bogus" start test-8 --show activity --welcome --bogus
expect "--env needs NAME=VALUE" start test-8 --env
expect "--env needs NAME=VALUE" start test-8 --env PI2_DEMO_COST
expect "--env takes one line" start test-8 --env $'PI2_DEMO_COST=5\nPI2_HOME=elsewhere'
expect "--env takes one line" start test-8 --env $'PI2_DEMO_COST=5\r'
for key in PI2_HOME PI2_KEYCHAIN_SERVICE PI2_SHOW PI2_HUB PI2_TEST_COPY PI2_LOGIN_SHELL PI2_DEMO_UNKNOWN PI2_UNPLACED_HANDLER PATH HOME DYLD_INSERT_LIBRARIES ''; do
	expect "--env does not allow" start test-8 --env "$key=value"
done
expect "--env repeats PI2_DEMO_COST" start test-8 --env PI2_DEMO_COST=1 --env PI2_DEMO_COST=2
for key in PI2_DEMO_PICTURES PI2_DEMO_TEXT_MODEL PI2_DEMO_COST PI2_DEMO_TOKENS_PER_SECOND PI2_DEMO_COMPACTION_GATE PI2_GH \
	PI2_REMOTE_STAND_IN PI2_APP_ATTEST_STAND_IN PI2_APP_ATTEST_TEAM; do
	expect "unknown option --bogus" start test-8 --env "$key=explicit value=with equals" --bogus
done
# start --fill seeds the data folder before the first start (#779): what it takes, checked before anything is made.
expect "--fill needs a number of entries" start test-8 --fill
expect "--fill needs a number of entries" start test-8 --fill bogus
expect "--fill needs a number of entries" start test-8 --fill 0
expect "--fill needs a number of entries" start test-8 --fill project:
expect "--fill makes at most 10000 entries" start test-8 --fill 10001
expect "--fill project:<count> makes 1 to 8" start test-8 --fill project:9
expect "--fill project:<count> makes 1 to 8" start test-8 --fill project:0
expect "--fill takes one line" start test-8 --fill $'project:One\nTwo'
expect "unknown option --bogus" start test-8 --fill 600 --fill project --fill project:Sample --fill project:3 --bogus
expect "unknown option --bogus" start test-8 --env PI2_DEMO_COST= --env PI2_DEMO_TEXT_MODEL=1 --bogus
expect "--hub needs both" start test-8 --hub bogus
expect "unknown option --bogus" start test-8 --show 'project:Demo project#notes' --hub conversation-folded --bogus
expect "--menu needs the label" start test-8 --menu
expect "--menu needs the label" start test-8 --menu ""
expect "--menu takes one line" start test-8 --menu $'Atlas\nForge'
expect "unknown option --bogus" start test-8 --menu "Fix the login bug" --bogus
expect "unknown option --bogus" start test-8 --remote --bogus
expect "unknown option --bogus" start test-8 --fill project --remote --show 'project:Demo project' --bogus
rmdir "$root/app/build/test-copies/test-7" "$root/app/build/test-copies"
# The stand-in build names no Node, which --fill needs to start the copy's engine before the app; refused before the
# suffix is claimed.
expect "does not say which Node runs its engine" start test-8 --fill 600

expect "no copy named test-7 was started from this checkout" send test-7 8 hello
PI2_HOME="$T" expect "no copy named test-7 was started from this checkout" send test-7 8 hello
PI2_HOME="$T" expect "no copy named test-7 was started from this checkout" answer-of test-7 8 42
expect "no copy named test-7 was started from this checkout" reopen test-7
PI2_HOME="$T" expect "no copy named test-7 was started from this checkout" show test-7 8
# Every page PI2_SHOW takes goes through the argument checks, not "conversation must be a positive integer" (#553).
# A #<section> goes to the copy with the page, which takes it as at launch (#768).
for page in activity usage archive 'settings:general' 'settings:chat#memory' 'agent:atlas' 'agent:atlas#computer' \
	'palette:duplicate' 'project:Demo project#work'; do
	PI2_HOME="$T" expect "no copy named test-7 was started from this checkout" show test-7 "$page"
done
expect "no copy named test-7 was started from this checkout" size test-7 smallest
expect "no copy named test-7 was started from this checkout" sidebar test-7 narrowest
PI2_HOME="$T" expect "no copy named test-7 was started from this checkout" choose test-7 cancel
expect "no copy named test-7 was started from this checkout" answer test-7 8 allow
expect "no copy named test-7 was started from this checkout" fill test-7 600
expect "no copy named test-7 was started from this checkout" fill test-7 --project
expect "no copy named test-7 was started from this checkout" answer test-7 n1 '{"kind":"question","text":"Friday"}'
PI2_HOME="$T" expect "no copy named test-7 was started from this checkout" last-copy test-7
expect "no copy named test-7 was started from this checkout" stop test-7
expect "no copy named test-7 was started from this checkout" status test-7
expect "no copy named test-7 was started from this checkout" can-click test-7
expect "no copy named test-7 was started from this checkout" pair test-7
PI2_HOME="$T" expect "no copy named test-7 was started from this checkout" pair test-7 --sim pi2-7 --show home --env PI2_HUB_ACT=send:Hello
expect "no copy named test-7 was started from this checkout" attach test-7
expect "no copy named test-7 was started from this checkout" call test-7 engine.info
# An inherited data-folder override cannot make an unowned copy callable.
PI2_HOME="$T" expect "no copy named test-7 was started from this checkout" call test-7 engine.info
expect "no copy named test-7 was started from this checkout" socket test-7
PI2_HOME="$T" expect "no copy named test-7 was started from this checkout" socket test-7
PI2_HOME="$T" expect "no copy named test-7 was started from this checkout" conversations test-7
expect "say where to put the picture" shot test-7
expect "give a file name ending in .png" shot test-7 "$root/picture.jpg"
expect "refusing to write" shot test-7 "$T/outside.png"
expect "refusing to write" shot test-7 /tmp/outside.png
expect "there is no folder" shot test-7 "$root/no/such/folder/picture.png"
expect "no copy named test-7 was started from this checkout" shot test-7 "$root/picture.png"

# start skips the first-run welcome by writing the engine's own setting into the copy's settings.json, as
# settings.finishOnboarding does. If the engine ever names it otherwise, the welcome comes back over every picture.
engine="$(dirname -- "$script")/../engine/src/main.ts"
settingsRequests="$(dirname -- "$script")/../engine/src/settingsrequests.ts"
if ! grep -qF 'settings.onboarded = true;' "$settingsRequests"; then
	echo "FAIL: engine/src/settingsrequests.ts no longer marks the welcome done with settings.onboarded; change what test-copy start writes"
	failures=$((failures + 1))
elif ! grep -qF 'const settingsPath = join(home, "settings.json");' "$engine"; then
	echo "FAIL: engine/src/main.ts no longer keeps its settings in settings.json; change where test-copy start writes them"
	failures=$((failures + 1))
elif ! grep -qF "printf '{\n\t\"onboarded\": true\n}\n' >\"\$DATA/settings.json\"" "$script"; then
	echo "FAIL: test-copy start no longer writes onboarded: true into the copy's settings.json"
	failures=$((failures + 1))
else
	echo "ok: test-copy start marks the welcome done as the engine reads it"
fi

# The demo switches start --env passes are honoured only by a development engine, which needs every one of them to be
# fenced through testSwitch (engine/src/testswitches.ts, #720); PI2_GH alone is read by every engine (#779).
allowed=$(sed -n 's/^		\(PI2_[A-Z0-9_|]*\)) ;;$/\1/p' "$script" | tr '|' ' ')
unfenced=""
for key in $allowed; do
	[[ $key == PI2_GH ]] && continue
	grep -qF "	\"$key\"," "$(dirname -- "$script")/../engine/src/testswitches.ts" || unfenced+=" $key"
done
if [[ -z $allowed || $allowed != *PI2_DEMO_COMPACTION_GATE* ]]; then
	echo "FAIL: could not read test-copy's allowlist of --env names, or it lacks PI2_DEMO_COMPACTION_GATE"
	failures=$((failures + 1))
elif [[ -n $unfenced ]]; then
	echo "FAIL: test-copy start --env allows switches that are not in TEST_SWITCHES (engine/src/testswitches.ts):$unfenced"
	failures=$((failures + 1))
else
	echo "ok: every demo switch start --env allows is a test switch the engine fences"
fi

# start --remote gives the copy's engine the one switch with which it takes a pairing claim with no attestation, from
# the simulator (#681): a test switch the engine fences, read in devices.ts together with testCopySuffix, the check
# of PI2_TEST_COPY against the copy's own folders that main.ts makes for its fixtures.
devices_src="$(dirname -- "$script")/../engine/src/devices.ts"
if ! grep -qxF 'REMOTE_ENV=PI2_PAIR_UNATTESTED=1' "$script" ||
	! grep -qF '	"PI2_PAIR_UNATTESTED",' "$(dirname -- "$script")/../engine/src/testswitches.ts" ||
	! grep -qF 'testCopySuffix() !== undefined && testSwitch("PI2_PAIR_UNATTESTED") === "1"' "$devices_src" ||
	! grep -qF 'const testSuffix = testCopySuffix();' "$(dirname -- "$script")/../engine/src/main.ts"; then
	echo "FAIL: test-copy start --remote, TEST_SWITCHES and devices.ts no longer agree on PI2_PAIR_UNATTESTED"
	failures=$((failures + 1))
else
	echo "ok: start --remote passes the switch devices.ts reads, which the engine fences"
fi

# start --menu prints the file the app writes for PI2_MENU, by a name each keeps for itself.
sources="$(dirname -- "$script")/../app/Sources/pi2"
if ! grep -qxF 'MENU_FILE=context-menu.txt' "$script" ||
	! grep -qF 'static let fileName = "context-menu.txt"' "$sources/LaunchPreviews.swift"; then
	echo "FAIL: test-copy's MENU_FILE and the app's ContextMenuPreview.fileName are no longer both context-menu.txt"
	failures=$((failures + 1))
else
	echo "ok: test-copy start --menu reads the file the app writes"
fi

# A running copy's show refuses a section the page does not have, listing the ones it has from the app's own enums;
# docs/development.md lists them for --show and show, and must name every one (#768, memory was missing after #731).
agent_sections=$(sed -n 's/^    case \(profile, .*\)$/\1/p' "$sources/AgentViews.swift" | tr -d ' ' | tr ',' ' ')
settings_sections=$(sed -n '/^enum SettingsSection/,/^}/p' "$sources/SettingsView.swift" | grep -E '^    case ' |
	sed -E 's/^    case //; s/[a-zA-Z]+ = "([a-z-]+)"/\1/g' | tr -d ' ' | tr ',' ' ')
docs="$(dirname -- "$script")/../docs/development.md"
agent_line=$(grep -F 'so `agent:<id>#<section>` opens it' "$docs" || true)
settings_line=$(grep -F 'so `settings:<tab>#<section>` opens it' "$docs" || true)
missing=""
for name in $agent_sections; do [[ $agent_line == *"\`$name\`"* ]] || missing+=" agent:$name"; done
for name in $settings_sections; do [[ $settings_line == *"\`$name\`"* ]] || missing+=" settings:$name"; done
if [[ -z $agent_sections || -z $settings_sections ]]; then
	echo "FAIL: could not read AgentSection or SettingsSection from the app's sources"
	failures=$((failures + 1))
elif ! grep -qF 'AgentSection.refusal(page) ?? SettingsLaunch.refusal(page)' "$sources/TestCopyControl.swift"; then
	echo "FAIL: a running copy's show no longer refuses a section the page does not have"
	failures=$((failures + 1))
elif [[ -n $missing ]]; then
	echo "FAIL: docs/development.md does not name these sections a page can be shown at:$missing"
	failures=$((failures + 1))
else
	echo "ok: every agent and Settings section is named in docs/development.md, and show refuses others"
fi

# Every context menu in the app can be listed by PI2_MENU only if it is made with .contextMenu(previewAs:), which
# LaunchPreviews.swift turns into the plain one. A plain .contextMenu elsewhere is one a test copy cannot show.
plain=$(grep -rn --include='*.swift' -E '\.contextMenu[[:space:]]*(\{|\()' "$sources" | grep -v '\.contextMenu(previewAs:' | grep -v '/LaunchPreviews\.swift:' || true)
if [[ -n $plain ]]; then
	echo "FAIL: a context menu made with plain .contextMenu, which PI2_MENU cannot list; use .contextMenu(previewAs: <label>):"
	echo "${plain//"$sources/"/  }"
	failures=$((failures + 1))
else
	echo "ok: every context menu in the app is made with .contextMenu(previewAs:)"
fi

# Every native file panel must come through the one wrapper (including panels used by WebKit).
direct=$(grep -rn --include='*.swift' -E 'NS(Open|Save)Panel[[:space:]]*\(|\.(fileImporter|fileExporter)[[:space:]]*(\{|\()' "$sources/.." |
	grep -v '/BrowserKit/FilePanels\.swift:' || true)
if [[ -n $direct ]]; then
	echo "FAIL: Open or Save panel bypasses FilePanels:"
	echo "$direct"
	failures=$((failures + 1))
else
	echo "ok: Open and Save panels go through FilePanels"
fi

out=$("$copy" status 2>&1)
if [[ $out == "No copies started from this checkout." ]]; then
	echo "ok: test-copy status with no copies"
else
	echo "FAIL: test-copy status with no copies said: $out"
	failures=$((failures + 1))
fi

# An app can be recorded before its engine writes engine.pid. Status must treat that as not ready yet, quietly.
# Use this shell as the recorded app and a stand-in home, so no real copy or data folder is needed.
mkdir -p "$root/app/build/test-copies/test-7" "$T/home"
printf '%s\n' "app_pid=$$" "app_start=$(LC_ALL=en_US.UTF-8 ps -o lstart= -p $$)" \
	"app_exe=$(LC_ALL=en_US.UTF-8 ps -o comm= -p $$)" >"$root/app/build/test-copies/test-7/state"
out=$(HOME="$T/home" "$copy" status test-7 2>&1)
status=$?
if ((status == 0)) && [[ $out == *"engine pid        none recorded"* && $out != *"engine.pid"* ]]; then
	echo "ok: test-copy status before engine.pid exists is quiet"
else
	echo "FAIL: test-copy status before engine.pid exists (exit $status): $out"
	failures=$((failures + 1))
fi

# A responder standing in for the copy's app: answers the next request in its control folder with $1. It waits
# longer than the drive script's own 30-second wait for an answer: a stand-in must not give up first on a loaded
# Mac (#860). The answer is written under a temporary name and renamed into place, as the copy's own writer does
# (TestCopyControl's answer): a plain write can be read half-way by the drive script's poll, which once made the
# can-click check fail by chance (#860).
respond() {
	local answer=$1
	(
		local deadline=$((SECONDS + 60)) answered=0 d
		while ((SECONDS < deadline && !answered)); do
			for d in "$data"/test-copy-control/request-*/; do
				[[ -f $d/request.json && ! -f $d/response.json ]] || continue
				printf '%s' "$answer" >"$d/response.json.tmp"
				mv -- "$d/response.json.tmp" "$d/response.json"
				answered=1
			done
			((answered)) || sleep 0.05
		done
	) &
	RESPONDER_PID=$!
}

# Use the recorded stand-in app above. No real permission query or capture is made: the commands below first
# refuse permission, then simulate an absent window, a window whose image isn't ready, and a replacement window;
# then a window with a sheet attached, which the copy names, and an open menu (#779).
mkdir "$T/bin"
cat >"$T/bin/osascript" <<'SH'
#!/bin/bash
[[ $1 == -l && $2 == JavaScript && $3 == - ]] || exit 1
case $4 in
	window)
		[[ $5 == "$SHOT_APP_PID" && $6 == 'Late window' ]] || exit 1
		if [[ $SHOT_ALLOWED == no ]]; then
			echo not-permitted
		elif [[ $SHOT_SHEET == yes ]]; then
			echo 101
		elif [[ ! -e $SHOT_LOG ]]; then
			echo waiting >"$SHOT_LOG"
		else
			case $(<"$SHOT_LOG") in
				waiting) echo 100 ;;
				'waiting
100') echo 101 ;;
				*) exit 1 ;;
			esac
		fi ;;
	# Front to back, as the window server lists them: the sheet over its window.
	bounds)
		[[ $5 == "$SHOT_APP_PID" ]] || exit 1
		shift 5
		[[ " $* " == *' 102 '* ]] && echo '102 1760 1250 410 304'
		for id in 101 100; do [[ " $* " == *" $id "* ]] && echo "$id 1500 1130 1120 740"; done
		exit 0 ;;
	menus)
		[[ $5 == "$SHOT_APP_PID" ]] || exit 1
		[[ $SHOT_ALLOWED == no ]] && { echo not-permitted; exit 0; }
		[[ $SHOT_MENU == open ]] && printf '%s\n' '201 1590 1043 279 208' '200 1665 1118 129 58'
		exit 0 ;;
	composite)
		echo "${@:5}" >>"$SHOT_LOG"
		printf 'composited picture' >"$5"
		echo written ;;
	*) exit 1 ;;
esac
SH
cat >"$T/bin/screencapture" <<'SH'
#!/bin/bash
# Each window by itself (-a): with its sheets, a parked window cannot be captured (#779).
[[ $1 == -x && $2 == -o && $3 == -a && $4 == -l && $(<"$SHOT_DEST") == original ]] || exit 1
case $5 in
	100) echo 100 >>"$SHOT_LOG"; printf partial >"$6"; echo 'could not create image from window' >&2; exit 1 ;;
	101|102|200|201) echo "$5" >>"$SHOT_LOG"; printf 'stand-in picture' >"$6" ;;
	*) exit 1 ;;
esac
SH
chmod +x "$T/bin/osascript" "$T/bin/screencapture"
shot_dest="$root/shot.png"
printf original >"$shot_dest"
