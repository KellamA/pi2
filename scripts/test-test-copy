	answers 1 "no, computer use cannot click in test-7: the pi² app is not running" can-click test-7
PATH="$T/bin:$PATH" CAN_CLICK_APP=yes CAN_CLICK_WINDOW=no TEST_COPY_WINDOW_WAIT=1 HOME="$T/home" \
