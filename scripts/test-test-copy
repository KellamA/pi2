# can-click tells the causes apart with stand-ins for macOS and the copy's own app (#579), and gives three answers,
# each with its own exit status: yes 0, no 1, cannot tell from here 2 (#612).
# answers <exit status> <what it should say> <arguments...>, with the environment given before it.
answers() {
	local want_status=$1 want=$2; shift 2
	local out status
	out=$("$copy" "$@" 2>&1)
	status=$?
	if ((status == want_status)) && [[ $out == *"$want"* ]]; then
		echo "ok: test-copy $* answers $status ($want)"
	else
		echo "FAIL: test-copy $*"
		echo "  wanted exit $want_status saying: $want"
		echo "  got (exit $status): $out"
		failures=$((failures + 1))
	fi
}
rm -- "$data"
mkdir -p "$data/test-copy-control"
# A stand-in app process that really runs from the copy's bundle, so the recorded checks pass. macOS kills a
# copied binary without a signature, so sign it ad hoc, as test-copy itself signs a copied bundle.
mkdir -p "$saved/Contents/MacOS"
cp /bin/sleep "$saved/Contents/MacOS/pi2"
codesign --force --sign - "$saved/Contents/MacOS/pi2" >/dev/null 2>&1
"$saved/Contents/MacOS/pi2" 120 &
STANDIN_APP=$!
printf '%s\n' "app_pid=$STANDIN_APP" "app_start=$(LC_ALL=en_US.UTF-8 ps -o lstart= -p $STANDIN_APP)" \
	"app_exe=$saved/Contents/MacOS/pi2" >"$root/app/build/test-copies/test-7/state"
cat >"$T/bin/osascript" <<'SH'
#!/bin/bash
if [[ $1 == -l && $2 == JavaScript && $3 == - && $4 == app-running && $5 == dev.pi2.app ]]; then
	[[ $CAN_CLICK_APP == yes ]] && echo running
	exit 0
fi
if [[ $1 == -l && $2 == JavaScript && $3 == - && $4 == reach ]]; then
	[[ $CAN_CLICK_WINDOW == yes ]] && echo 55
	# A window drawn a moment after the app is up, as after start or reopen: there from the third question on.
	if [[ $CAN_CLICK_WINDOW == late ]]; then
		echo asked >>"$CAN_CLICK_ASKED"
		(($(wc -l <"$CAN_CLICK_ASKED") >= 3)) && echo 55
	fi
	exit 0
fi
exit 1
SH
chmod +x "$T/bin/osascript"
