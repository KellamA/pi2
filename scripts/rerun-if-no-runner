#!/bin/bash
# The default branch's "Rerun jobs no runner took" retries hosted capacity misses (#245). App/Engine runs that
# used the mini stay manual (#993). A person can use --dry-run. Needs gh and jq; set GH_REPO outside the checkout.
set -euo pipefail

usage() { echo "usage: scripts/rerun-if-no-runner <run-id> [--dry-run]" >&2; exit 2; }
id=${1:-}
[[ $id =~ ^[1-9][0-9]*$ && $# -le 2 ]] || usage
dry=false
case ${2:-} in "") ;; --dry-run) dry=true ;; *) usage ;; esac

MAX_ATTEMPTS=4 # Three retries for the existing hosted-only capacity case (#245).
HOSTED='The job was not acquired by Runner of type hosted even after multiple attempts'
api="repos/{owner}/{repo}"
run_path="$api/actions/runs/$id"

run=$(gh api "$run_path")
attempt=$(jq -re '.run_attempt | select(type == "number" and . >= 1 and floor == .)' <<<"$run")
if ! jq -e '.status == "completed" and (.conclusion == "failure" or .conclusion == "cancelled")' <<<"$run" >/dev/null ||
	[[ ${EXPECTED_ATTEMPT:-$attempt} != "$attempt" ]]; then
	echo 'Not the completed failed attempt that triggered this controller: nothing to do.'
	exit 0
fi

event=$(jq -re '.event | select(type == "string" and length > 0)' <<<"$run")
list_jobs() {
	gh api --paginate "$1" | jq -se '.[0].total_count as $count | [.[].jobs[]] | select(length > 0 and length == $count)'
}
jobs=$(list_jobs "$run_path/attempts/$attempt/jobs?per_page=100")

if [[ $event == pull_request ]]; then
	# Keep the entire mini App/Engine run out of the hosted capacity retry, even if a partial manual retry only
	# lists hosted jobs in its latest attempt. Missing runner data for a non-skipped App/Engine is not proof it was hosted.
	history='[]'
	if ((attempt > 1)); then
		history=$(list_jobs "$run_path/jobs?filter=all&per_page=100")
	fi
	manual=$(printf '%s\n%s\n' "$jobs" "$history" | jq -sr 'add |
		any(.[]; (.name == "App (build)" or .name == "Engine (type-check and tests)") and
			(((.runner_name // "") | ascii_downcase) == "pi2-mini" or
			any((.labels // [])[]; ascii_downcase == "pi2-mini") or
			(.conclusion != "skipped" and ((.labels // []) | length == 0))))')
	if [[ $manual == true ]]; then
		# A run-ID POST can select a newer attempt. The job-ID POST also reruns dependents and has no documented
		# precondition that rejects a request if another attempt became current. Neither is safe for mini fallback.
		echo 'This PR run has mini or unknown App/Engine routing. Inspect the latest attempt and retry manually only for runner failures.'
		exit 0
	fi
fi

# The existing #245 hosted retry policy, not the mini fallback. Refuse ambiguous or incomplete observations.
((attempt < MAX_ATTEMPTS)) || { echo 'Hosted retry budget exhausted.'; exit 0; }
if ! jq -e 'all(.[]; .status == "completed" and (.id | type == "number"))' <<<"$jobs" >/dev/null; then
	echo 'Not all jobs are terminal: leaving the run alone.'
	exit 0
fi
failed=$(jq -c '[.[] | select(.conclusion != "success" and .conclusion != "skipped" and .conclusion != "neutral")]' <<<"$jobs")
count=$(jq 'length' <<<"$failed")
((count > 0)) || exit 0
while IFS= read -r job; do
	if ! jq -e '.conclusion == "cancelled" and (.runner_id == 0 or .runner_id == null) and
		(.runner_name == "" or .runner_name == null) and .steps == []' <<<"$job" >/dev/null ||
		! gh api --paginate "$api/check-runs/$(jq -r .id <<<"$job")/annotations?per_page=100" |
			jq -se --arg msg "$HOSTED" 'add | any(.[]; (.message // "") | contains($msg))' >/dev/null; then
		echo 'Not every failed job ended for want of a hosted runner: leaving the failed checks alone.'
		exit 0
	fi
done < <(jq -c '.[]' <<<"$failed")

# Running an old run again could cancel a newer one. The last read narrows the race on #245's existing run-ID
# endpoint, but isn't a compare-and-set; the mini path never reaches this endpoint.
workflow=$(jq -re '.workflow_id | select(type == "number" and . >= 1 and floor == .)' <<<"$run")
newest=$(gh api -X GET "$api/actions/workflows/$workflow/runs" -f branch="$(jq -r .head_branch <<<"$run")" \
	-f event="$event" -f per_page=1 --jq '.workflow_runs[0].id // empty')
if [[ $newest != "$id" ]]; then
	echo 'Not the newest run on this branch: leaving it alone.'
	exit 0
fi
if ! gh api "$run_path" | jq -e --argjson attempt "$attempt" '.status == "completed" and .run_attempt == $attempt' >/dev/null; then
	echo 'The attempt changed during review: leaving the run alone.'
	exit 0
fi
if $dry; then
	echo "Would rerun $count checks that no hosted runner took (--dry-run)."
	exit 0
fi
gh api -X POST "$run_path/rerun-failed-jobs" >/dev/null
echo "Requested attempt $((attempt + 1)) for $count checks that no hosted runner took. The checks still have to pass."
