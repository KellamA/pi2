#!/bin/bash
# Checks scripts/auto-merge against a stand-in for gh, put first on the PATH, which answers `pr view` and `pr checks`
# from canned JSON in a temporary folder, writes down each command it is given, and fails `pr merge --auto` for a pull
# request in clean status as gh does. Runs in a temporary folder and touches no pull request.
#
#   scripts/test-auto-merge

set -uo pipefail

merge="$(cd -P -- "$(dirname -- "$0")" && pwd -P)/auto-merge"
root="$(cd -P -- "$(dirname -- "$0")/.." && pwd -P)"
command -v jq >/dev/null || { echo "test-auto-merge: needs jq" >&2; exit 1; }

T=$(mktemp -d)
trap 'rm -rf "$T"' EXIT
T=$(cd -P -- "$T" && pwd -P)

# The stand-in. $CASE holds view.json (what `pr view` answers), checks.json (every check of the newest commit, each with
# `required` false if it is not a required one), and the log of every call, one line each with its arguments quoted as
# the shell would. `pr checks` answers as gh 2.x does (#637): with `--required`, only the required ones; with `--json`,
# exit status 0 whatever the checks' states; and none to list fails, saying so. $CASE/checks-error, if there, is an
# error of gh's own instead, such as GitHub not answering. `pr merge --merge` without `--auto` merges the pull request
# in view.json, unless $CASE/stay-open says GitHub has not done it yet; `--auto` is refused for a clean status, which
# is what gh does (#553). A run's attempt is $CASE/attempt.txt, or 1.
#
# The owner's paths (#668). Commits are folders: $CASE/commits/main, and $CASE/commits/<sha> for the pull request's
# head (headRefOid, $H1 unless a case moves it); a ref with no folder is one this repository cannot read, which GitHub
# answers with a 404. In a commit's folder, CODEOWNERS is `.github/CODEOWNERS` (none: not there), `mode` its git mode
# if not 100644, `size` the size GitHub gives if not its own, and `no-github` says the commit has no .github at all.
# They are served as git's trees (`git/trees/<ref>`, then the .github tree) and blob, each through the script's own
# --jq; $CASE/tree-error is an error of gh's for every tree. The files the pull request changes are $CASE/files.json,
# as GitHub's REST API lists them, served in pages of the size asked for: every page with --paginate, the first
# without it; $CASE/files-error is an error instead. `pr view` counts them for changedFiles unless view.json has its
# own; after as many views as $CASE/moves holds it gives $CASE/moved-to as the head. `pr merge --match-head-commit`
# is refused unless its sha is the head GitHub has: $CASE/head-now if there, or the one `pr view` gives.
# `--disable-auto` is refused when auto-merge is off.
mkdir -p "$T/bin"
cat >"$T/bin/gh" <<'EOF'
#!/bin/bash
{ printf 'gh'; printf ' %q' "$@"; echo; } >>"$CASE/log"
args=" $* "
filter=.
prev=
match=
for a in "$@"; do
	[[ $prev == --jq ]] && filter=$a
	[[ $prev == --match-head-commit ]] && match=$a
	prev=$a
done
not_found() { echo '{"message":"Not Found","status":"404"}'; echo 'gh: Not Found (HTTP 404)' >&2; exit 1; }
# The view as GitHub gives it now: the head moved once $CASE/moves views have been given.
now() {
	local moved=.
	if [[ -f $CASE/moves ]] && (($(cat "$CASE/views" 2>/dev/null || echo 0) >= $(cat "$CASE/moves"))); then
		moved=".headRefOid = \"$(cat "$CASE/moved-to")\""
	fi
	jq --slurpfile f "$CASE/files.json" "{changedFiles: (\$f[0] | length)} + . | $moved" "$CASE/view.json"
}
case "$1 $2" in
"pr view")
	now
	echo $(($(cat "$CASE/views" 2>/dev/null || echo 0) + 1)) >"$CASE/views"
	;;
"api repos/{owner}/{repo}/git/trees/"*)
	if [[ -f $CASE/tree-error ]]; then cat "$CASE/tree-error" >&2; exit 1; fi
	ref=${2#repos/\{owner\}/\{repo\}/git/trees/}
	if [[ $ref == gh-* ]]; then
		c=$CASE/commits/${ref#gh-}
		if [[ -f $c/CODEOWNERS ]]; then
			jq -n --arg ref "${ref#gh-}" --arg mode "$(cat "$c/mode" 2>/dev/null || echo 100644)" \
				--argjson size "$(cat "$c/size" 2>/dev/null || wc -c <"$c/CODEOWNERS")" \
				'{tree: [{path: "workflows", type: "tree", mode: "040000", sha: "w"},
					{path: "CODEOWNERS", mode: $mode, type: (if $mode == "040000" then "tree" else "blob" end),
						size: $size, sha: "blob-\($ref)"}]}'
		else
			echo '{"tree": [{"path": "workflows", "type": "tree", "mode": "040000", "sha": "w"}]}'
		fi | jq "$filter"
	else
		[[ -d $CASE/commits/$ref ]] || not_found
		if [[ -f $CASE/commits/$ref/no-github ]]; then
			echo '{"tree": [{"path": "README.md", "type": "blob", "mode": "100644", "sha": "r"}]}'
		else
			jq -n --arg ref "$ref" '{tree: [{path: ".github", type: "tree", mode: "040000", sha: "gh-\($ref)"}]}'
		fi | jq "$filter"
	fi
	;;
"api repos/{owner}/{repo}/git/blobs/"*)
	ref=${2#repos/\{owner\}/\{repo\}/git/blobs/blob-}
	[[ -f $CASE/commits/$ref/CODEOWNERS ]] || not_found
	cat "$CASE/commits/$ref/CODEOWNERS"
	;;
"api repos/{owner}/{repo}/pulls/"*)
	if [[ -f $CASE/files-error ]]; then cat "$CASE/files-error" >&2; exit 1; fi
	size=100
	[[ $2 =~ per_page=([0-9]+) ]] && size=${BASH_REMATCH[1]}
	pages=$(jq --argjson size "$size" '(length + $size - 1) / $size | floor' "$CASE/files.json")
	[[ $args == *" --paginate "* ]] || pages=$((pages < 1 ? pages : 1))
	for ((p = 0; p < pages; p++)); do
		jq -c --argjson size "$size" --argjson p "$p" '.[($p * $size):(($p + 1) * $size)]' "$CASE/files.json" | jq -c "$filter"
	done
	;;
"pr checks")
	if [[ -f $CASE/checks-error ]]; then cat "$CASE/checks-error" >&2; exit 1; fi
	listed=$(jq --arg required "$([[ $args == *" --required "* ]] && echo yes)" \
		'map(select($required == "" or .required != false) | del(.required))' "$CASE/checks.json")
	if [[ $(jq length <<<"$listed") == 0 ]]; then
		if [[ $args == *" --required "* ]]; then
			echo "no required checks reported on the 'topic' branch" >&2
		else
			echo "no checks reported on the 'topic' branch" >&2
		fi
		exit 1
	fi
	echo "$listed"
	;;
"pr merge")
	if [[ $args == *" --disable-auto "* ]]; then
		if [[ $(jq -r .autoMergeRequest "$CASE/view.json") == null ]]; then
			echo "Pull request is not in auto-merge state" >&2
			exit 1
		fi
		jq '.autoMergeRequest = null' "$CASE/view.json" >"$CASE/view.new" && mv "$CASE/view.new" "$CASE/view.json"
		exit 0
	fi
	if [[ -n $match ]]; then
		head=$(cat "$CASE/head-now" 2>/dev/null || now | jq -r .headRefOid)
		if [[ $match != "$head" ]]; then
			echo "Head branch was modified. Review and try the merge again." >&2
			exit 1
		fi
	fi
	if [[ $args == *" --auto "* && $(jq -r .mergeStateStatus "$CASE/view.json") == CLEAN ]]; then
		echo "Pull request is in clean status" >&2
		exit 1
	fi
	if [[ $args != *" --auto "* && $args == *" --merge "* && ! -f $CASE/stay-open ]]; then
		jq '.state = "MERGED"' "$CASE/view.json" >"$CASE/view.new" && mv "$CASE/view.new" "$CASE/view.json"
	fi
	;;
"api repos/{owner}/{repo}/check-runs/"*)
	cat "$CASE/annotations.txt" 2>/dev/null
	;;
"api repos/{owner}/{repo}/actions/runs/"*)
	cat "$CASE/attempt.txt" 2>/dev/null || echo 1
	;;
esac
exit 0
EOF
chmod +x "$T/bin/gh"
export PATH="$T/bin:$PATH" CASE
pass=0 fail=0

report() {
	if [[ $1 == "$2" ]]; then
		pass=$((pass + 1))
	else
		fail=$((fail + 1))
		echo "FAIL $3: expected $1, got $2"
	fi
}

# check <description> <condition...>: passes when the condition holds.
check() {
	local what=$1; shift
	if "$@"; then report yes yes "$what"; else report yes no "$what"; fi
}

not() { ! "$@"; }
logged() { grep -qF -- "$1" "$CASE/log"; }
not_logged() { ! grep -qF -- "$1" "$CASE/log"; }
said() { grep -qF -- "$1" <<<"$out"; }
# Whether the first call containing $1 comes before the first containing $2.
before() {
	local a b
	a=$(grep -nF -- "$1" "$CASE/log" | head -1 | cut -d: -f1)
	b=$(grep -nF -- "$2" "$CASE/log" | head -1 | cut -d: -f1)
	[[ -n $a && -n $b ]] && ((a < b))
}
# pr <name> <state> <mergeStateStatus> <autoMergeRequest: null or a request>
pr() {
	CASE=$T/$1
	mkdir -p "$CASE"
	: >"$CASE/log"
	jq -n --arg state "$2" --arg status "$3" --argjson auto "$4" --arg head "$H1" \
		'{state: $state, mergeStateStatus: $status, autoMergeRequest: $auto, url: "https://example.invalid/pull/5",
			headRefOid: $head}' \
		>"$CASE/view.json"
	# An ordinary change, with this checkout's CODEOWNERS on main and at the head alike.
	files docs/notes.md
	owners main "$root/.github/CODEOWNERS"
	owners "$H1" "$root/.github/CODEOWNERS"
	echo '[{"name": "Engine", "bucket": "pass", "completedAt": "2026-01-01T10:00:00Z", "link": "https://github.com/owner/repo/actions/runs/9/job/12"}]' \
		>"$CASE/checks.json"
}
checks() { echo "$1" >"$CASE/checks.json"; }
# The head commits a case uses, and the one a head moves to.
H1=1111111111111111111111111111111111111111
H2=2222222222222222222222222222222222222222
# owners <ref> <file, or - for its text on standard input, or none>: `.github/CODEOWNERS` at that commit.
owners() {
	mkdir -p "$CASE/commits/$1"
	case $2 in
	none) rm -f "$CASE/commits/$1/CODEOWNERS" ;;
	-) cat >"$CASE/commits/$1/CODEOWNERS" ;;
	*) cp "$2" "$CASE/commits/$1/CODEOWNERS" ;;
	esac
}
# files <name>...: the files the pull request changes; <new name>=<old name> for a moved one.
files() {
	local f
	for f in "$@"; do
		if [[ $f == *=* ]]; then
			jq -nc --arg to "${f%%=*}" --arg from "${f#*=}" '{filename: $to, status: "renamed", previous_filename: $from}'
		else
			jq -nc --arg name "$f" '{filename: $name, status: "modified"}'
		fi
	done | jq -s . >"$CASE/files.json"
}
# check_run <name> <bucket> <state> [required: true or false]: one check as gh lists it, finished now unless pending,
# in run 9; with checks_of, the list of them.
check_run() {
	jq -nc --arg name "$1" --arg bucket "$2" --arg state "$3" --argjson required "${4:-true}" \
		--arg done "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
		'{name: $name, bucket: $bucket, state: $state, required: $required,
			completedAt: (if $bucket == "pending" then "0001-01-01T00:00:00Z" else $done end),
			link: "https://github.com/owner/repo/actions/runs/9/job/\($name | length)"}'
}
checks_of() { printf '%s\n' "$@" | jq -s .; }
# The five required checks (CONTRIBUTING.md, development.md's CI), all passed, and the one that is not required.
green=(
	"$(check_run 'Engine (type-check and tests)' pass SUCCESS)"
	"$(check_run 'App (build)' pass SUCCESS)"
	"$(check_run 'Engine (Linux tests)' pass SUCCESS)"
	"$(check_run 'Transcript page (tests)' pass SUCCESS)"
	"$(check_run 'Scripts (tests)' pass SUCCESS)"
)
changes_passed=$(check_run 'Which jobs the change needs' pass SUCCESS false)
# green_but <name> <bucket> <state> [<name> <bucket> <state>...]: the five, with each one named in that state.
green_but() {
	local c name i
	for c in "${green[@]}"; do
		name=$(jq -r .name <<<"$c")
		for ((i = 1; i <= $#; i += 3)); do
			if [[ ${!i} == "$name" ]]; then
				local b=$((i + 1)) s=$((i + 2))
				c=$(check_run "$name" "${!b}" "${!s}")
			fi
		done
		echo "$c"
	done
}
# run <case name>: runs scripts/auto-merge on pull request 5 with that case's answers, into $out and $status.
run() { CASE=$T/$1; out=$("$merge" 5 2>&1); status=$?; }

automerge_on='{"enabledBy": {"login": "someone"}}'

# Every required check passed already: gh refuses `--auto` with "Pull request is in clean status", so it is merged
# now, with the same kind of merge (#553).
pr clean OPEN CLEAN null
run clean
report 0 "$status" "clean status: exit status"
check "clean status: merged with a merge commit" logged "gh pr merge 5 --merge"
check "clean status: auto-merge not turned on" not_logged "--auto"
check "clean status: merged after looking at it" before "gh pr view 5" "gh pr merge 5 --merge"
check "clean status: says why" said "nothing is left to wait for"
check "clean status: says it merged" said "Merged."

# Auto-merge is on and the checks have just passed: nothing is left to wait for either, so it is merged at once.
pr clean-auto OPEN CLEAN "$automerge_on"
run clean-auto
report 0 "$status" "clean status with auto-merge on: exit status"
check "clean status with auto-merge on: merged" logged "gh pr merge 5 --merge"
check "clean status with auto-merge on: not turned off and on" not_logged "--disable-auto"

# Merged by the command, and GitHub has not reported it merged yet: it says so, and again in a minute.
pr clean-open OPEN CLEAN null
touch "$T/clean-open/stay-open"
run clean-open
report 3 "$status" "clean status GitHub has not merged: exit status"
check "clean status GitHub has not merged: says so" said "has not merged it yet"

# Already merged: nothing is asked of GitHub but the view.
pr merged MERGED CLEAN null
run merged
report 0 "$status" "merged: exit status"
check "merged: says so" said "Merged."
check "merged: no merge asked for" not_logged "gh pr merge"

# Checks still running, auto-merge off: it is turned on, and the wait is named.
pr pending OPEN BLOCKED null
checks '[{"name": "Engine", "bucket": "pending", "completedAt": null, "link": "https://github.com/owner/repo/actions/runs/9/job/12"}]'
run pending
report 3 "$status" "checks pending: exit status"
check "checks pending: auto-merge turned on with a merge commit" logged "gh pr merge 5 --auto --merge"
check "checks pending: the check is named" said "waiting for: Engine"

# No required check has reported yet.
pr unreported OPEN BLOCKED "$automerge_on"
checks '[]'
run unreported
report 3 "$status" "no check reported: exit status"
check "no check reported: says so" said "no required check has reported yet"

# Not one required check has reported, which gh says as an error: waited for.
pr none-required OPEN BLOCKED "$automerge_on"
checks "$(checks_of "$changes_passed")"
run none-required
report 3 "$status" "only a check that is not required reported: exit status"
check "only a check that is not required reported: says none has" said "no required check has reported yet"

# Any other error of gh's says nothing about the checks: it is not taken for checks not reported yet (#637).
pr gh-error OPEN BLOCKED "$automerge_on"
echo "GraphQL: Something went wrong while executing your query. (node.statusCheckRollup)" >"$CASE/checks-error"
run gh-error
report 1 "$status" "gh fails to read the checks: exit status"
check "gh fails to read the checks: gh's error shown" said "Something went wrong while executing your query"
check "gh fails to read the checks: not taken for none reported" not said "no required check has reported yet"
check "gh fails to read the checks: what to do" said "Run this again in a minute"

# The five cases of #637, with the five required checks and the one that is not required, as GitHub lists them.

# All green, and GitHub has not caught up yet: it merges shortly.
pr all-green OPEN BLOCKED "$automerge_on"
checks "$(checks_of "$changes_passed" "${green[@]}")"
run all-green
report 3 "$status" "all green: exit status"
check "all green: says they passed" said "the required checks have passed"
check "all green: nothing named as failed" not said "failed"

# One pending: waited for, by name.
pr one-pending OPEN BLOCKED "$automerge_on"
checks "$(checks_of "$changes_passed" "$(green_but 'App (build)' pending IN_PROGRESS)")"
run one-pending
report 3 "$status" "one pending: exit status"
check "one pending: waited for, by name" said "waiting for: App (build)."

# One failed: named at once with its link, what to do, and no merge.
pr one-failed OPEN BLOCKED "$automerge_on"
checks "$(checks_of "$changes_passed" "$(green_but 'Scripts (tests)' fail FAILURE)")"
run one-failed
report 1 "$status" "one failed: exit status"
check "one failed: named, as failed" said "- Scripts (tests): failed."
check "one failed: its link" said "https://github.com/owner/repo/actions/runs/9/job/15"
check "one failed: read the log" said "gh run view 9 --log-failed"
check "one failed: or run it again" said "gh run rerun 9 --failed"
check "one failed: not merged" not_logged "gh pr merge"

# One failed and one pending: the failure is named now, not after the other one finishes.
pr failed-pending OPEN BLOCKED "$automerge_on"
checks "$(checks_of "$changes_passed" "$(green_but 'Transcript page (tests)' fail FAILURE 'App (build)' pending QUEUED)")"
run failed-pending
report 1 "$status" "one failed and one pending: exit status"
check "one failed and one pending: the failure named" said "- Transcript page (tests): failed."
check "one failed and one pending: the other still running" said "Still running: App (build)."
check "one failed and one pending: not waiting" not said "waiting for"

# A check that is not required failed: it holds nothing up, and is not named.
pr not-required-failed OPEN BLOCKED "$automerge_on"
checks "$(checks_of "$(check_run 'Which jobs the change needs' fail FAILURE false)" "${green[@]}")"
run not-required-failed
report 3 "$status" "a check that is not required failed: exit status"
check "a check that is not required failed: not named" not said "Which jobs the change needs"
check "a check that is not required failed: the required ones passed" said "the required checks have passed"

# Timed out, and a status (not a check run) in error: failures too, each with its link.
pr timed-out OPEN BLOCKED "$automerge_on"
checks "$(checks_of "$(green_but 'Engine (Linux tests)' fail TIMED_OUT)")"
run timed-out
report 1 "$status" "a check that timed out: exit status"
check "a check that timed out: named as timed out" said "- Engine (Linux tests): timed out."
pr status-error OPEN BLOCKED "$automerge_on"
checks '[{"name": "deploy/preview", "bucket": "fail", "state": "ERROR", "completedAt": "0001-01-01T00:00:00Z", "link": "https://ci.example.invalid/build/77"}]'
run status-error
report 1 "$status" "a status in error: exit status"
check "a status in error: named, with its link" said "- deploy/preview: failed (ERROR). https://ci.example.invalid/build/77"
check "a status in error: no run to name" not said "gh run view  "

# Cancelled for another reason than no runner: named, to run again.
pr cancelled-other OPEN BLOCKED "$automerge_on"
checks "$(checks_of "$(green_but 'App (build)' cancel CANCELLED)")"
echo "The operation was canceled." >"$T/cancelled-other/annotations.txt"
run cancelled-other
report 1 "$status" "a check cancelled by someone: exit status"
check "a check cancelled by someone: named, as cancelled" said "- App (build): cancelled."
check "a check cancelled by someone: how to run it again" said "gh run rerun 9 --failed"

# A check cancelled because no runner took it: CI runs it again, which is not a failure of the change.
pr cancelled OPEN BLOCKED "$automerge_on"
checks '[{"name": "App", "bucket": "cancel", "state": "CANCELLED", "completedAt": "2026-01-01T10:00:00Z", "link": "https://github.com/owner/repo/actions/runs/9/job/12"}]'
echo "The job was not acquired by Runner of type hosted even after multiple attempts" >"$T/cancelled/annotations.txt"
run cancelled
report 3 "$status" "a cancelled check: exit status"
check "a cancelled check: said to run again by itself" said "CI runs it again by itself"
check "a cancelled check: how to run it again" said "gh run rerun 9 --failed"

# No runner took it at the run's fourth attempt, which CI does not run again by itself: it is left to you.
pr cancelled-last OPEN BLOCKED "$automerge_on"
checks "$(checks_of "$(green_but 'App (build)' cancel CANCELLED)")"
echo "The job was not acquired by Runner of type hosted even after multiple attempts" >"$T/cancelled-last/annotations.txt"
echo 4 >"$T/cancelled-last/attempt.txt"
run cancelled-last
report 1 "$status" "no runner at the last attempt: exit status"
check "no runner at the last attempt: not said to run again by itself" not said "CI runs it again by itself"
check "no runner at the last attempt: how to run it again" said "gh run rerun 9 --failed"

# A conflict with main: what to do, and no merge.
pr dirty OPEN DIRTY "$automerge_on"
run dirty
report 1 "$status" "a conflict: exit status"
check "a conflict: says what to do" said "Merge origin/main into the branch"
check "a conflict: not merged" not_logged "gh pr merge"

# Closed without merging.
pr closed CLOSED CLEAN null
run closed
report 1 "$status" "closed: exit status"
check "closed: no merge asked for" not_logged "gh pr merge"

# The owner's paths (#668). A pull request that touches one is refused before anything else: named, never merged, and
# auto-merge turned off. One that is not goes on as before: here, waiting for a check still running.
still_running() { checks "$(checks_of "$(check_run 'App (build)' pending IN_PROGRESS)")"; }
refused() { not_logged "--merge"; }
cr() { printf '/relay/ @owner\n'; }

# An ordinary change: both copies of CODEOWNERS are read at exactly main and the head checked, and every merge call is
# bound to that head.
pr ordinary OPEN BLOCKED null
still_running
run ordinary
report 3 "$status" "an ordinary change: exit status"
check "an ordinary change: main's tree read" logged "git/trees/main"
check "an ordinary change: the head's tree read, at its sha" logged "git/trees/$H1"
check "an ordinary change: main's CODEOWNERS read from its blob" logged "git/blobs/blob-main"
check "an ordinary change: the head's CODEOWNERS read from its blob" logged "git/blobs/blob-$H1"
check "an ordinary change: its files listed, every page" logged "--paginate"
check "an ordinary change: not said to wait for the owner" not said "owner's review"
check "an ordinary change: auto-merge turned on at the head checked" \
	logged "gh pr merge 5 --auto --merge --match-head-commit $H1"

# A file under relay/: refused, by name and pattern, nothing merged or turned on, and auto-merge turned off.
pr relay OPEN BLOCKED null
files docs/notes.md relay/src/index.ts
run relay
report 4 "$status" "a file under relay/: exit status"
check "a file under relay/: named, with its pattern" said "- relay/src/index.ts (/relay/, in main's CODEOWNERS)"
check "a file under relay/: the ordinary file not named" not said "- docs/notes.md"
check "a file under relay/: waits for the owner" said "the owner reviews it on GitHub and merges it"
check "a file under relay/: not merged or turned on" refused
check "a file under relay/: auto-merge turned off all the same" logged "gh pr merge 5 --disable-auto"

# Every required check passed already: still not merged.
pr relay-clean OPEN CLEAN null
files relay/wrangler.jsonc
run relay-clean
report 4 "$status" "a file under relay/, clean status: exit status"
check "a file under relay/, clean status: not merged" refused

# Auto-merge was on already: turned off, so that GitHub does not merge it either.
pr relay-auto OPEN BLOCKED "$automerge_on"
files app/Sources/RemoteKit/Noise.swift
run relay-auto
report 4 "$status" "auto-merge on: exit status"
check "auto-merge on: turned off" logged "gh pr merge 5 --disable-auto"
check "auto-merge on: says so" said "Auto-merge is off"
check "auto-merge on: not turned on again" refused

# Each path the issue names, the guard's own files and the owner's instructions are the owner's in this checkout's
# CODEOWNERS; a file beside one of them is not.
for f in relay/src/index.ts app/Sources/RemoteKit/Relay/Client.swift app/Sources/pi2-remote/main.swift \
	engine/src/devices.ts engine/src/remote.ts engine/src/appattest.ts engine/src/answers.ts \
	.github/workflows/relay.yml .github/workflows/iphone.yml .github/workflows/ci.yml \
	.github/CODEOWNERS scripts/auto-merge scripts/test-auto-merge scripts/ci-changes scripts/test-ci-changes docs/relay.md; do
	pr owned OPEN BLOCKED null
	files "$f"
	run owned
	report 4 "$status" "$f is the owner's: exit status"
	check "$f is the owner's: named" said "- $f ("
done
for f in engine/src/answer.ts engine/src/answers.tsx engine/src/state.ts app/Sources/pi2/DevicesSettings.swift \
	scripts/issue .github/PULL_REQUEST_TEMPLATE.md docs/iphone.md x/relay/y.ts; do
	pr not-owned OPEN BLOCKED null
	files "$f"
	still_running
	run not-owned
	report 3 "$status" "$f is not the owner's: exit status"
done

# A path that differs from an owned one only in letter case, or a name that is not plain ASCII: refused.
pr case OPEN BLOCKED null
files Relay/src/index.ts
run case
report 4 "$status" "letter case: exit status"
check "letter case: named" said "- Relay/src/index.ts: differs only in letter case from /relay/"
pr unicode OPEN BLOCKED null
files "$(printf 'rel\xc3\xa4y/x.ts')"
run unicode
report 4 "$status" "a name not plain ASCII: exit status"
check "a name not plain ASCII: named" said "not a plain ASCII name"

# A change to CODEOWNERS that takes relay/ out, with a change under relay/: main's copy still gives it the owner, and
# CODEOWNERS is itself the owner's.
pr unowning OPEN BLOCKED null
files .github/CODEOWNERS relay/src/index.ts
grep -v '^/relay/' "$root/.github/CODEOWNERS" | owners "$H1" -
run unowning
report 4 "$status" "CODEOWNERS changed to take relay/ out: exit status"
check "CODEOWNERS changed to take relay/ out: relay/ named, from main's copy" \
	said "- relay/src/index.ts (/relay/, in main's CODEOWNERS)"
check "CODEOWNERS changed to take relay/ out: CODEOWNERS named" said "- .github/CODEOWNERS (/.github/CODEOWNERS,"

# The head's copy, alone: a path it adds is refused, naming it; a path neither copy has is not.
pr head-adds OPEN BLOCKED null
files newpath/x.ts
{ cat "$root/.github/CODEOWNERS"; echo '/newpath/ @owner'; } | owners "$H1" -
run head-adds
report 4 "$status" "a path only the head's copy owns: exit status"
check "a path only the head's copy owns: named, from its copy" \
	said "- newpath/x.ts (/newpath/, in this pull request's CODEOWNERS)"
pr head-adds-other OPEN BLOCKED null
files otherpath/x.ts
{ cat "$root/.github/CODEOWNERS"; echo '/newpath/ @owner'; } | owners "$H1" -
still_running
run head-adds-other
report 3 "$status" "a path neither copy owns: exit status"

# A change to scripts/auto-merge alone: the script that refuses is the owner's.
pr script OPEN BLOCKED null
files scripts/auto-merge
run script
report 4 "$status" "scripts/auto-merge changed: exit status"
check "scripts/auto-merge changed: named" said "- scripts/auto-merge (/scripts/auto-merge, in main's CODEOWNERS)"

# Main's copy must be there, a regular file GitHub loads, with a rule in it; anything else refuses everything.
pr main-missing OPEN BLOCKED null
owners main none
run main-missing
report 4 "$status" "no CODEOWNERS on main: exit status"
check "no CODEOWNERS on main: says so" said "main has no .github/CODEOWNERS"
check "no CODEOWNERS on main: not merged" refused
pr main-no-github OPEN BLOCKED null
touch "$CASE/commits/main/no-github"
run main-no-github
report 4 "$status" "no .github on main: exit status"
pr main-empty OPEN BLOCKED null
: | owners main -
run main-empty
report 4 "$status" "an empty CODEOWNERS on main: exit status"
check "an empty CODEOWNERS on main: says so" said "main's CODEOWNERS has no rule in it"
pr main-comments OPEN BLOCKED null
printf '# nothing but this\n\n' | owners main -
run main-comments
report 4 "$status" "a CODEOWNERS of comments on main: exit status"
pr main-oversize OPEN BLOCKED null
echo 3145729 >"$CASE/commits/main/size"
run main-oversize
report 4 "$status" "a CODEOWNERS over 3 MB on main: exit status"
check "a CODEOWNERS over 3 MB on main: says why" said "does not load one over 3 MB"
pr main-link OPEN BLOCKED null
echo 120000 >"$CASE/commits/main/mode"
run main-link
report 4 "$status" "a CODEOWNERS on main that is a symbolic link: exit status"
check "a CODEOWNERS on main that is a symbolic link: says why" said "not a regular file"

# The head: plainly absent at a commit this repository has adds nothing; a commit it cannot read refuses.
pr head-none OPEN BLOCKED null
owners "$H1" none
still_running
run head-none
report 3 "$status" "no CODEOWNERS at the head: exit status"
pr fork OPEN BLOCKED null
rm -r "${CASE:?}/commits/$H1"
run fork
report 4 "$status" "a head this repository cannot read: exit status"
check "a head this repository cannot read: says so" said "cannot be read in this repository"
check "a head this repository cannot read: not merged" refused
pr tree-error OPEN BLOCKED "$automerge_on"
echo "gh: Server Error (HTTP 502)" >"$CASE/tree-error"
run tree-error
report 1 "$status" "CODEOWNERS not read: exit status"
check "CODEOWNERS not read: gh's error shown" said "HTTP 502"
check "CODEOWNERS not read: auto-merge turned off" logged "gh pr merge 5 --disable-auto"
check "CODEOWNERS not read: not merged or turned on" refused

# A line this script cannot read exactly as GitHub does refuses, naming the line, in either copy: one with no owner
# (which would take a file out), an escape, a range, a negation, `?`, a word that is not an owner.
for line in '/relay/src/' '/a\ b/ @owner' '/app/[ab]/ @owner' '!/relay/ @owner' '/re?ay/ @owner' '/x/ owner' \
	'/a/***/b @owner'; do
	pr unsupported OPEN BLOCKED null
	files docs/notes.md
	{ cat "$root/.github/CODEOWNERS"; echo "$line"; } | owners main -
	run unsupported
	report 4 "$status" "main's line '$line': exit status"
	check "main's line '$line': named" said "main's CODEOWNERS, line $(($(wc -l <"$root/.github/CODEOWNERS") + 1)): $line"
done
pr unsupported-head OPEN BLOCKED null
{ cat "$root/.github/CODEOWNERS"; echo '/relay/src/'; } | owners "$H1" -
run unsupported-head
report 4 "$status" "an ownerless line in the head's copy: exit status"
check "an ownerless line in the head's copy: named" said "this pull request's CODEOWNERS, line"

# Patterns: `*` within one name, `**` across folders, a folder's files, a comment after the owners.
pr patterns OPEN BLOCKED null
printf '%s\n' '# owners' '/apps/ @o' '**/logs @o' '*.js @o # a comment' '/docs/*.md @o' | owners main -
owners "$H1" "$CASE/commits/main/CODEOWNERS"
files apps/x.txt a/b/logs/z.txt src/w.js docs/a.md other/v.txt
run patterns
report 4 "$status" "patterns: exit status"
check "patterns: a folder's file" said "- apps/x.txt (/apps/,"
check "patterns: ** across folders" said "- a/b/logs/z.txt (**/logs,"
check "patterns: * in any folder" said "- src/w.js (*.js,"
check "patterns: * within a name" said "- docs/a.md (/docs/*.md,"
check "patterns: a file no line matches" not said "other/v.txt"

# Moves: both names count, out of an owned path and into one; and a deletion.
pr moved-out OPEN BLOCKED null
files 'docs/old-relay.ts=relay/src/old.ts'
run moved-out
report 4 "$status" "a file moved out of relay/: exit status"
check "a file moved out of relay/: its old name named" said "- relay/src/old.ts ("
pr moved-in OPEN BLOCKED null
files 'relay/src/new.ts=docs/new.ts'
run moved-in
report 4 "$status" "a file moved into relay/: exit status"
check "a file moved into relay/: its new name named" said "- relay/src/new.ts ("
pr deleted OPEN BLOCKED null
jq -n '[{filename: "relay/src/gone.ts", status: "removed"}]' >"$CASE/files.json"
run deleted
report 4 "$status" "a file deleted under relay/: exit status"

# The list in pages: an owned file on the second page is found.
pr pages OPEN BLOCKED null
for ((i = 0; i < 100; i++)); do echo "docs/page-$i.md"; done >"$T/hundred"
# shellcheck disable=SC2046 # one name a line, none with spaces
files $(cat "$T/hundred") relay/src/late.ts
run pages
report 4 "$status" "an owned file on the second page: exit status"
check "an owned file on the second page: named" said "- relay/src/late.ts ("

# What cannot be read refuses: the list of files, or a list shorter than GitHub's count.
pr files-error OPEN CLEAN null
echo "gh: Server Error (HTTP 502)" >"$CASE/files-error"
run files-error
report 1 "$status" "files not listed: exit status"
check "files not listed: says so" said "Could not list the files"
check "files not listed: not merged" refused
pr too-many OPEN CLEAN null
jq '.changedFiles = 3001' "$CASE/view.json" >"$CASE/view.new" && mv "$CASE/view.new" "$CASE/view.json"
run too-many
report 4 "$status" "more files than GitHub lists: exit status"
check "more files than GitHub lists: says so" said "GitHub listed 1 of the 3001 files"
check "more files than GitHub lists: not merged" refused

# The head moves: while it is checked, nothing is merged or turned on; after, the merge is bound to the sha checked,
# and GitHub refuses it.
pr moves-during OPEN CLEAN null
echo 1 >"$CASE/moves"
echo "$H2" >"$CASE/moved-to"
run moves-during
report 3 "$status" "the head moves while checked: exit status"
check "the head moves while checked: says so" said "It changed while it was being checked"
check "the head moves while checked: not merged" refused
pr moves-after OPEN CLEAN null
echo "$H2" >"$CASE/head-now"
run moves-after
check "the head moves after: the merge is bound to the sha checked" logged "gh pr merge 5 --merge --match-head-commit $H1"
check "the head moves after: not merged" test "$(jq -r .state "$CASE/view.json")" == OPEN
check "the head moves after: not said to be merged" not said "Merged."

# A merged pull request that touched relay/ is only said to be merged.
pr merged-relay MERGED CLEAN null
files relay/src/index.ts
run merged-relay
report 0 "$status" "merged, touching relay/: exit status"

# No number, or more than one: refused before anything is asked of GitHub.
CASE=$T/usage; mkdir -p "$CASE"; : >"$CASE/log"
out=$("$merge" 2>&1); status=$?
report 2 "$status" "no number: exit status"
check "no number: says what it takes" said "usage: scripts/auto-merge"
out=$("$merge" 5 6 2>&1); status=$?
report 2 "$status" "two numbers: exit status"
check "two numbers: nothing asked of GitHub" test ! -s "$CASE/log"

echo "$pass passed, $fail failed"
((fail == 0))
