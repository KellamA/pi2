#!/bin/bash
# Checks scripts/iphone-sim against stand-ins for xcrun, xcodebuild and nice, put first on the PATH: xcrun answers
# `simctl` from a list of simulators kept in a JSON file in a temporary folder, and each stand-in writes down every call
# it is given. A copy of the script runs in a stand-in checkout there, so its records go there too. No simulator is made,
# booted or touched, and nothing is built; it needs bash and jq, and runs on Linux as on a Mac.
#
#   scripts/test-iphone-sim

set -uo pipefail

script="$(cd -P -- "$(dirname -- "$0")" && pwd -P)/iphone-sim"
command -v jq >/dev/null || { echo "test-iphone-sim: needs jq" >&2; exit 1; }

T=$(mktemp -d)
trap 'rm -rf "$T"' EXIT
T=$(cd -P -- "$T" && pwd -P)

mkdir -p "$T/repo/scripts" "$T/repo/iphone/pi2.xcodeproj" "$T/bin" "$T/home/Library" "$T/scratch"
cp "$script" "$T/repo/scripts/iphone-sim"
sim="$T/repo/scripts/iphone-sim"
records="$T/repo/iphone/build/simulators"
LOG=$T/log
DEVICES=$T/devices.json
export LOG DEVICES

# The simulators there are before any case: someone's booted one, and one whose name is taken.
OWNER=11111111-1111-1111-1111-111111111111
TAKEN=22222222-2222-2222-2222-222222222222
reset_devices() {
	jq -n --arg o "$OWNER" --arg t "$TAKEN" '{devices: {"com.apple.CoreSimulator.SimRuntime.iOS-27-2": [
		{udid: $o, name: "pi2-owner", state: "Booted", isAvailable: true},
		{udid: $t, name: "pi2-taken", state: "Shutdown", isAvailable: true}]}}' >"$DEVICES"
}

# xcrun simctl: list, create (a new id each time, from a counter), bootstatus -b, shutdown, delete, install, uninstall,
# launch (which writes down the SIMCTL_CHILD_ variables it would pass on), spawn, ui and io. $T/fail-create makes create
# fail.
cat >"$T/bin/xcrun" <<'EOF'
#!/bin/bash
{ printf 'xcrun'; printf ' %q' "$@"; echo; } >>"$LOG"
[[ $1 == simctl ]] || { echo "stand-in xcrun: only simctl" >&2; exit 1; }
shift
set_state() {
	jq --arg u "$1" --arg s "$2" '.devices[] |= map(if .udid == $u then .state = $s else . end)' "$DEVICES" >"$DEVICES.new" &&
		mv "$DEVICES.new" "$DEVICES"
}
case $1 in
list) cat "$DEVICES" ;;
create)
	[[ ! -f $(dirname "$LOG")/fail-create ]] || { echo "An error was encountered processing the command" >&2; exit 1; }
	n=$(($(cat "$DEVICES.count" 2>/dev/null || echo 0) + 1))
	echo "$n" >"$DEVICES.count"
	udid=$(printf 'AAAAAAAA-0000-0000-0000-%012d' "$n")
	jq --arg u "$udid" --arg n "$2" '.devices["com.apple.CoreSimulator.SimRuntime.iOS-27-2"] += [{udid: $u, name: $n, state: "Shutdown", isAvailable: true}]' \
		"$DEVICES" >"$DEVICES.new" && mv "$DEVICES.new" "$DEVICES"
	echo "$udid"
	;;
bootstatus) set_state "$2" Booted ;;
shutdown) set_state "$2" Shutdown ;;
delete)
	jq --arg u "$2" '.devices[] |= map(select(.udid != $u))' "$DEVICES" >"$DEVICES.new" && mv "$DEVICES.new" "$DEVICES"
	;;
launch) env | grep '^SIMCTL_CHILD_' | sort | sed 's/^/child-env /' >>"$LOG" ;;
install | uninstall | ui) ;;
# notifyutil -g answers with the state set last, as the simulator's own does.
spawn)
	if [[ $3 == notifyutil && $4 == -s ]]; then
		echo "$6" >"$DEVICES.notify"
	elif [[ $3 == notifyutil && $4 == -g ]]; then
		echo "$5 $(cat "$DEVICES.notify" 2>/dev/null || echo 0)"
	fi
	;;
io) for last in "$@"; do :; done; echo png >"$last" ;;
*) echo "stand-in xcrun: no simctl $1" >&2; exit 1 ;;
esac
EOF
# xcodebuild says what $T/xcodebuild-says holds, if there is one, as a test run's output, and ends with the status in
# $T/xcodebuild-status, if there is one.
cat >"$T/bin/xcodebuild" <<'EOF'
#!/bin/bash
{ printf 'xcodebuild'; printf ' %q' "$@"; echo; } >>"$LOG"
here=$(dirname "$LOG")
[[ ! -f $here/xcodebuild-says ]] || cat "$here/xcodebuild-says"
exit "$(cat "$here/xcodebuild-status" 2>/dev/null || echo 0)"
EOF
cat >"$T/bin/nice" <<'EOF'
#!/bin/bash
{ printf 'nice'; printf ' %q' "$@"; echo; } >>"$LOG"
shift 2
exec "$@"
EOF
chmod +x "$T/bin/"*

failures=0
fail() {
	echo "FAIL: $case_name: $*" >&2
	echo "  exit $status; stderr:" >&2
	sed 's/^/    /' "$T/err" >&2
	echo "  log:" >&2
	sed 's/^/    /' "$LOG" >&2
	failures=$((failures + 1))
}

# run <description> <arguments...>: runs the script from $T with a clean log, as the caller would.
case_name=
status=0
run() {
	case_name=$1
	shift
	: >"$LOG"
	(cd "$T" && env PATH="$T/bin:$PATH" HOME="$T/home" PI2_SCRATCH="$T/scratch" LOG="$LOG" DEVICES="$DEVICES" \
		SIMCTL_CHILD_LEAKED=from-the-shell "$sim" "$@") >"$T/out" 2>"$T/err"
	status=$?
}
expect_status() { [[ $status == "$1" ]] || fail "exit $status, expected $1"; }
expect_err() { grep -qF -- "$1" "$T/err" || fail "stderr lacks: $1"; }
expect_out() { grep -qxF -- "$1" "$T/out" || fail "stdout lacks the line: $1"; }
expect_log() { grep -qF -- "$1" "$LOG" || fail "no call with: $1"; }
expect_no_log() { ! grep -qF -- "$1" "$LOG" || fail "a call with: $1"; }
# A refusal: exit 2, the reason said, and nothing done but reading the list.
expect_refused() {
	expect_status 2
	expect_err "$1"
	! grep -v '^xcrun simctl list devices --json$' "$LOG" | grep -q . || fail "it did something before refusing"
}

reset_devices

# Usage.
run "no command"
expect_status 2
grep -qF 'Usage: scripts/iphone-sim' "$T/out" || fail "no usage"
run "help" help
expect_status 0
grep -qF 'Usage: scripts/iphone-sim' "$T/out" || fail "no usage"
run "an unknown command" boot pi2-1
expect_refused "no command 'boot'"

# Names, at create.
run "create without a name" create
expect_refused "give the simulator a name of your own"
run "create booted" create booted
expect_refused "'booted' names whichever simulator is booted"
run "create with capitals" create Pi2-1
expect_refused "is not a name this script takes"
run "create with a slash" create ../pi2
expect_refused "is not a name this script takes"
run "create with an id for a name" create 0bc6c5f2-8328-4dc8-b742-881da489bd30
expect_refused "looks like a simulator's id"
run "create a name simctl has already" create pi2-taken
expect_refused "is there already, and it may be someone else's"
[[ ! -e $records/pi2-taken ]] || fail "recorded a name it refused"
run "create an iPad" create pi2-1 --type "iPad Air 11-inch (M4)"
expect_refused "is not an iPhone's device type"
run "create with an unknown option" create pi2-1 --boot
expect_refused "create takes --type, --runtime and --derived-data, not --boot"
run "create with derived data under ~/Library" create pi2-1 --derived-data "$T/home/Library/Developer/Xcode/DerivedData"
expect_refused "not under ~/Library"
[[ ! -e $T/home/Library/Developer ]] || fail "made a folder under ~/Library"
ln -s "$T/home/Library" "$T/library-link"
run "create with derived data through a link into ~/Library" create pi2-1 --derived-data "$T/library-link/pi2"
expect_status 2
expect_err "not under ~/Library"
expect_no_log "simctl create"
touch "$T/fail-create"
run "create when simctl fails" create pi2-1
expect_status 1
expect_err "did not make the simulator"
[[ ! -e $records/pi2-1 ]] || fail "kept a record of a simulator it did not make"
rm "$T/fail-create"

# create.
run "create" create pi2-1
expect_status 0
expect_log "xcrun simctl create pi2-1 iPhone\\ 18\\ Pro"
expect_out "AAAAAAAA-0000-0000-0000-000000000001"
U1=AAAAAAAA-0000-0000-0000-000000000001
[[ $(cat "$records/pi2-1/udid" 2>/dev/null) == "$U1" ]] || fail "recorded no id"
[[ $(cat "$records/pi2-1/derived-data" 2>/dev/null) == "$T/scratch/iphone-build" ]] || fail "the derived data is not under the scratch folder"
run "create the same name again" create pi2-1
expect_refused "is there already"
run "create with a type, a runtime and derived data" create pi2-2 --type "iPhone 17" --runtime com.apple.CoreSimulator.SimRuntime.iOS-27-2 --derived-data dd
expect_status 0
expect_log "xcrun simctl create pi2-2 iPhone\\ 17 com.apple.CoreSimulator.SimRuntime.iOS-27-2"
U2=AAAAAAAA-0000-0000-0000-000000000002
[[ $(cat "$records/pi2-2/derived-data" 2>/dev/null) == "$T/dd" ]] || fail "a relative derived-data folder was not made absolute"
(
	cd "$T" && env -u PI2_SCRATCH PATH="$T/bin:$PATH" HOME="$T/home" LOG="$LOG" DEVICES="$DEVICES" "$sim" create pi2-3 >/dev/null 2>&1
)
[[ $(cat "$records/pi2-3/derived-data" 2>/dev/null) == "$T/repo/iphone/build/DerivedData" ]] ||
	fail "without a scratch folder, the derived data is not under iphone/build"

# Only this checkout's own simulators.
for command in build test run "shot x.png" "appearance dark" "text-size large" "face-id match" shutdown delete id; do
	set -- $command
	run "$1 on the booted simulator by name" "$1" pi2-owner "${@:2}"
	expect_refused "no simulator named 'pi2-owner' was made by this checkout"
	run "$1 on booted" "$1" booted "${@:2}"
	expect_refused "'booted' names whichever simulator is booted"
	run "$1 on the booted simulator's id" "$1" "$OWNER" "${@:2}"
	expect_status 2
	expect_no_log "$OWNER"
done
jq --arg u "$U2" '.devices[] |= map(if .udid == $u then .name = "pi2-renamed" else . end)' "$DEVICES" >"$DEVICES.new" &&
	mv "$DEVICES.new" "$DEVICES"
run "build on a simulator renamed since" build pi2-2
expect_refused "is now called 'pi2-renamed': it is left alone"
run "delete a simulator renamed since" delete pi2-2
expect_refused "is now called 'pi2-renamed': it is left alone"
[[ -f $records/pi2-2/udid ]] || fail "forgot a renamed simulator"
run "list" list
expect_status 0
expect_out "pi2-1	$U1	Shutdown"
expect_out "pi2-2	$U2	renamed to pi2-renamed"

# build and test.
run "build" build pi2-1
expect_status 0
expect_log "nice -n 15 xcodebuild build"
expect_log "id=$U1 -derivedDataPath"
expect_log "-destination platform=iOS\\ Simulator"
expect_log "CODE_SIGNING_ALLOWED=NO"
expect_log "-configuration Debug"
expect_log "-derivedDataPath $T/scratch/iphone-build -packageCachePath $T/scratch/iphone-build/PackageCache"
expect_log "-project $T/repo/iphone/pi2.xcodeproj -scheme pi2"
run "build a release build" build pi2-1 --release
expect_status 0
expect_log "-configuration Release"
run "test" test pi2-1 -- -only-testing:pi2Tests/PiModelsOnIOSTests -quiet -resultBundlePath "$T/results"
expect_status 0
expect_log "nice -n 15 xcodebuild test"
expect_log "-parallel-testing-enabled NO -only-testing:pi2Tests/PiModelsOnIOSTests -quiet -resultBundlePath $T/results CODE_SIGNING_ALLOWED=NO"
run "test a release build" test pi2-1 --release
expect_refused "test runs the Debug build's tests"
run "build with other derived data" build pi2-1 --derived-data "$T/elsewhere"
expect_status 0
expect_log "-derivedDataPath $T/elsewhere"
run "build with derived data under ~/Library" build pi2-1 --derived-data "$T/home/Library/Developer/Xcode/DerivedData"
expect_status 2
expect_no_log xcodebuild
# HOME set by the caller does not hide the account's own home folder. Refused before anything is made, so nothing is.
run "build with derived data under the account's ~/Library" build pi2-1 --derived-data "$(eval "printf %s ~$(id -un)")/Library/pi2-test-iphone-sim"
expect_status 2
expect_err "not under ~/Library"
expect_no_log xcodebuild
for option in "-destination generic/platform=iOS" "-destination platform=iOS,id=00008030-001A" "-sdk iphoneos" \
	-allowProvisioningUpdates CODE_SIGNING_ALLOWED=YES "CODE_SIGN_IDENTITY=Apple Development" DEVELOPMENT_TEAM=ABCDE12345 \
	PROVISIONING_PROFILE_SPECIFIER=x archive; do
	run "build with $option" build pi2-1 -- $option
	expect_refused "builds for its own simulator only, unsigned"
done
run "test with an option not listed" test pi2-1 -- -enableCodeCoverage YES
expect_refused "-enableCodeCoverage is not an option build and test take"
run "build with an unknown option" build pi2-1 --sign
expect_refused "build takes --release, --derived-data"
run "test with an unknown option" test pi2-1 --sign
expect_refused "test takes --derived-data, --repeat N, --until-failure"

# test --repeat: reading the options. Nothing is run when they are refused.
for times in 0 -3 abc 1001 3.5 01; do
	run "test --repeat $times" test pi2-1 --repeat "$times"
	expect_refused "--repeat takes a number of times from 1 to 1000, not '$times'"
done
run "test --repeat with no number" test pi2-1 --repeat
expect_refused "--repeat needs a number of times"
run "test --until-failure alone" test pi2-1 --until-failure
expect_refused "--until-failure needs --repeat N"
run "build --repeat" build pi2-1 --repeat 3
expect_refused "--repeat is test's"
run "build --until-failure" build pi2-1 --until-failure
expect_refused "--until-failure is test's"
run "test --repeat with -quiet" test pi2-1 --repeat 3 -- -quiet
expect_refused "which -quiet leaves out"
for option in -test-iterations -run-tests-until-failure -retry-tests-on-failure; do
	run "test with $option after --" test pi2-1 -- "$option"
	expect_refused "$option is not taken after --: test --repeat N"
done

# test --repeat: what it passes xcodebuild, and the line it ends with, read from a saved log of a run like the one
# #909 made (Swift Testing, each test repeated by itself), with the same symbols.
cat >"$T/xcodebuild-says" <<'EOF'
Test Suite 'Selected tests' started at 2026-11-24 16:33:52.173.
Test Suite 'pi2Tests.xctest' started at 2026-11-24 16:33:52.174.
Test Suite 'pi2Tests.xctest' passed at 2026-11-24 16:33:52.174.
	 Executed 0 tests, with 0 failures (0 unexpected) in 0.000 (0.000) seconds
◇ Test run started.
↳ Testing Library Version: 2403
◇ Suite Flaky909Tests started.
◇ Test coinToss() started.
◇ Test coinToss() started (repetition 2).
◇ Test coinToss() started (repetition 3).
✘ Test coinToss() recorded an issue at Flaky909Tests.swift:6:9: Expectation failed: Bool.random()
↳ Bool.random() → false
✘ Test coinToss() failed after 0.009 seconds with 1 issue.
◇ Test "one in three" started.
✘ Test "one in three" recorded an issue at Flaky909Tests.swift:10:9: Expectation failed: Int.random(in: 0..<3) != 0
◇ Test "one in three" started (repetition 2).
◇ Test "one in three" started (repetition 3).
✘ Test "one in three" recorded an issue at Flaky909Tests.swift:10:9: Expectation failed: Int.random(in: 0..<3) != 0
✘ Test "one in three" recorded an issue at Flaky909Tests.swift:11:9: Expectation failed: Test alwaysPasses() started.
✘ Test "one in three" failed after 0.002 seconds with 2 issues.
◇ Test alwaysPasses() started.
◇ Test alwaysPasses() started (repetition 2).
◇ Test alwaysPasses() started (repetition 3).
✔ Test alwaysPasses() passed after 0.002 seconds.
✘ Suite Flaky909Tests failed after 0.015 seconds with 2 issues.
✘ Test run with 3 tests in 1 suite failed after 0.019 seconds with 2 issues.
Test session results, code coverage, and logs:
	/tmp/Test-pi2.xcresult

Failing tests:
	Flaky909Tests.coinToss()
	Flaky909Tests."one in three"

** TEST FAILED **
EOF
echo 65 >"$T/xcodebuild-status"
run "test --repeat 3" test pi2-1 --repeat 3 -- -only-testing:pi2Tests/Flaky909Tests
expect_status 65
expect_log "-only-testing:pi2Tests/Flaky909Tests -test-iterations 3 CODE_SIGNING_ALLOWED=NO"
expect_no_log "-run-tests-until-failure"
summary="iphone-sim: 3 iterations of 3 tests: 1 passed, 2 failed; failed: Flaky909Tests.coinToss() 1 of 3, Flaky909Tests.\"one in three\" 2 of 3"
[[ $(tail -n 1 "$T/out") == "$summary" ]] || fail "the last line is not: $summary"
expect_out "✔ Test alwaysPasses() passed after 0.002 seconds."
cmp -s "$T/xcodebuild-says" "$T/scratch/iphone-build/Logs/iphone-sim-test-repeat.log" ||
	fail "the whole output was not kept in the derived data's Logs"

# --until-failure: each test stops at its first failure, so their counts differ.
cat >"$T/xcodebuild-says" <<'EOF'
◇ Test run started.
◇ Suite Flaky909Tests started.
◇ Test coinToss() started.
✘ Test coinToss() recorded an issue at Flaky909Tests.swift:6:9: Expectation failed: Bool.random()
✘ Test coinToss() failed after 0.008 seconds with 1 issue.
◇ Test alwaysPasses() started.
◇ Test alwaysPasses() started (repetition 2).
◇ Test alwaysPasses() started (repetition 3).
◇ Test alwaysPasses() started (repetition 4).
✔ Test alwaysPasses() passed after 0.001 seconds.
◇ Test oneInThree() started.
◇ Test oneInThree() started (repetition 2).
✘ Test oneInThree() recorded an issue at Flaky909Tests.swift:10:9: Expectation failed: Int.random(in: 0..<3) != 0
✘ Test oneInThree() failed after 0.003 seconds with 1 issue.
✘ Test run with 3 tests in 1 suite failed after 0.017 seconds with 2 issues.
Failing tests:
	Flaky909Tests.coinToss()
	Flaky909Tests.oneInThree()
	OtherTests.oneInThree()
** TEST FAILED **
EOF
run "test --repeat 4 --until-failure" test pi2-1 --until-failure --repeat 4
expect_status 65
expect_log "-test-iterations 4 -run-tests-until-failure CODE_SIGNING_ALLOWED=NO"
summary="iphone-sim: 4 iterations of 3 tests: 2 passed, 2 failed; failed: Flaky909Tests.coinToss() 1 of 1, oneInThree() 1 of 2"
[[ $(tail -n 1 "$T/out") == "$summary" ]] || fail "the last line is not: $summary"

# Every run passed.
cat >"$T/xcodebuild-says" <<'EOF'
◇ Test run started.
◇ Test jsonValueKeepsEveryKind() started.
◇ Test jsonValueKeepsEveryKind() started (repetition 2).
✔ Test jsonValueKeepsEveryKind() passed after 0.001 seconds.
✔ Test run with 1 test in 1 suite passed after 0.002 seconds.
** TEST SUCCEEDED **
EOF
echo 0 >"$T/xcodebuild-status"
run "test --repeat 2, passing" test pi2-1 --repeat 2 -- '-only-testing:pi2Tests/PiModelsOnIOSTests/jsonValueKeepsEveryKind()'
expect_status 0
[[ $(tail -n 1 "$T/out") == "iphone-sim: 2 iterations of 1 test: 2 passed, 0 failed" ]] || fail "no line saying both passed"

# XCTest's runs, which say how each one ended.
cat >"$T/xcodebuild-says" <<'EOF'
Test Suite 'Selected tests' started at 2026-11-24 16:33:52.173.
Test Case '-[pi2Tests.OldTests testOne]' started.
Test Case '-[pi2Tests.OldTests testOne]' passed (0.001 seconds).
Test Case '-[pi2Tests.OldTests testTwo]' started.
Test Case '-[pi2Tests.OldTests testTwo]' failed (0.002 seconds).
Test Case '-[pi2Tests.OldTests testOne]' started.
Test Case '-[pi2Tests.OldTests testOne]' passed (0.001 seconds).
Test Case '-[pi2Tests.OldTests testTwo]' started.
Test Case '-[pi2Tests.OldTests testTwo]' passed (0.001 seconds).
EOF
echo 65 >"$T/xcodebuild-status"
run "test --repeat 2, XCTest" test pi2-1 --repeat 2
expect_status 65
[[ $(tail -n 1 "$T/out") == "iphone-sim: 2 iterations of 2 tests: 1 passed, 1 failed; failed: OldTests.testTwo 1 of 2" ]] ||
	fail "no line for XCTest's runs"

# No test ran: a Swift Testing test named without its ().
cat >"$T/xcodebuild-says" <<'EOF'
◇ Test run started.
✔ Test run with 0 tests in 0 suites passed after 0.001 seconds.
** TEST SUCCEEDED **
EOF
echo 0 >"$T/xcodebuild-status"
run "test --repeat with no test run" test pi2-1 --repeat 5 -- -only-testing:pi2Tests/PiModelsOnIOSTests/jsonValueKeepsEveryKind
expect_status 0
grep -qF "no test ran, so nothing was repeated" <(tail -n 1 "$T/out") || fail "no line saying no test ran"
grep -qF "a single Swift Testing test needs () after its name" "$T/out" || fail "no word on ()"
rm "$T/xcodebuild-says" "$T/xcodebuild-status"

# run.
run "run before a build" run pi2-1
expect_refused "no Debug build in $T/scratch/iphone-build: scripts/iphone-sim build pi2-1 first"
mkdir -p "$T/scratch/iphone-build/Build/Products/Debug-iphonesimulator/pi2.app"
run "run" run pi2-1 --env PI2_SHOW=face-id-check --env 'GREETING=a b=c' -- -flag 'two words'
expect_status 0
expect_log "xcrun simctl bootstatus $U1 -b"
expect_log "xcrun simctl install $U1 $T/scratch/iphone-build/Build/Products/Debug-iphonesimulator/pi2.app"
expect_log "xcrun simctl launch --terminate-running-process $U1 dev.pi2.ios -flag two\\ words"
expect_log "child-env SIMCTL_CHILD_PI2_SHOW=face-id-check"
expect_log "child-env SIMCTL_CHILD_GREETING=a b=c"
expect_no_log "SIMCTL_CHILD_LEAKED"
expect_no_log "simctl uninstall"
run "run again, booted" run pi2-1
expect_status 0
expect_no_log bootstatus
run "run fresh" run pi2-1 --fresh --env PI2_TRANSPORT=remote
expect_status 0
expect_log "xcrun simctl uninstall $U1 dev.pi2.ios"
grep -A1 -F "simctl uninstall" "$LOG" | grep -qF "xcrun simctl install $U1" || fail "the app was not installed again after it was uninstalled"
run "run a release build before building it" run pi2-1 --release
expect_refused "no Release build"
run "run with a bad --env" run pi2-1 --env 'NO-DASHES=1'
expect_refused "--env takes NAME=VALUE"
run "run with --env and no value" run pi2-1 --env
expect_refused "--env needs NAME=VALUE"
run "run with a two-line value" run pi2-1 --env $'A=one\ntwo'
expect_refused "--env takes a value on one line"

# Pictures, appearance and text size.
run "shot with no file" shot pi2-1
expect_refused "shot needs a file"
run "shot to a file that is not a PNG" shot pi2-1 x.jpg
expect_refused "name a file ending in .png"
run "shot in an unknown appearance" shot pi2-1 x.png --appearance sepia
expect_refused "the appearance is light or dark"
run "shot in an unknown text size" shot pi2-1 x.png --text-size huge
expect_refused "'huge' is not a text size"
run "shot" shot pi2-1 shots/plain.png
expect_status 0
expect_log "xcrun simctl io $U1 screenshot --type=png shots/plain.png"
expect_no_log "simctl ui"
[[ -f $T/shots/plain.png ]] || fail "no picture written"
run "shot dark, at the largest text" shot pi2-1 "$T/shots/dark.png" --appearance dark --text-size accessibility-extra-extra-extra-large
expect_status 0
expect_log "xcrun simctl ui $U1 appearance dark"
expect_log "xcrun simctl ui $U1 content_size accessibility-extra-extra-extra-large"
expect_log "xcrun simctl io $U1 screenshot --type=png $T/shots/dark.png"
run "appearance" appearance pi2-1 light
expect_status 0
expect_log "xcrun simctl ui $U1 appearance light"
run "appearance with no value" appearance pi2-1
expect_refused "appearance takes a simulator's name and light or dark"
run "appearance auto" appearance pi2-1 auto
expect_refused "the appearance is light or dark"
run "text-size" text-size pi2-1 extra-large
expect_status 0
expect_log "xcrun simctl ui $U1 content_size extra-large"
run "text-size increment" text-size pi2-1 increment
expect_refused "'increment' is not a text size"

# The simulator's Face ID.
run "face-id with nothing to do" face-id pi2-1
expect_refused "face-id takes a simulator's name and enrol, match or no-match"
run "face-id with an unknown answer" face-id pi2-1 passcode
expect_refused "face-id takes enrol, match or no-match, not 'passcode'"
run "face-id enrol" face-id pi2-1 enrol
expect_status 0
expect_log "xcrun simctl spawn $U1 notifyutil -s com.apple.BiometricKit.enrollmentChanged 1"
expect_log "xcrun simctl spawn $U1 notifyutil -p com.apple.BiometricKit.enrollmentChanged"
expect_log "xcrun simctl spawn $U1 notifyutil -g com.apple.BiometricKit.enrollmentChanged"
run "face-id match" face-id pi2-1 match
expect_status 0
expect_log "xcrun simctl spawn $U1 notifyutil -p com.apple.BiometricKit_Sim.pearl.match"
run "face-id no-match" face-id pi2-1 no-match
expect_status 0
expect_log "xcrun simctl spawn $U1 notifyutil -p com.apple.BiometricKit_Sim.pearl.nomatch"

# id, shutdown, delete.
run "id" id pi2-1
expect_status 0
expect_out "$U1"
run "shutdown" shutdown pi2-1
expect_status 0
expect_log "xcrun simctl shutdown $U1"
run "shutdown, already shut down" shutdown pi2-1
expect_status 0
expect_no_log "simctl shutdown"
run "boot it again" appearance pi2-1 dark
run "delete" delete pi2-1
expect_status 0
expect_log "xcrun simctl shutdown $U1"
expect_log "xcrun simctl delete $U1"
expect_err "its builds stay in $T/scratch/iphone-build"
[[ ! -e $records/pi2-1 ]] || fail "kept the record of a deleted simulator"
[[ -d $T/scratch/iphone-build ]] || fail "deleted the derived data"
run "build on a deleted simulator" build pi2-1
expect_refused "no simulator named 'pi2-1' was made by this checkout"
U3=$(cat "$records/pi2-3/udid")
jq --arg u "$U3" '.devices[] |= map(select(.udid != $u))' "$DEVICES" >"$DEVICES.new" && mv "$DEVICES.new" "$DEVICES"
run "build on a simulator deleted outside the script" build pi2-3
expect_refused "is gone: scripts/iphone-sim delete pi2-3 forgets it"
run "delete a simulator deleted outside the script" delete pi2-3
expect_status 0
expect_err "was gone already; forgetting it"
expect_no_log "simctl delete"
[[ ! -e $records/pi2-3 ]] || fail "kept the record of a simulator that is gone"

# Nothing of anyone else's was touched.
[[ $(jq -r --arg o "$OWNER" '.devices[][] | select(.udid == $o) | .state' "$DEVICES") == Booted ]] ||
	fail "the booted simulator is not as it was"
[[ -n $(jq -r --arg t "$TAKEN" '.devices[][] | select(.udid == $t) | .udid' "$DEVICES") ]] ||
	fail "the simulator named pi2-taken is gone"

if ((failures)); then
	echo "test-iphone-sim: $failures failed" >&2
	exit 1
fi
echo "test-iphone-sim: all passed"
