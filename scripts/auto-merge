#!/bin/bash
# Turns on auto-merge for a pull request, and, run again, says where it stands and puts right what has gone wrong (#233).
#
#   scripts/auto-merge <number>
#
# Run it as soon as the pull request is open, instead of `gh pr merge <number> --auto --merge`, and again whenever you
# look at it, after pushing a fix or merging main into the branch too, until it says the pull request is merged:
#
# - every required check passed already (GitHub says the pull request is in clean status): merges it now, with a merge
#   commit, since gh refuses to turn auto-merge on for a pull request with nothing left to wait for (#553);
#
# - auto-merge off (never turned on, or turned off by GitHub): turns it on, with a merge commit;
# - auto-merge on, every required check passed and nothing merged three minutes after the last one finished: turns
#   auto-merge off and on again, which merges it. GitHub usually merges within a minute or two of the last check;
# - a conflict with main, or a required check that failed, was cancelled or timed out: names it at once with its link,
#   even while others still run, and says what to do; and whether a check was only cancelled because no runner took
#   it, which CI runs again by itself up to the run's fourth attempt (#637);
# - gh failing to read the checks: says so, with gh's error, and does not take it for checks not reported yet.
#
# Exit status: 0 merged; 3 waiting for checks, with auto-merge on; 1 something needs you; 2 usage. Needs gh and jq.

set -euo pipefail

STALL_SECONDS=180
NO_RUNNER='was not acquired by Runner'
RERUN_ATTEMPTS=4 # scripts/rerun-if-no-runner's MAX_ATTEMPTS: a run at this attempt is not run again by itself

n=${1:-}
[[ $n =~ ^[0-9]+$ && $# == 1 ]] || { echo "usage: scripts/auto-merge <pull request number>" >&2; exit 2; }

view() { gh pr view "$n" --json state,mergeStateStatus,autoMergeRequest,url; }
pr=$(view)
state() { jq -r .state <<<"$pr"; }
echo "#$n $(jq -r .url <<<"$pr")"

case $(state) in
MERGED) echo "Merged."; exit 0 ;;
CLOSED) echo "Closed without merging."; exit 1 ;;
esac

# A pull request whose required checks all passed is in clean status, and gh answers `pr merge --auto` for one with
# "Pull request is in clean status" and fails: there is nothing left to wait for, so merge it now instead (#553).
if [[ $(jq -r .mergeStateStatus <<<"$pr") == CLEAN ]]; then
	echo "Every required check has passed and nothing is left to wait for: merging it now."
	gh pr merge "$n" --merge
	pr=$(view)
	[[ $(state) != MERGED ]] || { echo "Merged."; exit 0; }
	echo "GitHub has not merged it yet ($(jq -r .mergeStateStatus <<<"$pr")): run this again in a minute."
	exit 3
fi

if [[ $(jq -r .autoMergeRequest <<<"$pr") == null ]]; then
	echo "Auto-merge is off: turning it on."
	gh pr merge "$n" --auto --merge
	pr=$(view)
	[[ $(state) != MERGED ]] || { echo "Merged."; exit 0; }
fi

if [[ $(jq -r .mergeStateStatus <<<"$pr") == DIRTY ]]; then
	echo "It conflicts with main. Merge origin/main into the branch, keeping both sides' work, check it, push, and run this again."
	exit 1
fi

# The required checks of the newest commit. gh leaves out one not reported yet, and answers none reported at all with an
# error saying so, which is waited for. Any other error says nothing about the checks: it is not taken for that (#637).
err=$(mktemp)
trap 'rm -f "$err"' EXIT
if ! checks=$(gh pr checks "$n" --required --json name,state,bucket,completedAt,link 2>"$err"); then
	if grep -qE 'no (required )?checks reported' "$err"; then
		echo "Auto-merge is on; no required check has reported yet."
		exit 3
	fi
	echo "Could not read the required checks. gh said: $(tr '\n' ' ' <"$err")"
	echo "This says nothing about the checks themselves. Run this again in a minute."
	exit 1
fi
if [[ $(jq length <<<"$checks") == 0 ]]; then
	echo "Auto-merge is on; no required check has reported yet."
	exit 3
fi

# A required check that finished badly is named at once with its link, whatever else is still running (#637). gh's
# bucket `fail` is a failure, a time-out, an error or an action required; `cancel` is a cancelled one.
failed=0
unacquired=0
while IFS=$'\t' read -r name state bucket link; do
	[[ -n $name ]] || continue
	run=
	job=
	if [[ $link =~ /actions/runs/([0-9]+)/job/([0-9]+) ]]; then
		run=${BASH_REMATCH[1]}
		job=${BASH_REMATCH[2]}
	fi
	if [[ $bucket == cancel && -n $job ]]; then
		notes=$(gh api "repos/{owner}/{repo}/check-runs/$job/annotations" --jq '.[].message' 2>/dev/null) || notes=
		if [[ $notes == *"$NO_RUNNER"* ]]; then
			attempt=$(gh api "repos/{owner}/{repo}/actions/runs/$run" --jq .run_attempt 2>/dev/null) || attempt=0
			[[ $attempt =~ ^[0-9]+$ ]] || attempt=0
			if ((attempt < RERUN_ATTEMPTS)); then
				echo "- $name: cancelled, no runner took it. $link"
				echo "  CI runs it again by itself; if it has not started again in a few minutes: gh run rerun $run --failed"
				unacquired=$((unacquired + 1))
				continue
			fi
			echo "- $name: cancelled, no runner took it at attempt $attempt, which CI does not run again by itself. $link"
			echo "  Run it again: gh run rerun $run --failed"
			failed=$((failed + 1))
			continue
		fi
	fi
	case $bucket/$state in
	cancel/*) echo "- $name: cancelled. $link" ;;
	*/TIMED_OUT) echo "- $name: timed out. $link" ;;
	*/FAILURE) echo "- $name: failed. $link" ;;
	*) echo "- $name: failed ($state). $link" ;;
	esac
	if [[ -z $run ]]; then
		echo "  Read what it says there, fix it and push."
	elif [[ $bucket == cancel ]]; then
		echo "  Run it again (gh run rerun $run --failed), or push a fix if it was cancelled for a reason of the change's."
	else
		echo "  Read the log (gh run view $run --log-failed), fix it and push; if it fails for a reason not the change's (it"
		echo "  passes on main), run it again: gh run rerun $run --failed"
	fi
	failed=$((failed + 1))
done < <(jq -r '.[] | select(.bucket == "fail" or .bucket == "cancel") | [.name, .state, .bucket, .link] | @tsv' <<<"$checks")

waiting=$(jq -r '[.[] | select(.bucket == "pending") | .name] | join(", ")' <<<"$checks")
if ((failed > 0)); then
	[[ -z $waiting ]] || echo "Still running: $waiting."
	echo "Auto-merge stays on through a fix: run this again after you push, or after it runs again."
	exit 1
fi
((unacquired == 0)) || exit 3
if [[ -n $waiting ]]; then
	echo "Auto-merge is on, waiting for: $waiting."
	exit 3
fi

last=$(jq -r '[.[] | .completedAt | select(. != null and (startswith("0001") | not))] | max // empty' <<<"$checks")
since=$(($(date -u +%s) - $(jq -n --arg t "$last" '$t | fromdateiso8601? // now' | cut -d. -f1)))
status=$(jq -r .mergeStateStatus <<<"$pr")
if [[ $status == BLOCKED ]] && ((since >= STALL_SECONDS)); then
	echo "Every required check reported has passed, but GitHub still blocks it: a required check has not reported. If main"
	echo "requires a check this branch's CI does not have yet, merge origin/main into the branch and push."
	exit 1
fi
if [[ $status == UNSTABLE || $status == HAS_HOOKS ]] && ((since >= STALL_SECONDS)); then
	echo "Every required check passed ${since}s ago and it has not merged: turning auto-merge off and on again."
	gh pr merge "$n" --disable-auto
	gh pr merge "$n" --auto --merge
	pr=$(view)
	[[ $(state) != MERGED ]] || { echo "Merged."; exit 0; }
fi
echo "Auto-merge is on and the required checks have passed ($status, ${since}s ago); GitHub merges it shortly. Run this again in a minute or two."
exit 3
