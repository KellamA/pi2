#!/bin/bash
# Turns on auto-merge for a pull request, and, run again, says where it stands and puts right what has gone wrong (#233).
#
#   scripts/auto-merge <number>
#
# Run it as soon as the pull request is open, instead of `gh pr merge <number> --auto --merge`, and again whenever you
# look at it, after pushing a fix or merging main into the branch too, until it says the pull request is merged:
#
# - every required check passed already (GitHub says the pull request is in clean status): merges it now, with a merge
#   commit, since gh refuses to turn auto-merge on for a pull request with nothing left to wait for (#553);
#
# - auto-merge off (never turned on, or turned off by GitHub): turns it on, with a merge commit;
# - auto-merge on, every required check passed and nothing merged three minutes after the last one finished: turns
#   auto-merge off and on again, which merges it. GitHub usually merges within a minute or two of the last check;
# - a conflict with main, or a required check that failed, was cancelled or timed out: names it at once with its link,
#   even while others still run, and says what to do; and whether a check was only cancelled because no runner took
#   it, which CI runs again by itself up to the run's fourth attempt (#637);
# - gh failing to read the checks: says so, with gh's error, and does not take it for checks not reported yet;
# - a pull request that touches a path `.github/CODEOWNERS` gives an owner (the relay, RemoteKit, the device lists, this
#   script and every workflow: docs/iphone.md 12.3, #668): refuses it before anything else, names the paths, says it
#   waits for the owner's review, and turns auto-merge off if it was on. The owner reviews and merges it on GitHub.
#
# Which paths are the owner's is read from GitHub, not from this checkout: `.github/CODEOWNERS` as it is on main, which
# a pull request cannot change, and as it is at the pull request's newest commit, which can only add to it. A file is
# the owner's if either copy gives it an owner, by the rule GitHub uses: the last line whose pattern matches it. The
# files are GitHub's list of what the pull request changes, both names of a moved file. Anything that cannot be read
# (CODEOWNERS, other than missing; the list of files, or a list shorter than GitHub's count) refuses too. This is a
# courtesy, not the guard: an agent can call gh itself, and a push after auto-merge is on is not looked at until the
# script is run again. The guard is branch protection on main requiring the code owner's review (docs/relay.md).
#
# Exit status: 0 merged; 3 waiting for checks, with auto-merge on; 4 waits for the owner's review; 1 something needs
# you; 2 usage. Needs gh and jq.

set -euo pipefail

STALL_SECONDS=180
NO_RUNNER='was not acquired by Runner'
RERUN_ATTEMPTS=4 # scripts/rerun-if-no-runner's MAX_ATTEMPTS: a run at this attempt is not run again by itself

n=${1:-}
[[ $n =~ ^[0-9]+$ && $# == 1 ]] || { echo "usage: scripts/auto-merge <pull request number>" >&2; exit 2; }

view() { gh pr view "$n" --json state,mergeStateStatus,autoMergeRequest,url,headRefOid,changedFiles; }
pr=$(view)
state() { jq -r .state <<<"$pr"; }
echo "#$n $(jq -r .url <<<"$pr")"

case $(state) in
MERGED) echo "Merged."; exit 0 ;;
CLOSED) echo "Closed without merging."; exit 1 ;;
esac

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

# Stops without merging anything, after saying why: auto-merge, if on, is turned off, so that GitHub does not merge it
# before what stopped it is settled.
hold() {
	if [[ $(jq -r .autoMergeRequest <<<"$pr") != null ]]; then
		gh pr merge "$n" --disable-auto
		echo "Auto-merge was on: turned it off, so that nothing merges it meanwhile."
	fi
	exit "$1"
}

# .github/CODEOWNERS at a commit, into $tmp/<name>: status 0 read, 4 not there, 1 not read (gh's error in $tmp/err).
codeowners() {
	if gh api "repos/{owner}/{repo}/contents/.github/CODEOWNERS?ref=$1" -H 'Accept: application/vnd.github.raw+json' \
		>"$tmp/$2" 2>"$tmp/err"; then
		return 0
	fi
	: >"$tmp/$2"
	grep -q 'HTTP 404' "$tmp/err" && return 4
	return 1
}

# The owner's paths (#668). Main's copy first: a pull request cannot change it. Missing, it is only the time before
# #668 merged; once there, taking it out is itself a change to one of its paths.
for copy in main:main "head:$(jq -r .headRefOid <<<"$pr")"; do
	if codeowners "${copy#*:}" "${copy%%:*}"; then :; else
		read_status=$?
		if ((read_status != 4)); then
			echo "Could not read .github/CODEOWNERS (${copy%%:*}), which says which paths wait for the owner's review. gh said:"
			echo "  $(tr '\n' ' ' <"$tmp/err")"
			echo "It is not merged until that can be checked. Run this again in a minute."
			hold 1
		fi
	fi
done

# Every file the pull request changes, one a line: its name, a tab, and the name it had if it was moved. GitHub lists
# at most 3,000; a list shorter than its count of changed files cannot say which are the owner's.
if ! gh api "repos/{owner}/{repo}/pulls/$n/files?per_page=100" --paginate \
	--jq '.[] | [.filename, (.previous_filename // "")] | @tsv' >"$tmp/files" 2>"$tmp/err"; then
	echo "Could not list the files it changes, to see whether any waits for the owner's review. gh said:"
	echo "  $(tr '\n' ' ' <"$tmp/err")"
	echo "It is not merged until that can be checked. Run this again in a minute."
	hold 1
fi
listed=$(grep -c . "$tmp/files" || true)
changed=$(jq -r '.changedFiles // 0' <<<"$pr")
if ((listed < changed)); then
	echo "GitHub listed $listed of the $changed files it changes, so it cannot be told whether any waits for the owner's"
	echo "review. A pull request that large waits for the owner: they review it and merge it on GitHub."
	hold 4
fi

# Each file a copy gives an owner, with the copy and the pattern: "<file>\t<copy>\t<pattern>". A CODEOWNERS pattern is
# read as gitignore reads one, which GitHub follows but for `!`, `[ ]` and an escaped `#`, none of which it supports:
# anchored at the top by a leading `/` or a `/` inside it, matching a folder and everything in it, `*` and `?` within
# one name, `**` across folders. The owners are the words after it, up to a comment; none means no owner. Where this
# reading and GitHub's could differ it is the wider: `docs/*`, which GitHub's documentation says covers no file deeper
# than docs/, covers them here too.
# shellcheck disable=SC2016 # jq's variables, not the shell's
owned=$(jq -rn --rawfile main "$tmp/main" --rawfile head "$tmp/head" --rawfile files "$tmp/files" '
	def regex:
		(startswith("/")) as $root
		| (endswith("/")) as $folder
		| (sub("^/"; "") | sub("/$"; "")) as $core
		| ($root or ($core | test("/"))) as $anchored
		| ($core
			| gsub("(?<c>[.+(){}|^$\\\\\\[\\]])"; "\\\(.c)")
			| gsub("\\*\\*"; "\u0001")
			| gsub("\\*"; "[^/]*")
			| gsub("\\?"; "[^/]")
			| gsub("/\u0001/"; "/(.*/)?")
			| gsub("^\u0001/"; "(.*/)?")
			| gsub("/\u0001$"; "/.*")
			| gsub("\u0001"; ".*")) as $body
		| (if $anchored then "^" else "^(.*/)?" end) + $body + (if $folder then "/.*$" else "(/.*)?$" end);
	def rules:
		[split("\n")[] | sub("\r$"; "") | select(test("^\\s*(#|$)") | not)
			| [splits("\\s+")] | map(select(. != ""))
			| {pattern: .[0], regex: (.[0] | regex),
				owners: (reduce .[1:][] as $w ({stop: false, list: []};
					if .stop or ($w | startswith("#")) then .stop = true else .list += [$w] end) | .list)}];
	[["main'\''s", ($main | rules)], ["this pull request'\''s", ($head | rules)]] as $copies
	| $files | split("\n")[] | select(. != "") | split("\t")[] | select(. != "") as $file
	| $copies[] | .[0] as $copy
	| ([.[1][] | select(.regex as $r | $file | test($r))] | last) as $rule
	| select($rule != null and ($rule.owners | length) > 0)
	| [$file, $copy, $rule.pattern] | @tsv
') || { echo "Could not read .github/CODEOWNERS's patterns: refusing until it can be."; hold 1; }
if [[ -n $owned ]]; then
	echo "It touches paths that wait for the owner's review, as .github/CODEOWNERS gives them (docs/iphone.md 12.3):"
	while IFS=$'\t' read -r file copy pattern; do
		echo "- $file ($pattern, in $copy CODEOWNERS)"
	done < <(awk -F'\t' '!seen[$1]++' <<<"$owned")
	echo "No agent merges it: the owner reviews it on GitHub and merges it. Leave it open, and mark its issue waiting on"
	echo "the owner's review."
	hold 4
fi

# A pull request whose required checks all passed is in clean status, and gh answers `pr merge --auto` for one with
# "Pull request is in clean status" and fails: there is nothing left to wait for, so merge it now instead (#553).
if [[ $(jq -r .mergeStateStatus <<<"$pr") == CLEAN ]]; then
	echo "Every required check has passed and nothing is left to wait for: merging it now."
	gh pr merge "$n" --merge
	pr=$(view)
	[[ $(state) != MERGED ]] || { echo "Merged."; exit 0; }
	echo "GitHub has not merged it yet ($(jq -r .mergeStateStatus <<<"$pr")): run this again in a minute."
	exit 3
fi

if [[ $(jq -r .autoMergeRequest <<<"$pr") == null ]]; then
	echo "Auto-merge is off: turning it on."
	gh pr merge "$n" --auto --merge
	pr=$(view)
	[[ $(state) != MERGED ]] || { echo "Merged."; exit 0; }
fi

if [[ $(jq -r .mergeStateStatus <<<"$pr") == DIRTY ]]; then
	echo "It conflicts with main. Merge origin/main into the branch, keeping both sides' work, check it, push, and run this again."
	exit 1
fi

# The required checks of the newest commit. gh leaves out one not reported yet, and answers none reported at all with an
# error saying so, which is waited for. Any other error says nothing about the checks: it is not taken for that (#637).
err=$tmp/err
if ! checks=$(gh pr checks "$n" --required --json name,state,bucket,completedAt,link 2>"$err"); then
	if grep -qE 'no (required )?checks reported' "$err"; then
		echo "Auto-merge is on; no required check has reported yet."
		exit 3
	fi
	echo "Could not read the required checks. gh said: $(tr '\n' ' ' <"$err")"
	echo "This says nothing about the checks themselves. Run this again in a minute."
	exit 1
fi
if [[ $(jq length <<<"$checks") == 0 ]]; then
	echo "Auto-merge is on; no required check has reported yet."
	exit 3
fi

# A required check that finished badly is named at once with its link, whatever else is still running (#637). gh's
# bucket `fail` is a failure, a time-out, an error or an action required; `cancel` is a cancelled one.
failed=0
unacquired=0
while IFS=$'\t' read -r name state bucket link; do
	[[ -n $name ]] || continue
	run=
	job=
	if [[ $link =~ /actions/runs/([0-9]+)/job/([0-9]+) ]]; then
		run=${BASH_REMATCH[1]}
		job=${BASH_REMATCH[2]}
	fi
	if [[ $bucket == cancel && -n $job ]]; then
		notes=$(gh api "repos/{owner}/{repo}/check-runs/$job/annotations" --jq '.[].message' 2>/dev/null) || notes=
		if [[ $notes == *"$NO_RUNNER"* ]]; then
			attempt=$(gh api "repos/{owner}/{repo}/actions/runs/$run" --jq .run_attempt 2>/dev/null) || attempt=0
			[[ $attempt =~ ^[0-9]+$ ]] || attempt=0
			if ((attempt < RERUN_ATTEMPTS)); then
				echo "- $name: cancelled, no runner took it. $link"
				echo "  CI runs it again by itself; if it has not started again in a few minutes: gh run rerun $run --failed"
				unacquired=$((unacquired + 1))
				continue
			fi
			echo "- $name: cancelled, no runner took it at attempt $attempt, which CI does not run again by itself. $link"
			echo "  Run it again: gh run rerun $run --failed"
			failed=$((failed + 1))
			continue
		fi
	fi
	case $bucket/$state in
	cancel/*) echo "- $name: cancelled. $link" ;;
	*/TIMED_OUT) echo "- $name: timed out. $link" ;;
	*/FAILURE) echo "- $name: failed. $link" ;;
	*) echo "- $name: failed ($state). $link" ;;
	esac
	if [[ -z $run ]]; then
		echo "  Read what it says there, fix it and push."
	elif [[ $bucket == cancel ]]; then
		echo "  Run it again (gh run rerun $run --failed), or push a fix if it was cancelled for a reason of the change's."
	else
		echo "  Read the log (gh run view $run --log-failed), fix it and push; if it fails for a reason not the change's (it"
		echo "  passes on main), run it again: gh run rerun $run --failed"
	fi
	failed=$((failed + 1))
done < <(jq -r '.[] | select(.bucket == "fail" or .bucket == "cancel") | [.name, .state, .bucket, .link] | @tsv' <<<"$checks")

waiting=$(jq -r '[.[] | select(.bucket == "pending") | .name] | join(", ")' <<<"$checks")
if ((failed > 0)); then
	[[ -z $waiting ]] || echo "Still running: $waiting."
	echo "Auto-merge stays on through a fix: run this again after you push, or after it runs again."
	exit 1
fi
((unacquired == 0)) || exit 3
if [[ -n $waiting ]]; then
	echo "Auto-merge is on, waiting for: $waiting."
	exit 3
fi

last=$(jq -r '[.[] | .completedAt | select(. != null and (startswith("0001") | not))] | max // empty' <<<"$checks")
since=$(($(date -u +%s) - $(jq -n --arg t "$last" '$t | fromdateiso8601? // now' | cut -d. -f1)))
status=$(jq -r .mergeStateStatus <<<"$pr")
if [[ $status == BLOCKED ]] && ((since >= STALL_SECONDS)); then
	echo "Every required check reported has passed, but GitHub still blocks it: a required check has not reported. If main"
	echo "requires a check this branch's CI does not have yet, merge origin/main into the branch and push."
	exit 1
fi
if [[ $status == UNSTABLE || $status == HAS_HOOKS ]] && ((since >= STALL_SECONDS)); then
	echo "Every required check passed ${since}s ago and it has not merged: turning auto-merge off and on again."
	gh pr merge "$n" --disable-auto
	gh pr merge "$n" --auto --merge
	pr=$(view)
	[[ $(state) != MERGED ]] || { echo "Merged."; exit 0; }
fi
echo "Auto-merge is on and the required checks have passed ($status, ${since}s ago); GitHub merges it shortly. Run this again in a minute or two."
exit 3
