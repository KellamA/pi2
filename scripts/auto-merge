#!/bin/bash
# Turns on auto-merge for a pull request, and, run again, says where it stands and puts right what has gone wrong (#233).
#
#   scripts/auto-merge <number>
#
# Run it as soon as the pull request is open, instead of `gh pr merge <number> --auto --merge`, and again whenever you
# look at it, after pushing a fix or merging main into the branch too, until it says the pull request is merged:
#
# - every required check passed already (GitHub says the pull request is in clean status): merges it now, with a merge
#   commit, since gh refuses to turn auto-merge on for a pull request with nothing left to wait for (#553);
#
# - auto-merge off (never turned on, or turned off by GitHub): turns it on, with a merge commit;
# - auto-merge on, every required check passed and nothing merged three minutes after the last one finished: turns
#   auto-merge off and on again, which merges it. GitHub usually merges within a minute or two of the last check;
# - a conflict with main, or a required check that failed, was cancelled or timed out: names it at once with its link,
#   even while others still run, and says what to do; and whether a check was only cancelled because no runner took
#   it, which CI runs again by itself up to the run's fourth attempt (#637);
# - gh failing to read the checks: says so, with gh's error, and does not take it for checks not reported yet;
# - a pull request that touches a path `.github/CODEOWNERS` gives an owner (the relay, RemoteKit, the device lists, this
#   script and every workflow: docs/iphone.md 12.3, #668): refuses it before anything else, names the paths, says it
#   waits for the owner's review, and tries to turn auto-merge off. The owner reviews and merges it on GitHub.
#
# Which paths are the owner's is read from GitHub, not from this checkout: `.github/CODEOWNERS` as it is on main, which
# a pull request cannot change, and as it is at the pull request's newest commit, which can only add to it, each from
# git's own trees and blob at that commit. Main's copy missing, empty, with no rule, not a regular file or over GitHub's
# 3 MB limit refuses; so does a head commit this repository cannot read (a fork's). A line of either copy this script
# cannot read exactly as GitHub does refuses too, naming the line. The files are GitHub's list of what the pull request
# changes, as JSON, both names of a moved file; one that differs from an owned path only in letter case, or whose name
# is not plain ASCII, refuses. Anything that cannot be read (the list of files, or a list shorter than GitHub's count)
# refuses. Every merge and every turning on of auto-merge is bound to the commit checked (`--match-head-commit`), and the
# head is read again after the files are listed. This is a courtesy, not the guard: an agent can call gh itself, and
# whether GitHub keeps or drops auto-merge armed at one commit when another is pushed its documentation does not say.
# The guard is branch protection on main requiring the code owner's review (docs/relay.md).
#
# Exit status: 0 merged; 3 waiting for checks, with auto-merge on; 4 waits for the owner's review; 1 something needs
# you; 2 usage. Needs gh and jq.

set -euo pipefail

STALL_SECONDS=180
NO_RUNNER='was not acquired by Runner'
RERUN_ATTEMPTS=4 # scripts/rerun-if-no-runner's MAX_ATTEMPTS: a run at this attempt is not run again by itself

n=${1:-}
[[ $n =~ ^[0-9]+$ && $# == 1 ]] || { echo "usage: scripts/auto-merge <pull request number>" >&2; exit 2; }

view() { gh pr view "$n" --json state,mergeStateStatus,autoMergeRequest,url,headRefOid,changedFiles; }
pr=$(view)
state() { jq -r .state <<<"$pr"; }
echo "#$n $(jq -r .url <<<"$pr")"

case $(state) in
MERGED) echo "Merged."; exit 0 ;;
CLOSED) echo "Closed without merging."; exit 1 ;;
esac

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

# The revision checked, which every merge below is bound to (`--match-head-commit`): GitHub merges nothing else (#668).
head=$(jq -r .headRefOid <<<"$pr")
if ! [[ $head =~ ^[0-9a-f]{40}([0-9a-f]{24})?$ ]]; then
	echo "GitHub gave no commit for its head ($head), so what it would merge cannot be checked. Run this again in a minute."
	exit 1
fi

# Stops without merging anything, after saying why. Auto-merge is turned off whatever the first answer said of it, so
# that GitHub merges nothing meanwhile.
hold() {
	if gh pr merge "$n" --disable-auto >/dev/null 2>"$tmp/off"; then
		echo "Auto-merge is off, so that nothing merges it meanwhile."
	elif [[ $(jq -r .autoMergeRequest <<<"$pr") != null ]]; then
		echo "Auto-merge is on and could not be turned off ($(tr '\n' ' ' <"$tmp/off")): turn it off on GitHub."
	fi
	exit "$1"
}

# gh's error from the last call, on one line.
said() { tr '\n' ' ' <"$tmp/err"; }

# policy <ref> <name>: `.github/CODEOWNERS` at <ref>, read from git's own objects (trees, then the blob), into
# $tmp/<name>. Status 0 read; 4 not there, in a commit this repository has; 5 the commit is not one this repository
# can read (a fork's head, say); 6 there but not a file GitHub would read (not a regular file, or over its 3 MB limit,
# beyond which it does not load the file); 1 anything else. Why, in $tmp/why.
policy() {
	local ref=$1 name=$2 entry
	: >"$tmp/$name"
	if ! entry=$(gh api "repos/{owner}/{repo}/git/trees/$ref" --jq '[.tree[] | select(.path == ".github")] | first // empty' \
		2>"$tmp/err"); then
		echo "gh said: $(said)" >"$tmp/why"
		grep -qE 'HTTP (404|422)' "$tmp/err" && return 5
		return 1
	fi
	[[ -n $entry ]] || return 4
	if [[ $(jq -r .type <<<"$entry") != tree ]]; then echo ".github is not a folder" >"$tmp/why"; return 6; fi
	if ! entry=$(gh api "repos/{owner}/{repo}/git/trees/$(jq -r .sha <<<"$entry")" \
		--jq '[.tree[] | select(.path == "CODEOWNERS")] | first // empty' 2>"$tmp/err"); then
		echo "gh said: $(said)" >"$tmp/why"
		return 1
	fi
	[[ -n $entry ]] || return 4
	if ! [[ $(jq -r '.type + " " + .mode' <<<"$entry") =~ ^blob\ 1006[46]4$ ]]; then
		echo "it is not a regular file ($(jq -r '.type + " " + .mode' <<<"$entry"))" >"$tmp/why"
		return 6
	fi
	if (($(jq -r '.size // -1' <<<"$entry") > 3 * 1024 * 1024)) || (($(jq -r '.size // -1' <<<"$entry") < 0)); then
		echo "it is $(jq -r '.size // "of no given"' <<<"$entry") bytes, and GitHub does not load one over 3 MB" >"$tmp/why"
		return 6
	fi
	if ! gh api "repos/{owner}/{repo}/git/blobs/$(jq -r .sha <<<"$entry")" -H 'Accept: application/vnd.github.raw+json' \
		>"$tmp/$name" 2>"$tmp/err"; then
		echo "gh said: $(said)" >"$tmp/why"
		return 1
	fi
	return 0
}

# The owner's paths (#668), from two copies of CODEOWNERS. Main's, which a pull request cannot change, must be there and
# readable, with at least one rule: anything else is a refusal, not an absence. The head's can only add to it; plainly
# absent at a commit this repository has, it adds nothing.
for copy in main "$head"; do
	if [[ $copy == main ]]; then label="main's"; else label="this pull request's"; fi
	status=0
	policy "$copy" "${copy/$head/head}" || status=$?
	case $status/$copy in
	0/* | 4/"$head") ;;
	4/main)
		echo "main has no .github/CODEOWNERS, which says which paths wait for the owner's review. Without it nothing can be"
		echo "merged by an agent: the owner puts it back."
		hold 4 ;;
	5/main | 1/*)
		echo "Could not read $label .github/CODEOWNERS, which says which paths wait for the owner's review. $(cat "$tmp/why")"
		echo "It is not merged until that can be checked. Run this again in a minute."
		hold 1 ;;
	5/*)
		echo "Its newest commit, $head, cannot be read in this repository ($(cat "$tmp/why")), so its CODEOWNERS cannot be"
		echo "checked. It waits for the owner's review: they review it on GitHub and merge it."
		hold 4 ;;
	*)
		echo "$label .github/CODEOWNERS cannot be read as GitHub reads it: $(cat "$tmp/why"). It waits for the owner, who"
		echo "puts the file right."
		hold 4 ;;
	esac
done

# Every file the pull request changes, as GitHub's JSON gives it, one array a line: its name, and the name it had if it
# was moved (null if not). GitHub lists at most 3,000, 100 a page; a list shorter than its count of changed files
# cannot say which are the owner's.
if ! gh api "repos/{owner}/{repo}/pulls/$n/files?per_page=100" --paginate --jq '.[] | [.filename, .previous_filename]' \
	>"$tmp/files" 2>"$tmp/err"; then
	echo "Could not list the files it changes, to see whether any waits for the owner's review. gh said: $(said)"
	echo "It is not merged until that can be checked. Run this again in a minute."
	hold 1
fi
listed=$(jq -s length "$tmp/files") || { echo "GitHub's list of its files could not be read."; hold 1; }
changed=$(jq -r '.changedFiles // 0' <<<"$pr")
if ((listed < changed)); then
	echo "GitHub listed $listed of the $changed files it changes, so it cannot be told whether any waits for the owner's"
	echo "review. A pull request that large waits for the owner: they review it and merge it on GitHub."
	hold 4
fi
# The list is of the newest commit when it was asked for: it must still be the one checked.
pr=$(view)
if [[ $(jq -r .headRefOid <<<"$pr") != "$head" ]]; then
	echo "It changed while it was being checked ($head, now $(jq -r .headRefOid <<<"$pr")). Run this again."
	hold 3
fi

# What stops it, from both copies and the files, one JSON object a line: a line of either copy this script cannot read
# exactly as GitHub does, which refuses everything; or a file a line gives an owner, or one that differs from such a file
# only in letter case, or a name that is not plain ASCII, which cannot be compared as GitHub and a file system would.
#
# A line is read only if its pattern is plain: letters, digits, `.`, `_`, `-`, `/`, and `*` within a name or `**` as a
# whole one, no `.` or `..` name; and it names at least one owner (`@user`, `@org/team` or an e-mail address), with
# nothing after them but a comment. Escapes, `!`, `?`, `[ ]`, spaces in a name, other characters, and a line with no
# owner are refused, naming the line: a later line that took a file out, or matched more widely than this reading,
# could otherwise lift a refusal. Since every line read names an owner, a file is the owner's if any line matches it,
# whichever matches last. Patterns match as gitignore's do: anchored at the top by a leading `/` or a `/` inside it, a
# folder and everything in it, `*` within one name, `**` across folders. Where that could be wider than GitHub's
# reading (`docs/*`, which GitHub's documentation says covers no file deeper than docs/), it is wider, never narrower.
# shellcheck disable=SC2016 # jq's variables, not the shell's
findings=$(jq -cn --rawfile main "$tmp/main" --rawfile head "$tmp/head" --slurpfile files "$tmp/files" '
	def regex:
		(startswith("/")) as $root
		| (endswith("/")) as $folder
		| (sub("^/"; "") | sub("/$"; "")) as $core
		| ($root or ($core | test("/"))) as $anchored
		| ($core
			| gsub("\\."; "\\.")
			| gsub("\\*\\*"; "\u0001")
			| gsub("\\*"; "[^/]*")
			| gsub("/\u0001/"; "/(.*/)?")
			| gsub("^\u0001/"; "(.*/)?")
			| gsub("/\u0001$"; "/.*")
			| gsub("\u0001"; ".*")) as $body
		| (if $anchored then "^" else "^(.*/)?" end) + $body + (if $folder then "/.*$" else "(/.*)?$" end);
	def plain:
		test("^/?[A-Za-z0-9._*-]+(/[A-Za-z0-9._*-]+)*/?$")
		and (split("/") | map(select(. != "")) | all(. != "." and . != ".." and ((test("\\*\\*") | not) or . == "**")));
	def owner: test("^@[A-Za-z0-9][A-Za-z0-9-]*(/[A-Za-z0-9._-]+)?$") or test("^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]+$");
	def lines($copy):
		[split("\n") | to_entries[] | {copy: $copy, line: (.key + 1), text: (.value | sub("\r$"; ""))}
			| select(.text | test("^[ \t]*(#|$)") | not)
			| (.text | [splits("[ \t]+")] | map(select(. != ""))) as $words
			| (reduce $words[1:][] as $w ({stop: false, list: []};
				if .stop or ($w | startswith("#")) then .stop = true else .list += [$w] end) | .list) as $owners
			| . + {pattern: $words[0], owners: $owners,
				ok: (($words[0] | plain) and ($owners | length) > 0 and ($owners | all(owner))
					and (.text | test("^[ -~\t]*$")))}];
	(($main | lines("main'\''s")) + ($head | lines("this pull request'\''s"))) as $rules
	| ($rules | map(select(.ok)) | map(. + {re: (.pattern | regex), fold: (.pattern | ascii_downcase | regex)})) as $read
	| ($rules[] | select(.ok | not) | {kind: "line", copy, line, text}),
	(if ($main | lines("main") | length) == 0 then {kind: "empty"} else empty end),
	([$files[] | .[] | select(type == "string")] | unique[]) as $file
	| (if ($file | test("^[ -~]*$") | not) then {kind: "name", file: $file} else empty end),
	(first($read[] | select(.re as $r | $file | test($r))) | {kind: "owned", file: $file, copy, pattern}) //
	(first($read[] | select(.fold as $r | $file | ascii_downcase | test($r)))
		| {kind: "case", file: $file, copy, pattern}) // empty
') || { echo "Could not read .github/CODEOWNERS's patterns: refusing until it can be."; hold 1; }
if jq -e 'select(.kind == "line")' <<<"$findings" >/dev/null 2>&1 || jq -e 'select(.kind == "empty")' <<<"$findings" >/dev/null 2>&1; then
	echo ".github/CODEOWNERS has lines this script cannot read exactly as GitHub does, so it cannot tell which paths are"
	echo "the owner's:"
	jq -r 'select(.kind == "line") | "- \(.copy) CODEOWNERS, line \(.line): \(.text)"' <<<"$findings"
	jq -r 'select(.kind == "empty") | "- main'\''s CODEOWNERS has no rule in it."' <<<"$findings"
	echo "It waits for the owner, who puts the file right or reviews this pull request and merges it on GitHub."
	hold 4
fi
if [[ -n $findings ]]; then
	echo "It touches paths that wait for the owner's review, as .github/CODEOWNERS gives them (docs/iphone.md 12.3):"
	jq -r 'select(.kind == "owned") | "- \(.file) (\(.pattern), in \(.copy) CODEOWNERS)"' <<<"$findings"
	jq -r 'select(.kind == "case") | "- \(.file): differs only in letter case from \(.pattern), in \(.copy) CODEOWNERS"' <<<"$findings"
	jq -r 'select(.kind == "name") | "- \(.file): not a plain ASCII name, which cannot be compared with CODEOWNERS"' <<<"$findings"
	echo "No agent merges it: the owner reviews it on GitHub and merges it. Leave it open, and mark its issue waiting on"
	echo "the owner's review."
	hold 4
fi

# A pull request whose required checks all passed is in clean status, and gh answers `pr merge --auto` for one with
# "Pull request is in clean status" and fails: there is nothing left to wait for, so merge it now instead (#553).
if [[ $(jq -r .mergeStateStatus <<<"$pr") == CLEAN ]]; then
	echo "Every required check has passed and nothing is left to wait for: merging it now."
	gh pr merge "$n" --merge --match-head-commit "$head" || {
		echo "GitHub did not merge it at $head, the commit checked. If it has changed since, run this again."
		exit 1
	}
	pr=$(view)
	[[ $(state) != MERGED ]] || { echo "Merged."; exit 0; }
	echo "GitHub has not merged it yet ($(jq -r .mergeStateStatus <<<"$pr")): run this again in a minute."
	exit 3
fi

if [[ $(jq -r .autoMergeRequest <<<"$pr") == null ]]; then
	echo "Auto-merge is off: turning it on, at $head, the commit checked."
	gh pr merge "$n" --auto --merge --match-head-commit "$head" || {
		echo "GitHub did not turn auto-merge on at $head. If it has changed since, run this again."
		exit 1
	}
	pr=$(view)
	[[ $(state) != MERGED ]] || { echo "Merged."; exit 0; }
fi

if [[ $(jq -r .mergeStateStatus <<<"$pr") == DIRTY ]]; then
	echo "It conflicts with main. Merge origin/main into the branch, keeping both sides' work, check it, push, and run this again."
	exit 1
fi

# The required checks of the newest commit. gh leaves out one not reported yet, and answers none reported at all with an
# error saying so, which is waited for. Any other error says nothing about the checks: it is not taken for that (#637).
err=$tmp/err
if ! checks=$(gh pr checks "$n" --required --json name,state,bucket,completedAt,link 2>"$err"); then
	if grep -qE 'no (required )?checks reported' "$err"; then
		echo "Auto-merge is on; no required check has reported yet."
		exit 3
	fi
	echo "Could not read the required checks. gh said: $(tr '\n' ' ' <"$err")"
	echo "This says nothing about the checks themselves. Run this again in a minute."
	exit 1
fi
if [[ $(jq length <<<"$checks") == 0 ]]; then
	echo "Auto-merge is on; no required check has reported yet."
	exit 3
fi

# A required check that finished badly is named at once with its link, whatever else is still running (#637). gh's
# bucket `fail` is a failure, a time-out, an error or an action required; `cancel` is a cancelled one.
failed=0
unacquired=0
while IFS=$'\t' read -r name state bucket link; do
	[[ -n $name ]] || continue
	run=
	job=
	if [[ $link =~ /actions/runs/([0-9]+)/job/([0-9]+) ]]; then
		run=${BASH_REMATCH[1]}
		job=${BASH_REMATCH[2]}
	fi
	if [[ $bucket == cancel && -n $job ]]; then
		notes=$(gh api "repos/{owner}/{repo}/check-runs/$job/annotations" --jq '.[].message' 2>/dev/null) || notes=
		if [[ $notes == *"$NO_RUNNER"* ]]; then
			attempt=$(gh api "repos/{owner}/{repo}/actions/runs/$run" --jq .run_attempt 2>/dev/null) || attempt=0
			[[ $attempt =~ ^[0-9]+$ ]] || attempt=0
			if ((attempt < RERUN_ATTEMPTS)); then
				echo "- $name: cancelled, no runner took it. $link"
				echo "  CI runs it again by itself; if it has not started again in a few minutes: gh run rerun $run --failed"
				unacquired=$((unacquired + 1))
				continue
			fi
			echo "- $name: cancelled, no runner took it at attempt $attempt, which CI does not run again by itself. $link"
			echo "  Run it again: gh run rerun $run --failed"
			failed=$((failed + 1))
			continue
		fi
	fi
	case $bucket/$state in
	cancel/*) echo "- $name: cancelled. $link" ;;
	*/TIMED_OUT) echo "- $name: timed out. $link" ;;
	*/FAILURE) echo "- $name: failed. $link" ;;
	*) echo "- $name: failed ($state). $link" ;;
	esac
	if [[ -z $run ]]; then
		echo "  Read what it says there, fix it and push."
	elif [[ $bucket == cancel ]]; then
		echo "  Run it again (gh run rerun $run --failed), or push a fix if it was cancelled for a reason of the change's."
	else
		echo "  Read the log (gh run view $run --log-failed), fix it and push; if it fails for a reason not the change's (it"
		echo "  passes on main), run it again: gh run rerun $run --failed"
	fi
	failed=$((failed + 1))
done < <(jq -r '.[] | select(.bucket == "fail" or .bucket == "cancel") | [.name, .state, .bucket, .link] | @tsv' <<<"$checks")

waiting=$(jq -r '[.[] | select(.bucket == "pending") | .name] | join(", ")' <<<"$checks")
if ((failed > 0)); then
	[[ -z $waiting ]] || echo "Still running: $waiting."
	echo "Auto-merge stays on through a fix: run this again after you push, or after it runs again."
	exit 1
fi
((unacquired == 0)) || exit 3
if [[ -n $waiting ]]; then
	echo "Auto-merge is on, waiting for: $waiting."
	exit 3
fi

last=$(jq -r '[.[] | .completedAt | select(. != null and (startswith("0001") | not))] | max // empty' <<<"$checks")
since=$(($(date -u +%s) - $(jq -n --arg t "$last" '$t | fromdateiso8601? // now' | cut -d. -f1)))
status=$(jq -r .mergeStateStatus <<<"$pr")
if [[ $status == BLOCKED ]] && ((since >= STALL_SECONDS)); then
	echo "Every required check reported has passed, but GitHub still blocks it: a required check has not reported. If main"
	echo "requires a check this branch's CI does not have yet, merge origin/main into the branch and push."
	exit 1
fi
if [[ $status == UNSTABLE || $status == HAS_HOOKS ]] && ((since >= STALL_SECONDS)); then
	echo "Every required check passed ${since}s ago and it has not merged: turning auto-merge off and on again."
	gh pr merge "$n" --disable-auto
	gh pr merge "$n" --auto --merge --match-head-commit "$head"
	pr=$(view)
	[[ $(state) != MERGED ]] || { echo "Merged."; exit 0; }
fi
echo "Auto-merge is on and the required checks have passed ($status, ${since}s ago); GitHub merges it shortly. Run this again in a minute or two."
exit 3
