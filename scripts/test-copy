#!/bin/bash
# Starts, captures, calls and stops a throwaway copy of this checkout's development build, so a change can be seen in
# the app on a Mac where pi² is in real use without touching the installed copy (CONTRIBUTING.md, "Testing safely").
#
# A copy is named by a suffix of your own, such as test-181. The suffix gives it everything of its own: the bundle id
# dev.pi2.app.<suffix> (preferences, permissions, Launch Services), the data folder
# ~/Library/Application Support/pi2-<suffix> and the Keychain service dev.pi2.credentials.<suffix>. The copy, its
# state file and anything else this script keeps for it are in app/build/test-copies/<suffix> in this checkout; that
# folder existing is what makes a copy this checkout's own, and "stop" removes only what it names.
#
# The rules this keeps, so they do not depend on care:
# - It never builds, and only copies a development build (one that runs its engine from this checkout). A release
#   build would run on the usual data folder.
# - Every path, bundle id and Keychain service is worked out from the suffix, which is checked first; none can be the
#   usual ones. Nothing is removed by a pattern, and nothing outside the copy's own paths is removed at all.
# - The copy is launched with a clean environment and its data folder and Keychain service named explicitly, so the
#   PI2_HOME an agent's shell inherits from the installed pi² (the usual data folder) never reaches it.
# - It stops only the processes it recorded, by pid, after checking that each pid is still the process it recorded
#   (same start time, same executable), and any process running from the copy's own bundle. Never pkill or killall.
#   An engine it did not record is followed only when it is the recorded app's own child, named in the copy's data
#   folder; anything else running there makes "stop" remove nothing.
# - "shot" checks that screen capture is already allowed and refuses otherwise: capturing without it puts a
#   permission prompt on the person's screen.
#
# Clicking in a copy is computer use's, not this script's: an agent whose computer use has "Test copies of pi²" on may
# work a copy whose suffix begins with test (bundle id dev.pi2.app.test-…), which pi² checks is a copy made here of a
# development build (docs/computer-use.md). The commands here use only the copy's own test hooks and engine.
#
# Two copies with different suffixes, from one checkout or several, are independent. A second "start" with a suffix
# already in use (from this checkout or any other) is refused before it changes anything: the copy's folder here and
# its data folder are each made with mkdir, which only one caller can win.

set -euo pipefail

usage() {
	cat <<'EOF'
Usage: scripts/test-copy <command> [arguments]

  start <suffix> [--show <what>] [--hub <fold>] [--menu <label>] [--appearance light|dark] [--welcome]
                 [--no-app-nap] [--env NAME=VALUE] [--fill <entries> | --fill project[:<name|count>]] [--remote]
                                   Copy app/build/pi² dev.app as dev.pi2.app.<suffix>, sign it and launch it on a
                                   data folder of its own, behind other windows, parked in a corner, without taking
                                   the focus. <what> is what the window opens on (PI2_SHOW, docs/development.md),
                                   such as palette:<query> for the command palette. --menu prints the items of the
                                   context menu of the element with that label, such as a conversation's title
                                   (PI2_MENU). The first-run welcome is marked done in the copy's data folder, so it
                                   does not cover the window; --welcome keeps it. --appearance light or dark pictures
                                   this copy in that appearance whatever the Mac's own is, without changing the Mac's
                                   setting. --no-app-nap disables App Nap
                                   for this copy only, for speed measurements. Prints the data folder and process
                                   ids. --env may repeat, for these test variables only:
                                   PI2_DEMO_PICTURES, PI2_DEMO_TEXT_MODEL, PI2_DEMO_COST, PI2_DEMO_TOKENS_PER_SECOND,
                                   PI2_DEMO_COMPACTION_GATE, PI2_GH, and the paired devices' stand-ins
                                   PI2_REMOTE_STAND_IN, PI2_APP_ATTEST_STAND_IN and PI2_APP_ATTEST_TEAM. Values are
                                   explicit (never inherited), kept for reopen, and not secrets. --fill may repeat:
                                   before the app's first start, the copy's engine runs alone and makes what fill
                                   makes (a conversation of that many entries, or a demo project), then stops, so the
                                   first start finds it there. --remote turns on remote access for a phone in the
                                   simulator (pair): the copy's own development pi² Remote, on 127.0.0.1 alone, with
                                   no Bonjour and no Keychain, its keys and devices in the copy's data folder.
  pair <suffix> [--sim <name>] [--show <route>] [--env NAME=VALUE]
                                   Pair the debug build in a simulator of your own (scripts/iphone-sim create; pi2-N
                                   for a copy test-N unless --sim names another) with a copy started with --remote, with
                                   no hand on either: a pairing opened on the copy's engine, the code given to a fresh
                                   install of the app (PI2_PAIR), the six digits it shows read from its log and typed on
                                   the Mac, then Face ID answered with a matching face until the phone is attached.
                                   --show is the phone's route once attached (PI2_SHOW, docs/iphone-app.md), and
                                   --env, which may repeat, the app's other launch values, such as PI2_HUB_ACT.
  attach <suffix> [--sim <name>] [--show <route>] [--env NAME=VALUE]
                                   Launch the paired simulator's app again (PI2_TRANSPORT=remote, --show's route and
                                   --env's values), and answer its Face ID until it is attached to the copy again.
                                   An attach whose session has already ended (a launch value that locks or unpairs)
                                   counts, and is said so.
  remote-off <suffix>              Turn remote access off in a copy started with --remote, as Settings › Devices does:
                                   its pi² Remote stops, and a paired phone is out of reach.
  remote-on <suffix>               Turn it on again, as start --remote left it. pi² Remote starts on a new port, so the
                                   port the paired phone knows is forwarded to it, on 127.0.0.1, until remote-off, pair
                                   or stop; then Face ID is answered until the phone has come back, with no pairing.
  reopen <suffix> [--show <what>] [--hub <fold>] [--appearance light|dark]
                                   Replace and launch the app from the latest development build in this checkout.
                                   Keep its engine, data, environment and previous --show, --hub and --appearance unless
                                   replaced, and the pi² Remote its engine started (--remote).
  show <suffix> <what>             Show what PI2_SHOW opens on while the copy runs: activity, usage, archive,
                                   agent:<id>[#<section>] (a template's page), chat[:<number or title>],
                                   palette[:<query>], settings[:<tab>[#<section>]], output:<id>, a conversation's
                                   number or title (where it lives), or project:<name-or-id>[#<tab-or-agent>]. A
                                   #<section> scrolls the page there as at launch; one the page lacks is refused. It
                                   answers once a conversation's page or a hub has drawn it, and for any other page it
                                   says that it cannot wait for it to draw.
  show <suffix> dashboard          Select the Dashboard's row in the sidebar of projects, and answer once it has
                                   drawn its columns, saying how many.
                                   --hub sets PI2_HUB at launch, or the fold for a live request:
                                   both, conversation-folded or board-folded.
  conversations <suffix>          List the copy's Library and Archive as tab-separated id, title and agent id.
  size <suffix> <width> <height>   Set the main window's frame in points, including its title bar.
  size <suffix> smallest           Resize the main window to its smallest size.
  sidebar <suffix> <points> | narrowest
                                   Set the sidebar column's width in points, kept between its narrowest (210) and
                                   widest (340), as dragging its divider does. reopen puts it back at 250.
  can-click <suffix>              Say whether computer use can read and click this copy's window now. Yes (exit 0):
                                   the copy raised its parked window and gives it to accessibility where the tool
                                   looks. No (exit 1), with its cause: the pi² app not running (only the person can
                                   reopen it), no window in the window server after 30 seconds, a window the copy
                                   does not give to accessibility, or one the window server and accessibility
                                   disagree on, which the tool turns down: at another size, not at all, or elsewhere
                                   at that size for a window that is not the app's main window or shares its size
                                   with another of the copy's windows. Cannot tell from here (exit 2): the copy did not
                                   say, or its build predates the request (rebuild and reopen it). pi²'s own
                                   Accessibility permission can never be told from here. Run this before planning
                                   checks that need clicks.
  answer <suffix> <conversation> allow|deny
                                   Answer one waiting approval (allow once); refuses if more than one is waiting.
  answer <suffix> <need-id> '<json answer>'
                                   Answer a Needs you item by id with its NeedAnswer object (docs/projects.md).
  choose <suffix> <path>... | cancel
                                   Answer the running copy's next Open or Save panel without showing it.
                                   Paths go in its data folder, the launcher's scratch folder or app/build.
  fill <suffix> <entries>          Make a demo conversation with synthetic history and long command outputs.
  fill <suffix> --project          Make a demo project. Prints its id and its conversation ids.
  fill <suffix> --project <name|count>
                                   Make one demo project with that name, or that many (up to 8) for the Dashboard.
  last-copy <suffix>               Print the last Copy action recorded in this copy's data folder as JSON.
  shot <suffix> <file.png> [--window <title> | --menu]
                                   Wait for and capture the copy's largest window (or the one with that title) into a file
                                   inside this checkout, with any sheet or alert over it drawn where it sits. --menu
                                   captures the copy's open menu instead (open it with the computer tool first). Refuses
                                   if screen capture is not already allowed.
  call <suffix> <method> [<json params>]
                                   Send one request to the copy's own engine socket and print its JSON response.
                                   Params default to {}. An engine error exits non-zero; this does not wait for a run.
  socket <suffix>                  Print the path of the copy's own engine socket, after the checks call makes, for a
                                   program that keeps a connection open, such as scripts/load.mts.
  send <suffix> <conversation> <text> [--timeout <seconds>]
                                   Submit and wait for this message\'s run to finish (default 600 seconds, at most 600).
                                   JSON status: done (exit 0), failed/error (1), waiting on the person (2), timeout
                                   (124). Never answers approvals or stops work when its wait ends.
  answer-of <suffix> <conversation> <submission> [--timeout <seconds>]
                                   Read the answer of a submission that was still running when send\'s wait ended, with
                                   the same JSON, statuses, exit codes and limit. Submits nothing, answers nothing and
                                   stops nothing.
  stop <suffix>                    Stop the copy's app, then its engine and its pi² Remote, by their pids, and remove the
                                   copy, its data folder, preferences, Keychain items, Launch Services registration
                                   and the files its browser leaves.
  status [<suffix>]                What is recorded for a copy and whether it runs; without a suffix, every copy this
                                   checkout started.

A suffix is lower-case letters, digits and hyphens, such as test- and your issue number: test-181.

An agent whose computer use has "Test copies of pi²" on may click, type and choose menu commands in a copy whose
suffix begins with test, by its bundle id (dev.pi2.app.test-181). The commands above don't require computer use.
EOF
}

die() { echo "test-copy: $*" >&2; exit 1; }

# The path $1 names with every symbolic link in it followed, so that two spellings of one place compare equal (macOS
# keeps /tmp at /private/tmp, where a conversation's scratch folder is; #880) and a link cannot pass for somewhere
# else. What does not exist yet is kept as given, below the deepest part of it that does.
resolved() {
	local p=$1 rest="" link links=0 dir
	[[ $p == /* ]] || p="$PWD/$p"
	while :; do
		if [[ -L $p ]] && ((links++ < 64)); then
			link=$(readlink -- "$p")
			[[ $link == /* ]] || link="$(dirname -- "$p")/$link"
			p=$link
		elif [[ -d $p && ! -L $p ]] && dir=$(cd -P -- "$p" 2>/dev/null && pwd -P); then
			[[ $dir == / && -n $rest ]] && dir=""
			printf '%s' "$dir$rest"
			return 0
		else
			# Not a folder, or not there: resolve its folder and keep its name.
			rest="/$(basename -- "$p")$rest"
			p=$(dirname -- "$p")
		fi
	done
}

ROOT=$(cd "$(dirname "$0")/.." && pwd -P)
SOURCE="$ROOT/app/build/pi² dev.app"
RELEASE="$ROOT/app/build/pi².app"
COPIES="$ROOT/app/build/test-copies"
SUPPORT="$HOME/Library/Application Support"
USUAL_ID=dev.pi2.app
USUAL_HOME="$SUPPORT/pi2"
USUAL_SERVICE=dev.pi2.credentials
LSREGISTER=/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister
PLIST=/usr/libexec/PlistBuddy
# Generous limits: under the load of several agents' builds and tests an engine can take well over ten seconds to
# start. They are there so that a hang fails instead of waiting for ever.
START_LIMIT=180
STOP_LIMIT=30
SHOT_LIMIT=30
MENU_LIMIT=5

# Sets the names of everything that belongs to the copy with this suffix, after checking the suffix.
names() {
	local s=${1-}
	[[ -n $s ]] || die "a suffix is required, such as test-181 (your issue number)"
	[[ $s =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?$ ]] ||
		die "'$s' is not a suffix: use lower-case letters, digits and hyphens, such as test-181"
	# The engine's socket is in the data folder, and a socket's path is limited to 104 bytes.
	((${#s} <= 32)) || die "'$s' is too long: keep a suffix to 32 characters"
	[[ $s != dev ]] || die "'dev' is the suffix every development build has as built; choose one of your own, such as test-181"
	SUFFIX=$s
	ID="$USUAL_ID.$s"
	NAME="pi² $s"
	DIR="$COPIES/$s"
	APP="$DIR/$NAME.app"
	STATE="$DIR/state"
	DATA="$SUPPORT/pi2-$s"
	SERVICE="$USUAL_SERVICE.$s"
	PREFS="$HOME/Library/Preferences/$ID.plist"
	# What the copy's web views (its browser, the conversation page) and macOS leave under its bundle id. Named one by
	# one: a pattern across ~/Library would read folders macOS protects, and that can put a privacy prompt on screen.
	LEFT_BY_ID=(
		"$HOME/Library/WebKit/$ID"
		"$HOME/Library/Caches/$ID"
		"$HOME/Library/HTTPStorages/$ID"
		"$HOME/Library/HTTPStorages/$ID.binarycookies"
		"$HOME/Library/Saved Application State/$ID.savedState"
	)
	# Checked again, in another way, in case the rules above are ever loosened.
	local lower_id lower_data
	lower_id=$(tr '[:upper:]' '[:lower:]' <<<"$ID")
	lower_data=$(tr '[:upper:]' '[:lower:]' <<<"$DATA")
	[[ $lower_id != "$USUAL_ID" && $lower_id != "$USUAL_ID.dev" ]] || die "refusing the bundle id $ID"
	[[ $lower_data != "$(tr '[:upper:]' '[:lower:]' <<<"$USUAL_HOME")" ]] || die "refusing the data folder $DATA"
	# And where it leads: a symbolic link must not make the usual data folder, or one inside it, or the development
	# build's as built (pi2-dev), the copy's. Compared in lower case, as the disk ignores case.
	local real usual
	real=$(resolved "$DATA" | tr '[:upper:]' '[:lower:]')
	for usual in "$USUAL_HOME" "$USUAL_HOME-dev"; do
		usual=$(resolved "$usual" | tr '[:upper:]' '[:lower:]')
		[[ $real != "$usual" && $real != "$usual/"* ]] ||
			die "refusing the data folder $(tidy "$DATA"): it leads to $(tidy "$(resolved "$DATA")"), which is not the copy's own"
	done
	[[ $SERVICE != "$USUAL_SERVICE" && $SERVICE == "$USUAL_SERVICE".?* ]] || die "refusing the Keychain service $SERVICE"
}

# Removes one of the copy's own paths. Anything else is refused, so a mistake here cannot reach further.
remove() {
	local p=$1 ok=0 q
	for q in "$DIR" "$DATA" "$PREFS" "${LEFT_BY_ID[@]}"; do [[ $p == "$q" ]] && ok=1; done
	((ok)) || die "refusing to remove $p: it is not one of the copy's own paths"
	[[ -e $p || -L $p ]] || return 0
	rm -rf -- "$p"
	echo "  removed $(tidy "$p")"
}

tidy() { local s=$1 t='~'; printf '%s' "${s/#"$HOME"/$t}"; }

# A process's start time and executable, which together tell it apart from a later process given the same pid.
# Empty when there is no such process. In UTF-8, or ps writes the ² as an escape sequence.
started_at() { LC_ALL=en_US.UTF-8 ps -o lstart= -p "$1" 2>/dev/null || true; }
executable() { LC_ALL=en_US.UTF-8 ps -o comm= -p "$1" 2>/dev/null || true; }
parent_of() { ps -o ppid= -p "$1" 2>/dev/null | tr -d ' ' || true; }

# Whether pid $1 is still the process recorded as started at $2 from executable $3.
is_recorded() { [[ -n $1 && -n $2 && $(started_at "$1") == "$2" && $(executable "$1") == "$3" ]]; }

# The pids of processes whose executable is inside the copy's bundle.
from_bundle() {
	local pid exe
	LC_ALL=en_US.UTF-8 ps -axww -o pid=,comm= | while read -r pid exe; do
		[[ $exe == "$APP/"* ]] && echo "$pid"
	done
	return 0
}

APP_PID="" APP_START="" APP_EXE="" ENGINE_PID="" ENGINE_START="" ENGINE_EXE="" SHOW="" HUB="" WELCOME=0 MENU=""
APPEARANCE=""
# start --remote (#681): remote access for a phone in the simulator, and which simulator and device pair paired.
REMOTE=0 PHONE_SIM="" PHONE_DEVICE=""
# The address the paired phone knows the copy by, its pairing code's (pair), and the forwarder remote-on starts from it to
# pi² Remote's port of the moment (#951), recorded as the app and engine are.
PHONE_ADDRESS="" FORWARD_PID="" FORWARD_START="" FORWARD_EXE=""
# What a copy started with --remote gives its engine, beside its own folders: with PI2_TEST_COPY, it takes a pairing
# claim with no App Attest attestation, which a simulator cannot make (devices.ts, docs/iphone.md 10). A development
# engine alone honours it (testswitches.ts).
REMOTE_ENV=PI2_PAIR_UNATTESTED=1
# The relay address the copy's engine is given: the engine opens no pairing without one (devices.ts, pairStart), and no
# relay runs. An address on loopback where nothing of pi² listens. It is not a port nobody can use: only root can bind
# 127.0.0.1:9 itself, but on macOS any process may bind *:9, which takes connections to 127.0.0.1:9. So remote_on turns
# the relay switch off: pi² Remote has a relay client now (#678), and with the switch on it would register there at the
# first pairing. With it off, pi² Remote makes the pairing's id itself and dials no relay (RelayEnd.register), and the
# phone pairs and attaches over the home path; the address is only what the pairing's code names.
REMOTE_RELAY=ws://127.0.0.1:9/v1
TEST_ENV=()
# Only explicit demo switches may cross the clean launch boundary. Never accept an open-ended PI2_* prefix:
# PI2_HOME and the Keychain service are owned by this script, and future switches may weaken isolation.
add_test_env() {
	local pair=$1 key old
	[[ $pair == *=* ]] || die "--env needs NAME=VALUE"
	[[ $pair != *$'\n'* && $pair != *$'\r'* ]] || die "--env takes one line"
	key=${pair%%=*}
	case $key in
		PI2_DEMO_PICTURES|PI2_DEMO_TEXT_MODEL|PI2_DEMO_COST|PI2_DEMO_TOKENS_PER_SECOND|PI2_DEMO_COMPACTION_GATE|PI2_GH) ;;
		# The paired devices' stand-ins (#679): honoured by a development engine alone, which every copy's is.
		PI2_REMOTE_STAND_IN|PI2_APP_ATTEST_STAND_IN|PI2_APP_ATTEST_TEAM) ;;
		*) die "--env does not allow $key; only PI2_DEMO_PICTURES, PI2_DEMO_TEXT_MODEL, PI2_DEMO_COST, PI2_DEMO_TOKENS_PER_SECOND, PI2_DEMO_COMPACTION_GATE, PI2_GH, PI2_REMOTE_STAND_IN, PI2_APP_ATTEST_STAND_IN and PI2_APP_ATTEST_TEAM" ;;
	esac
	for old in ${TEST_ENV[@]+"${TEST_ENV[@]}"}; do
		[[ ${old%%=*} != "$key" ]] || die "--env repeats $key; give each variable once"
	done
	TEST_ENV+=("$pair")
}
check_hub() {
	case $1 in
		both|conversation-folded|board-folded) ;;
		*) die "--hub needs both, conversation-folded or board-folded" ;;
	esac
}
check_appearance() {
	case $1 in
		light|dark) ;;
		*) die "--appearance needs light or dark" ;;
	esac
}

# What start --fill makes before the copy's first start: <entries>, a demo conversation of that many entries (as fill
# <suffix> <entries>), or project[:<name or count>], a demo project (as fill <suffix> --project [<name or count>]).
FILLS=()
check_fill() {
	local fill=$1
	[[ $fill != *$'\n'* && $fill != *$'\r'* ]] || die "--fill takes one line"
	if [[ $fill =~ ^[1-9][0-9]*$ ]]; then
		((${#fill} <= 5 && fill <= 10000)) || die "--fill makes at most 10000 entries"
	elif [[ $fill != project && $fill != project:?* ]]; then
		die "--fill needs a number of entries, or project, project:<name> or project:<count>, such as --fill 600 or --fill project"
	elif [[ ${fill#project:} =~ ^[0-9]+$ ]] && ! [[ ${fill#project:} =~ ^[1-8]$ ]]; then
		die "--fill project:<count> makes 1 to 8 demo projects"
	fi
}

# Seeds the copy's data folder before its first start (start --fill, #779): runs the copy's own engine by itself, as the
# app would start it (the same clean environment, the same Node, the checkout's engine), fills it through its socket as
# fill does, and stops it cleanly, so that the app's first start finds the data already there, as after restoring a
# backup or an update. The engine is recorded while it runs, so a failure stops it with the rest. What it says goes to
# seed-engine.log in the copy's folder, not to engine.log, where start waits for the app's own engine to listen.
seed_node() {
	local node
	node=$("$PLIST" -c 'Print :PI2NodePath' "$1/Contents/Info.plist" 2>/dev/null || true)
	[[ -n $node && -x $node ]] ||
		die "the development build does not say which Node runs its engine (PI2NodePath), so --fill cannot start it before the app; build it again with ./app/build.sh"
	echo "$node"
}
seed_before_start() {
	local node pid fill waited=0 seedlog="$DIR/seed-engine.log" pair
	node=$(seed_node "$APP")
	local vars=(HOME="$HOME" USER="${USER-}" LOGNAME="${LOGNAME-}" TMPDIR="${TMPDIR:-/tmp/}" LANG=en_US.UTF-8
		PATH=/usr/bin:/bin:/usr/sbin:/sbin PI2_HOME="$DATA" PI2_KEYCHAIN_SERVICE="$SERVICE" PI2_TEST_COPY="$SUFFIX"
		PI2_APP_BUNDLE="$APP")
	for pair in ${TEST_ENV[@]+"${TEST_ENV[@]}"}; do vars+=("$pair"); done
	((REMOTE == 0)) || vars+=("$REMOTE_ENV")
	echo "Seeding $(tidy "$DATA") before the copy's first start:"
	env -i "${vars[@]}" "$node" "$ROOT/engine/src/main.ts" >>"$seedlog" 2>&1 </dev/null &
	pid=$!
	ENGINE_PID=$pid ENGINE_START=$(started_at "$pid") ENGINE_EXE=$(executable "$pid")
	save_state
	until [[ $(tr -d '[:space:]' 2>/dev/null <"$DATA/engine.pid" || true) == "$pid" ]] &&
		grep -qF "listening on $DATA/engine.sock" "$seedlog" 2>/dev/null; do
		is_recorded "$ENGINE_PID" "$ENGINE_START" "$ENGINE_EXE" ||
			die "the copy's engine stopped as it started, before the copy's first start; it said: $(tail -n 5 "$seedlog" 2>/dev/null)"
		((waited < START_LIMIT * 2)) || die "the copy's engine was not listening within $START_LIMIT seconds"
		sleep 0.5
		waited=$((waited + 1))
	done
	for fill in "${FILLS[@]}"; do
		case $fill in
			project) set -- --project ;;
			project:*) set -- --project "${fill#project:}" ;;
			*) set -- "$fill" ;;
		esac
		TEST_COPY_KEY_FILE="$DIR/answer-key" node "$ROOT/scripts/test-copy-drive.mjs" fill "$DATA/engine.sock" "$SUFFIX" "$@" ||
			die "could not fill the copy with $fill before its first start"
	done
	# A clean stop, as quitting the app would make: work going on is left for the next engine, as after a restart.
	stop_process "engine that seeded the data folder" "$ENGINE_PID" "$ENGINE_START" "$ENGINE_EXE"
	wait "$pid" 2>/dev/null || true
	! is_recorded "$ENGINE_PID" "$ENGINE_START" "$ENGINE_EXE" || die "the engine that seeded the data folder did not stop"
	ENGINE_PID="" ENGINE_START="" ENGINE_EXE=""
	save_state
}

# Where a copy started with --menu writes the context menu (ContextMenuPreview.fileName in the app).
MENU_FILE=context-menu.txt

load_state() {
	[[ -f $STATE ]] || return 1
	local key value
	TEST_ENV=()
	while IFS='=' read -r key value; do
		case $key in
			app_pid) APP_PID=$value ;;
			app_start) APP_START=$value ;;
			app_exe) APP_EXE=$value ;;
			engine_pid) ENGINE_PID=$value ;;
			engine_start) ENGINE_START=$value ;;
			engine_exe) ENGINE_EXE=$value ;;
			show) SHOW=$value ;;
			hub) [[ -z $value ]] || check_hub "$value"; HUB=$value ;;
			menu) MENU=$value ;;
			appearance) [[ -z $value ]] || { check_appearance "$value"; APPEARANCE=$value; } ;;
			remote) [[ $value == 1 ]] && REMOTE=1 ;;
			phone_sim) PHONE_SIM=$value ;;
			phone_device) PHONE_DEVICE=$value ;;
			phone_address) PHONE_ADDRESS=$value ;;
			forward_pid) FORWARD_PID=$value ;;
			forward_start) FORWARD_START=$value ;;
			forward_exe) FORWARD_EXE=$value ;;
			test_env) add_test_env "$value" ;;
		esac
	done <"$STATE"
	[[ -z $APP_PID || $APP_PID =~ ^[0-9]+$ ]] || die "$STATE is damaged: app_pid is '$APP_PID'"
	[[ -z $ENGINE_PID || $ENGINE_PID =~ ^[0-9]+$ ]] || die "$STATE is damaged: engine_pid is '$ENGINE_PID'"
	[[ -z $FORWARD_PID || $FORWARD_PID =~ ^[0-9]+$ ]] || die "$STATE is damaged: forward_pid is '$FORWARD_PID'"
	[[ -z $PHONE_ADDRESS || $PHONE_ADDRESS =~ ^127\.0\.0\.1:[0-9]+$ ]] || die "$STATE is damaged: phone_address is '$PHONE_ADDRESS'"
}

save_state() {
	printf '%s\n' "suffix=$SUFFIX" "show=$SHOW" "hub=$HUB" "menu=$MENU" "appearance=$APPEARANCE" \
		"app_pid=$APP_PID" "app_start=$APP_START" "app_exe=$APP_EXE" \
		"engine_pid=$ENGINE_PID" "engine_start=$ENGINE_START" "engine_exe=$ENGINE_EXE" \
		"remote=$REMOTE" "phone_sim=$PHONE_SIM" "phone_device=$PHONE_DEVICE" "phone_address=$PHONE_ADDRESS" \
		"forward_pid=$FORWARD_PID" "forward_start=$FORWARD_START" "forward_exe=$FORWARD_EXE" >"$STATE.new"
	local pair
	for pair in ${TEST_ENV[@]+"${TEST_ENV[@]}"}; do printf '%s\n' "test_env=$pair" >>"$STATE.new"; done
	mv "$STATE.new" "$STATE"
}

# The app starts a new engine when its engine goes (Debug › Kill Engine, a crash). The new one is the copy's too when
# it is the recorded app's own child and is named in the copy's data folder, so take it in place of the old one.
follow_engine() {
	is_recorded "$APP_PID" "$APP_START" "$APP_EXE" || return 0
	is_recorded "$ENGINE_PID" "$ENGINE_START" "$ENGINE_EXE" && return 0
	local pid
	pid=$(tr -d '[:space:]' 2>/dev/null <"$DATA/engine.pid" || true)
	[[ $pid =~ ^[0-9]+$ && $(parent_of "$pid") == "$APP_PID" ]] || return 0
	ENGINE_PID=$pid ENGINE_START=$(started_at "$pid") ENGINE_EXE=$(executable "$pid")
	[[ -n $ENGINE_START ]] && save_state
	return 0
}

# Stops one recorded process: TERM, then KILL if it is still there after STOP_LIMIT seconds. Checks before each
# signal that the pid is still the process recorded.
stop_process() {
	local label=$1 pid=$2 start=$3 exe=$4 waited=0
	[[ -n $pid ]] || return 0
	if [[ -z $(started_at "$pid") ]]; then
		echo "  the $label ($pid) had already exited"
		return 0
	fi
	if ! is_recorded "$pid" "$start" "$exe"; then
		echo "  not signalling process $pid: it is not the $label this script recorded"
		return 0
	fi
	kill -TERM "$pid" 2>/dev/null || true
	while is_recorded "$pid" "$start" "$exe" && ((waited < STOP_LIMIT * 10)); do
		sleep 0.1
		waited=$((waited + 1))
	done
	if is_recorded "$pid" "$start" "$exe"; then
		kill -KILL "$pid" 2>/dev/null || true
		sleep 0.5
		echo "  stopped the $label ($pid) with KILL: it was still running $STOP_LIMIT seconds after TERM"
	else
		echo "  stopped the $label ($pid)"
	fi
}

# Whether a process named in the copy's data folder as its engine is still running there.
engine_on_data() {
	local pid
	pid=$(tr -d '[:space:]' 2>/dev/null <"$DATA/engine.pid" || true)
	[[ $pid =~ ^[0-9]+$ && -n $(started_at "$pid") && $(executable "$pid") == *node ]] && echo "$pid"
	return 0
}

# Stops the copy and removes everything that is its own. Used by "stop", and by "start" when it fails part way.
stop_copy() {
	load_state || true
	follow_engine
	# The app first, and everything else running from the copy's bundle (which can only be the copy's own), so that
	# nothing is left to start a new engine when this one goes. The copy's pi² Remote goes after its engine, which
	# would start it again a second after it went (#944).
	stop_process app "$APP_PID" "$APP_START" "$APP_EXE"
	local pid left
	for pid in $(from_bundle_but_helper); do
		stop_process "process from the copy's bundle" "$pid" "$(started_at "$pid")" "$(executable "$pid")"
	done
	stop_process engine "$ENGINE_PID" "$ENGINE_START" "$ENGINE_EXE"
	stop_process "forwarder to pi² Remote" "$FORWARD_PID" "$FORWARD_START" "$FORWARD_EXE"
	for pid in $(from_bundle); do
		stop_process "process from the copy's bundle" "$pid" "$(started_at "$pid")" "$(executable "$pid")"
	done
	left=$(from_bundle | tr '\n' ' ')
	[[ -z $left ]] || die "processes are still running from the copy's bundle ($left); nothing was removed"
	left=$(engine_on_data)
	[[ -z $left ]] ||
		die "process $left is named in $(tidy "$DATA")/engine.pid and is running, but was not recorded by this script; nothing was removed"

	[[ -d $APP ]] && "$LSREGISTER" -u "$APP" 2>/dev/null && echo "  unregistered $(tidy "$APP") from Launch Services"
	remove "$DATA"
	defaults delete "$ID" >/dev/null 2>&1 || true
	# defaults delete can leave an empty file behind.
	remove "$PREFS"
	local deleted=0
	while ((deleted < 100)) && security delete-generic-password -s "$SERVICE" >/dev/null 2>&1; do
		deleted=$((deleted + 1))
	done
	((deleted == 0)) || echo "  deleted $deleted Keychain item(s) of $SERVICE"
	local p
	for p in "${LEFT_BY_ID[@]}"; do remove "$p"; done
	remove "$DIR"
	rmdir "$COPIES" 2>/dev/null || true

	left=$(leftovers)
	[[ -z $left ]] || die "still there after stopping:"$'\n'"$left"
}

# What is still there of the copy, a line for each; nothing once it is all gone.
leftovers() {
	local p
	[[ -z $(from_bundle) ]] || echo "  a process running from the copy's bundle"
	is_recorded "$APP_PID" "$APP_START" "$APP_EXE" && echo "  the app, process $APP_PID"
	is_recorded "$ENGINE_PID" "$ENGINE_START" "$ENGINE_EXE" && echo "  the engine, process $ENGINE_PID"
	for p in "$DIR" "$DATA" "$PREFS" "${LEFT_BY_ID[@]}"; do
		[[ -e $p || -L $p ]] && echo "  $(tidy "$p")"
	done
	security find-generic-password -s "$SERVICE" >/dev/null 2>&1 && echo "  a Keychain item of $SERVICE"
	p=$(ask_macos registered "$ID")
	[[ -z $p ]] || echo "  a Launch Services entry for $ID, at $(tidy "$p")"
	return 0
}

# Asks macOS what only its frameworks can tell: whether screen capture is allowed, where the copy's windows are, and
# where Launch Services has an app with a bundle id. JavaScript for Automation starts in a moment, where a Swift
# script can take half a minute to compile on a busy Mac; it sends no Apple event to any app, so it cannot set off an
# Automation prompt either.
# "window <pid> [title]" prints the id of that process's largest matching window, or nothing if there is none.
# It first checks screen capture permission silently, and prints "not-permitted" if it is missing.
# "registered <bundle id>" prints the path Launch Services has for it; nothing if none.
# "app-running <bundle id>" prints running if an app with that bundle id is running; nothing if none is.
# "reach <pid>" prints the id of that process's largest window in the window server (layer 0 or below, at least
# 100 by 100), or nothing if there is none; no permission is needed and no window name is read.
# "menus <pid>" prints a line "<id> <x> <y> <width> <height>" for each of that process's open menus (the windows at
# the pop-up menu level), front to back; "not-permitted" as "window" does.
# "bounds <pid> <id>..." prints the same line for each of those windows of that process that is there, front to back.
# No permission is needed, and no window name is read.
# "composite <file> <x> <y> <width> <height> [<picture> <x> <y> <width> <height>]..." draws the pictures, back to
# front, each where its window sits on a canvas of those bounds (in points, as kCGWindowBounds gives them), at the
# first picture's pixels per point, and writes the result to <file> as PNG. It reads only those files.
ask_macos() {
	osascript -l JavaScript - "$@" <<'JS'
ObjC.import('AppKit');
ObjC.import('CoreGraphics');
ObjC.bindFunction('CGPreflightScreenCaptureAccess', ['bool', []]);
function run(argv) {
	if (argv[0] === 'registered') {
		const url = $.NSWorkspace.sharedWorkspace.URLForApplicationWithBundleIdentifier(argv[1]);
		return url.isNil() ? '' : ObjC.unwrap(url.path);
	}
	if (argv[0] === 'app-running') {
		const apps = $.NSWorkspace.sharedWorkspace.runningApplications;
		let running = false;
		for (let i = 0; i < apps.count && !running; i++) {
			const app = apps.objectAtIndex(i);
			if (app.isNil()) continue;
			if (ObjC.unwrap(app.bundleIdentifier) === argv[1] && !ObjC.unwrap(app.terminated)) running = true;
		}
		return running ? 'running' : '';
	}
	if (argv[0] === 'reach') {
		const pid = Number(argv[1]);
		const all = ObjC.deepUnwrap(ObjC.castRefToObject($.CGWindowListCopyWindowInfo(
			$.kCGWindowListOptionAll | $.kCGWindowListExcludeDesktopElements, 0))) || [];
		const windows = all.filter(w => w.kCGWindowOwnerPID === pid && w.kCGWindowLayer <= 0
			&& w.kCGWindowBounds.Width >= 100 && w.kCGWindowBounds.Height >= 100);
		const area = w => w.kCGWindowBounds.Width * w.kCGWindowBounds.Height;
		const largest = windows.sort((a, b) => area(b) - area(a))[0];
		return largest ? String(largest.kCGWindowNumber) : '';
	}
	if (argv[0] === 'composite') {
		const [file, ...rest] = argv.slice(1);
		const [cx, cy, cw, ch] = rest.slice(0, 4).map(Number);
		const layers = [];
		for (let i = 4; i + 4 < rest.length + 1; i += 5) layers.push({ path: rest[i], x: +rest[i + 1], y: +rest[i + 2], w: +rest[i + 3], h: +rest[i + 4] });
		if (!layers.length) return 'error: nothing to draw';
		const first = $.NSBitmapImageRep.imageRepWithContentsOfFile(layers[0].path);
		if (first.isNil()) return 'error: cannot read ' + layers[0].path;
		const scale = first.pixelsWide / layers[0].w;
		const wide = Math.round(cw * scale), high = Math.round(ch * scale);
		const canvas = $.NSBitmapImageRep.alloc.initWithBitmapDataPlanesPixelsWidePixelsHighBitsPerSampleSamplesPerPixelHasAlphaIsPlanarColorSpaceNameBytesPerRowBitsPerPixel(
			null, wide, high, 8, 4, true, false, $.NSDeviceRGBColorSpace, 0, 0);
		const context = $.NSGraphicsContext.graphicsContextWithBitmapImageRep(canvas);
		$.NSGraphicsContext.saveGraphicsState;
		$.NSGraphicsContext.setCurrentContext(context);
		for (const layer of layers) {
			const picture = $.NSImage.alloc.initWithContentsOfFile(layer.path);
			if (picture.isNil()) { $.NSGraphicsContext.restoreGraphicsState; return 'error: cannot read ' + layer.path; }
			// Points from the canvas's top-left corner, as the window server measures, to pixels from its bottom-left.
			const rect = $.NSMakeRect((layer.x - cx) * scale, (cy + ch - layer.y - layer.h) * scale, layer.w * scale, layer.h * scale);
			picture.drawInRectFromRectOperationFraction(rect, $.NSZeroRect, $.NSCompositingOperationSourceOver, 1);
		}
		context.flushGraphics;
		$.NSGraphicsContext.restoreGraphicsState;
		// The same pixels per point as screencapture's own pictures say they have.
		canvas.setSize($.NSMakeSize(cw, ch));
		const png = canvas.representationUsingTypeProperties($.NSBitmapImageFileTypePNG, $());
		return png.writeToFileAtomically(file, true) ? 'written' : 'error: cannot write ' + file;
	}
	const line = w => [w.kCGWindowNumber, w.kCGWindowBounds.X, w.kCGWindowBounds.Y, w.kCGWindowBounds.Width, w.kCGWindowBounds.Height].join(' ');
	if (argv[0] === 'bounds') {
		const pid = Number(argv[1]), ids = argv.slice(2).map(Number);
		const all = ObjC.deepUnwrap(ObjC.castRefToObject($.CGWindowListCopyWindowInfo($.kCGWindowListOptionAll, 0))) || [];
		return all.filter(w => w.kCGWindowOwnerPID === pid && ids.includes(w.kCGWindowNumber)).map(line).join('\n');
	}
	if (!$.CGPreflightScreenCaptureAccess()) return 'not-permitted';
	const pid = Number(argv[1]), title = argv[2];
	const all = ObjC.deepUnwrap(ObjC.castRefToObject($.CGWindowListCopyWindowInfo(
		$.kCGWindowListOptionAll | $.kCGWindowListExcludeDesktopElements, 0))) || [];
	if (argv[0] === 'menus') {
		// A menu is drawn in windows of the app's own at the pop-up menu level, which exist only while it is open.
		// AppKit keeps an open menu on a screen; a menu window left from one closed before can sit off every screen.
		const level = $.CGWindowLevelForKey($.kCGPopUpMenuWindowLevelKey);
		const screens = [], list = $.NSScreen.screens, top = list.objectAtIndex(0).frame;
		for (let i = 0; i < list.count; i++) {
			const f = list.objectAtIndex(i).frame;
			screens.push({ x: f.origin.x, y: top.size.height - f.origin.y - f.size.height, w: f.size.width, h: f.size.height });
		}
		const shown = b => screens.some(s => b.X < s.x + s.w && b.X + b.Width > s.x && b.Y < s.y + s.h && b.Y + b.Height > s.y);
		return all.filter(w => w.kCGWindowOwnerPID === pid && w.kCGWindowLayer === level && w.kCGWindowAlpha > 0
			&& w.kCGWindowBounds.Width > 0 && w.kCGWindowBounds.Height > 0 && shown(w.kCGWindowBounds)).map(line).join('\n');
	}
	// While the display is locked or asleep, the copy's window need not be marked on screen to be capturable.
	const windows = all.filter(w => w.kCGWindowOwnerPID === pid && w.kCGWindowLayer <= 0
		&& w.kCGWindowBounds.Width >= 100 && w.kCGWindowBounds.Height >= 100
		&& (title === undefined || w.kCGWindowName === title));
	const area = w => w.kCGWindowBounds.Width * w.kCGWindowBounds.Height;
	const largest = windows.sort((a, b) => area(b) - area(a))[0];
	return largest ? String(largest.kCGWindowNumber) : '';
}
JS
}

require_engine() {
	load_state || die "no copy named $SUFFIX was started from this checkout"
	follow_engine
	is_recorded "$ENGINE_PID" "$ENGINE_START" "$ENGINE_EXE" || die "the copy $SUFFIX has no recorded engine running"
	# Never follow a socket or data-folder symlink to another copy, and never use PI2_HOME or a socket override.
	[[ ! -L $DATA && ! -L $DATA/engine.sock ]] || die "refusing a symlink for the copy's data folder or engine socket"
}

# Check the built app before either making a copy or stopping one to install a rebuild.
require_source() {
	if [[ ! -d $SOURCE ]]; then
		if [[ -d $RELEASE ]]; then
			die "there is only a release build here ($(tidy "$RELEASE")), and this script copies only a development build: a release build runs on the usual data folder. Build one with ./app/build.sh, or ./app/build.sh optimised for optimisation"
		fi
		die "there is no development build in this checkout. Build one first: (cd engine && npm ci) && ./app/build.sh, or ./app/build.sh optimised for optimisation. This script builds nothing"
	fi
	local main
	main=$("$PLIST" -c 'Print :PI2EngineMain' "$SOURCE/Contents/Info.plist" 2>/dev/null || true)
	[[ ! -L $SOURCE && -n $main && ! -e "$SOURCE/Contents/Resources/engine" ]] ||
		die "$(tidy "$SOURCE") is not a development build (it carries its own engine, is a symlink, or has no PI2EngineMain)"
	# build.sh writes the checkout as the shell it ran in spelled it, which may be through a link (/tmp for
	# /private/tmp); ROOT is resolved, so resolve this side too.
	[[ -n $main && $(resolved "$main") == "$ROOT/engine/src/main.ts" && -f $main ]] ||
		die "$(tidy "$SOURCE") runs the engine at $(tidy "$main"), not this checkout's; build it again here with ./app/build.sh"
	[[ -d "$ROOT/engine/node_modules" ]] || die "the engine's packages are not installed: run (cd engine && npm ci)"
}

copy_bundle() {
	local app=$1
	ditto "$SOURCE" "$app" || die "could not copy the latest development build"
	"$PLIST" -c "Set :CFBundleIdentifier $ID" -c "Set :CFBundleName $NAME" -c "Set :CFBundleDisplayName $NAME" \
		"$app/Contents/Info.plist" >/dev/null || die "could not give the copy its own bundle id and name"
	# The engine as this checkout's resolved path, the same file require_source found the build names: the copy's app
	# finds its own folder in the checkout from it (TestCopyControl), and compares it with where the copy's bundle is,
	# which is resolved, as ROOT is.
	"$PLIST" -c "Set :PI2EngineMain $ROOT/engine/src/main.ts" "$app/Contents/Info.plist" >/dev/null ||
		die "could not name the checkout's engine in the copy"
	[[ $("$PLIST" -c 'Print :CFBundleIdentifier' "$app/Contents/Info.plist") == "$ID" ]] ||
		die "the copy's bundle id did not change"
	# Editing Info.plist breaks the signature; sign it again, ad hoc. ditto kept Sparkle's symbolic links.
	codesign --force --sign - "$app" 2>/dev/null || die "could not sign the copy: codesign --force --sign - failed"
}

require_copy() {
	[[ ! -L $COPIES && ! -L $DIR && ! -L $STATE && ! -L $DATA && ! -L $DATA/engine.sock && ! -L $APP ]] ||
		die "refusing a symlink for the copy, state, data folder or engine socket"
	load_state || die "no copy named $SUFFIX was started from this checkout"
	[[ -d $APP && $("$PLIST" -c 'Print :CFBundleIdentifier' "$APP/Contents/Info.plist" 2>/dev/null) == "$ID" ]] ||
		die "the copy's bundle is missing or has a different bundle id"
	local main
	main=$("$PLIST" -c 'Print :PI2EngineMain' "$APP/Contents/Info.plist" 2>/dev/null || true)
	[[ -n $main && $(resolved "$main") == "$ROOT/engine/src/main.ts" && ! -e "$APP/Contents/Resources/engine" ]] ||
		die "the copy is not a development build of this checkout"
	[[ $APP_EXE == "$APP/Contents/MacOS/pi2" ]] || die "the recorded app executable is not the copy"
}

# Shared by start and reopen: the same clean environment and pid recording on every launch.
launch_app() {
	# A clean environment, so nothing the caller's shell has (PI2_HOME naming the usual data folder, above all)
	# reaches the copy; what it needs is named here. -g keeps it from taking the focus, -n makes a new instance.
	vars=(--env "PI2_HOME=$DATA" --env "PI2_KEYCHAIN_SERVICE=$SERVICE" --env "PI2_TEST_COPY=$SUFFIX"
		--env PI2_WINDOW_BEHIND=1 --env PI2_WINDOW_ORIGIN=10000,10000 --env PI2_DRAW_WHEN_HIDDEN=1)
	[[ -n ${PI2_SCRATCH-} ]] && vars+=(--env "PI2_TEST_COPY_SCRATCH=$PI2_SCRATCH")
	[[ -n $SHOW ]] && vars+=(--env "PI2_SHOW=$SHOW")
	[[ -n $HUB ]] && vars+=(--env "PI2_HUB=$HUB")
	[[ -n $MENU ]] && vars+=(--env "PI2_MENU=$MENU")
	[[ -n $APPEARANCE ]] && vars+=(--env "PI2_APPEARANCE=$APPEARANCE")
	local pair
	for pair in ${TEST_ENV[@]+"${TEST_ENV[@]}"}; do vars+=(--env "$pair"); done
	((REMOTE == 0)) || vars+=(--env "$REMOTE_ENV")
	env -i HOME="$HOME" USER="${USER-}" LOGNAME="${LOGNAME-}" TMPDIR="${TMPDIR:-/tmp/}" LANG=en_US.UTF-8 \
		PATH=/usr/bin:/bin:/usr/sbin:/sbin /usr/bin/open -n -g "$APP" "${vars[@]}" || die "could not open the copy's app"

	waited=0
	local pid
	while [[ -z $APP_PID ]]; do
		# The app by its executable: at reopen, the copy's pi² Remote runs from the bundle too (#944).
		for pid in $(from_bundle); do
			[[ $(executable "$pid") == "$APP/Contents/MacOS/pi2" ]] && { APP_PID=$pid; break; }
		done
		((waited < START_LIMIT * 2)) || die "the copy did not start within $START_LIMIT seconds"
		[[ -n $APP_PID ]] || { sleep 0.5; waited=$((waited + 1)); }
	done
	APP_START=$(started_at "$APP_PID") APP_EXE=$(executable "$APP_PID")
	[[ $APP_EXE == "$APP/Contents/MacOS/pi2" ]] || die "process $APP_PID runs $APP_EXE, not the copy"
	save_state

}

# ---- A phone in the simulator (#681, docs/iphone.md 10)

# One request to the copy's engine, as call makes it (with the copy's key, so it counts as the app's), printing the
# response's result as JSON. Dies with the engine's own words on an error.
engine_call() {
	local out
	out=$("$ROOT/scripts/test-copy" call "$SUFFIX" "$1" "${2-"{}"}" 2>&1) || die "the copy's engine refused $1: $out"
	printf '%s\n' "$out"
}

# What the JavaScript expression $1, of the response's result `r`, gives for the response on standard input: text as
# it is, anything else as JSON, nothing for null. The expressions are this script's own.
from_json() {
	node -e 'let t = ""; process.stdin.on("data", (c) => (t += c)).on("end", () => { const r = JSON.parse(t).result;
		const v = ('"$1"'); process.stdout.write(v === undefined || v === null ? "" : typeof v === "string" ? v : JSON.stringify(v)); });'
}

# start --remote: remote access on in the copy's engine, as the person would turn it on in Settings › Devices, with the
# preview on, Find on this network on (the home path, which a development pi² Remote holds on 127.0.0.1 alone),
# Direct from any address off, the relay off, and REMOTE_RELAY, on loopback, where nothing of pi² listens. pi² Remote
# itself starts only with a pairing.
remote_on() {
	local out
	out=$(engine_call devices.set "{\"on\":true,\"preview\":true,\"home\":true,\"direct\":false,\"relay\":false,\"relayAddress\":\"$REMOTE_RELAY\"}")
	[[ $(from_json 'r.remote.on && r.remote.preview && r.remote.home && !r.remote.direct && !r.remote.relay && r.relay' <<<"$out") == "$REMOTE_RELAY" ]] ||
		die "the copy's engine did not turn remote access on as asked: $out"
}

# Whether pid $1 is the copy's own pi² Remote (#944): run from the helper in this copy's bundle, the paths compared
# resolved, and a child of the copy's recorded engine, which starts it while a device is paired or a pairing is open
# (docs/pi2-remote.md). reopen keeps it with its engine, and stop stops it after the engine, which would start it
# again. Anything else from the bundle is not it.
own_helper() {
	local pid=$1 exe
	[[ -n $ENGINE_PID && $(parent_of "$pid") == "$ENGINE_PID" ]] || return 1
	is_recorded "$ENGINE_PID" "$ENGINE_START" "$ENGINE_EXE" || return 1
	exe=$(executable "$pid")
	[[ $exe == "$APP/"* && $(resolved "$exe") == "$(resolved "$APP")/Contents/Helpers/pi² Remote.app/Contents/MacOS/pi² Remote" ]]
}

# The pids from the copy's bundle (from_bundle) but its own pi² Remote.
from_bundle_but_helper() {
	local pid
	for pid in $(from_bundle); do
		own_helper "$pid" || echo "$pid"
	done
	return 0
}

# The copy's pi² Remote, by its pid: what runs from its bundle's helper.
helper_pids() {
	local pid
	for pid in $(from_bundle); do
		[[ $(executable "$pid") == "$APP/Contents/Helpers/pi² Remote.app/Contents/MacOS/pi² Remote" ]] && echo "$pid"
	done
	return 0
}

# Why the copy's pi² Remote may not be let near a phone, failing, or nothing: it must run, and every socket it has be
# on 127.0.0.1, what its code holds it to in a development build (Addresses.swift, docs/pi2-remote.md), seen from
# outside. An lsof that fails or says nothing is a refusal too. scripts/test-test-copy feeds it a stand-in lsof.
loopback_helper_problem() {
	local pids pid names name
	pids=$(helper_pids)
	[[ -n $pids ]] || { echo "the copy's pi² Remote is not running; $(tidy "$DATA")/remote.log may say why"; return 1; }
	for pid in $pids; do
		names=$(lsof -nP -a -p "$pid" -i 2>/dev/null | awk 'NR > 1 { print $9 }')
		[[ -n $names ]] || { echo "the copy's pi² Remote ($pid) has no socket open; $(tidy "$DATA")/remote.log may say why"; return 1; }
		while read -r name; do
			[[ $name =~ ^127\.0\.0\.1:[0-9]+(-\>127\.0\.0\.1:[0-9]+)?$ ]] ||
				{ echo "the copy's pi² Remote ($pid) has a socket that is not on 127.0.0.1 ($name): stop the copy"; return 1; }
		done <<<"$names"
	done
}

# pair, once it has opened a pairing: unless the copy's pi² Remote is held to 127.0.0.1, closes that pairing, and stops
# before the phone is given anything.
require_loopback_helper() {
	local why
	why=$(loopback_helper_problem) && return 0
	engine_call devices.pairCancel >/dev/null
	die "$why; the pairing was closed, and nothing was given to the phone"
}

# The port the copy's pi² Remote listens on, once it does: nothing while it is not running or not yet listening.
helper_port() {
	local pid name
	for pid in $(helper_pids); do
		name=$(lsof -nP -a -p "$pid" -i 2>/dev/null | awk 'NR > 1 && $10 == "(LISTEN)" { print $9; exit }')
		[[ $name =~ ^127\.0\.0\.1:([0-9]+)$ ]] && { echo "${BASH_REMATCH[1]}"; return 0; }
	done
	return 0
}

# Stops the forwarder remote-on started, by its recorded pid, and forgets it.
stop_forward() {
	[[ -n $FORWARD_PID ]] || return 0
	stop_process "forwarder to pi² Remote" "$FORWARD_PID" "$FORWARD_START" "$FORWARD_EXE"
	FORWARD_PID="" FORWARD_START="" FORWARD_EXE=""
	save_state
}

# Forwards the port the paired phone knows ($PHONE_ADDRESS) to $1, pi² Remote's port now, if they differ (#951): a
# copy's pi² Remote has no Bonjour, and the phone would never find it again on its new port.
forward_phone_address() {
	local now=$1 known pid
	stop_forward
	[[ -n $PHONE_ADDRESS ]] || return 0
	known=${PHONE_ADDRESS#127.0.0.1:}
	[[ $known != "$now" ]] || return 0
	pid=$(node "$ROOT/scripts/test-copy-forward.mjs" start "$known" "$now" "$DIR/forward.log" 2>&1) ||
		die "could not forward 127.0.0.1:$known, which the phone knows, to pi² Remote's new port $now: $pid. Pair the phone again with scripts/test-copy pair $SUFFIX"
	FORWARD_PID=$pid FORWARD_START=$(started_at "$pid") FORWARD_EXE=$(executable "$pid")
	save_state
	echo "pi² Remote listens on 127.0.0.1:$now now; forwarding 127.0.0.1:$known, the address the phone knows, to it (process $pid)."
}

# The simulator a phone command works on: --sim's, or pi2-N for a copy test-N, through scripts/iphone-sim, which
# refuses one it did not make (and booted). Sets SIM and UDID.
phone_simulator() {
	SIM=${1:-$PHONE_SIM}
	if [[ -z $SIM ]]; then
		[[ $SUFFIX =~ ^test-([0-9]+)$ ]] ||
			die "say which simulator: --sim <name>, one scripts/iphone-sim create made, such as pi2-681"
		SIM="pi2-${BASH_REMATCH[1]}"
	fi
	UDID=$("$ROOT/scripts/iphone-sim" id "$SIM") || die "no simulator to pair: make one with scripts/iphone-sim create $SIM, then scripts/iphone-sim build $SIM"
}

# Launches the simulator's app, with the environment given, and prints its process id in the simulator.
launch_phone() {
	local out
	out=$("$ROOT/scripts/iphone-sim" run "$SIM" "$@" 2>&1) || die "could not run the app in $SIM: $out"
	[[ $out =~ dev\.pi2\.ios:\ ([0-9]+) ]] || die "the app in $SIM did not say its process id: $out"
	echo "${BASH_REMATCH[1]}"
}

# Answers the phone's Face ID with a matching face, as the simulator's Features › Face ID › Matching Face does, until
# the copy's engine has a session for the device other than those in $2 (the phone attached), within $1 seconds. A
# match given while no Face ID is asked is let pass by the simulator, so it is given every two seconds: the app asks
# once the first screen has gone on by itself after "Paired", or at launch. A session that ended between two looks, as
# one does that a launch value ends at once (Lock, unpair; #984), counts too: an attach the devices' log has for the
# device since $3 (the launch, in milliseconds), said as ended.
attach_phone() {
	local limit=$1 before=$2 since=$3 deadline sessions attached
	deadline=$((SECONDS + limit))
	while :; do
		"$ROOT/scripts/iphone-sim" face-id "$SIM" match >/dev/null 2>&1 || true
		sleep 2
		attached=$(engine_call devices.log "{\"device\":\"$PHONE_DEVICE\"}" |
			from_json "r.entries.filter((e) => (e.method === 'attach' || e.method === 'resume') && e.outcome === 'done' && e.at >= $since).map((e) => e.path)[0]")
		sessions=$(engine_call devices.watch | from_json "r.sessions.filter((s) => s.device === '$PHONE_DEVICE').map((s) => s.session + ' ' + s.path).join('\\n')")
		while read -r session path; do
			[[ -n $session && " $before " != *" $session "* ]] || continue
			echo "The phone is attached to $NAME over the $path path (session $session)."
			return 0
		done <<<"$sessions"
		if [[ -n $attached ]]; then
			echo "The phone attached to $NAME over the $attached path, and its session has already ended; the copy's devices.log has both."
			return 0
		fi
		((SECONDS < deadline)) ||
			die "the phone did not attach within $limit seconds; see it with scripts/iphone-sim shot $SIM <file.png>, and $(tidy "$DATA")/remote.log"
	done
}

cmd=${1-}; shift || true
case $cmd in
	start)
		names "${1-}"; shift
		no_app_nap=0
		while (($#)); do
			case $1 in
				--no-app-nap) no_app_nap=1; shift ;;
				--show) [[ -n ${2-} ]] || die "--show needs what to open on, such as activity or settings:general"; SHOW=$2; shift 2 ;;
				--hub) check_hub "${2-}"; HUB=$2; shift 2 ;;
				--welcome) WELCOME=1; shift ;;
				--env) [[ -n ${2-} ]] || die "--env needs NAME=VALUE"; add_test_env "$2"; shift 2 ;;
				--menu) [[ -n ${2-} ]] || die "--menu needs the label of what to right-click, such as a conversation's title"; MENU=$2; shift 2 ;;
				--appearance) [[ -n ${2-} ]] || die "--appearance needs light or dark"; check_appearance "$2"; APPEARANCE=$2; shift 2 ;;
				--fill) check_fill "${2-}"; FILLS+=("$2"); shift 2 ;;
				--remote) REMOTE=1; shift ;;
				*) die "unknown option $1" ;;
			esac
		done
		[[ $SHOW != *$'\n'* && $SHOW != *$'\r'* ]] || die "--show takes one line"
		[[ $MENU != *$'\n'* ]] || die "--menu takes one line"

		require_source
		((${#FILLS[@]} == 0)) || seed_node "$SOURCE" >/dev/null

		# Claim the suffix: first in this checkout, then on the Mac. mkdir succeeds for one caller only.
		mkdir -p "$COPIES"
		mkdir "$DIR" 2>/dev/null ||
			die "a copy named $SUFFIX is already started, or starting, from this checkout: scripts/test-copy status $SUFFIX shows it, scripts/test-copy stop $SUFFIX stops and removes it"
		if [[ -n $(lsappinfo find "bundleid=$ID" 2>/dev/null) ]] || ! mkdir "$DATA" 2>/dev/null; then
			rmdir "$DIR"
			die "the suffix $SUFFIX is in use outside this checkout: $(tidy "$DATA") exists, or an app with the bundle id $ID is running. It is not this checkout's to stop or remove; choose another suffix, such as $SUFFIX-2"
		fi
		# From here on, a failure stops and removes what was started.
		trap 'echo "test-copy: start failed; removing what it made" >&2; stop_copy >&2' EXIT
		save_state
		# A new data folder shows the first-run welcome, a sheet over every page a picture would show. Unless asked to
		# keep it, mark it done as finishing it would (settings.finishOnboarding), in the copy's own settings, which its
		# engine reads as it starts. Nothing in the app changes, so a release build behaves as before.
		((WELCOME)) || printf '{\n\t"onboarded": true\n}\n' >"$DATA/settings.json"
		# Write before launch so macOS starts the copy with App Nap disabled. Reopen keeps this preference domain.
		if ((no_app_nap)); then
			defaults write "$ID" NSAppSleepDisabled -bool true || die "could not disable App Nap for $ID"
		fi
		copy_bundle "$APP"
		((${#FILLS[@]} == 0)) || seed_before_start

		launch_app
		# Ready once the copy's own engine is named in its data folder and listening there.
		waited=0
		while :; do
			is_recorded "$APP_PID" "$APP_START" "$APP_EXE" ||
				die "the copy quit as it started; $(tidy "$DATA")/app.log may say why (it is removed with the rest)"
			# Redirect stderr first: a missing pid file is expected while the engine starts.
			pid=$(tr -d '[:space:]' 2>/dev/null <"$DATA/engine.pid" || true)
			if [[ $pid =~ ^[0-9]+$ && $(parent_of "$pid") == "$APP_PID" ]] &&
				grep -qF "listening on $DATA/engine.sock" "$DATA/engine.log" 2>/dev/null; then
				break
			fi
			((waited < START_LIMIT * 2)) || die "the copy's engine was not listening within $START_LIMIT seconds"
			sleep 0.5
			waited=$((waited + 1))
		done
		ENGINE_PID=$pid ENGINE_START=$(started_at "$pid") ENGINE_EXE=$(executable "$pid")
		save_state
		((REMOTE == 0)) || remote_on
		trap - EXIT

		echo "Started $NAME ($ID)${SHOW:+, showing $SHOW}."
		if ((WELCOME)); then
			echo "  The first-run welcome shows, as on any new data folder."
		else
			echo "  The first-run welcome is marked done, so it does not show; --welcome keeps it."
		fi
		echo "  copy              $(tidy "$APP")"
		echo "  data folder       $(tidy "$DATA")"
		echo "  Keychain service  $SERVICE"
		echo "  app pid           $APP_PID"
		echo "  engine pid        $ENGINE_PID"
		if ((REMOTE)); then
			echo "  remote access     on, for a phone in the simulator: pi² Remote starts with a pairing, on 127.0.0.1 alone"
			echo "Pair a simulator's app with it with scripts/test-copy pair $SUFFIX [--sim <name>]."
		fi
		echo "Capture it with scripts/test-copy shot $SUFFIX <file.png>; stop it with scripts/test-copy stop $SUFFIX."
		if [[ $SUFFIX == test* ]]; then
			echo "An agent whose computer use has Test copies of pi² on may click in it as $ID; without that, it can only look."
		else
			echo "Computer use can only look at it: the suffix does not begin with test, so it is not a test copy for Test copies of pi²."
		fi
		if [[ -n $MENU ]]; then
			# The app writes the file once the page has settled and it has looked for the element, found or not.
			waited=0
			while [[ ! -f $DATA/$MENU_FILE ]] && ((waited < START_LIMIT * 2)) && is_recorded "$APP_PID" "$APP_START" "$APP_EXE"; do
				sleep 0.5
				waited=$((waited + 1))
			done
			echo
			if [[ -f $DATA/$MENU_FILE ]]; then
				cat "$DATA/$MENU_FILE"
			else
				echo "test-copy: the copy wrote no context menu for '$MENU' within $START_LIMIT seconds; $(tidy "$DATA")/app.log may say why" >&2
			fi
		fi
		;;
	reopen)
		names "${1-}"; shift
		requested_show="" replace_show=0 requested_hub="" requested_appearance=""
		while (($#)); do
			case $1 in
				--show) [[ -n ${2-} ]] || die "--show needs what to open on, such as activity or settings:general"; requested_show=$2; replace_show=1; shift 2 ;;
				--hub) check_hub "${2-}"; requested_hub=$2; shift 2 ;;
				--appearance) [[ -n ${2-} ]] || die "--appearance needs light or dark"; check_appearance "$2"; requested_appearance=$2; shift 2 ;;
				*) die "unknown option $1" ;;
			esac
		done
		[[ $requested_show != *$'\n'* && $requested_show != *$'\r'* ]] || die "--show takes one line"
		require_copy
		# An exited app can be reopened too, but never signal a pid that has since been reused.
		[[ -z $(started_at "$APP_PID") ]] || is_recorded "$APP_PID" "$APP_START" "$APP_EXE" ||
			die "the app pid is no longer the process recorded"
		# The engine first, as the one whose child the copy's pi² Remote is, which is kept with it.
		follow_engine
		for pid in $(from_bundle_but_helper); do
			[[ $pid == "$APP_PID" ]] || die "an unrecorded process is running from the copy's bundle; nothing was stopped"
		done
		is_recorded "$ENGINE_PID" "$ENGINE_START" "$ENGINE_EXE" || die "the copy $SUFFIX has no recorded engine running"
		require_source
		# Prepare the replacement before stopping the working app; don't merge files into the old signed bundle.
		staged=$(mktemp -d "$DIR/.reopen.XXXXXXXX") || die "could not make a staging folder for the new app"
		trap 'rm -rf -- "$staged"' EXIT
		copy_bundle "$staged/$NAME.app"
		((replace_show == 0)) || SHOW=$requested_show
		[[ -z $requested_hub ]] || HUB=$requested_hub
		[[ -z $requested_appearance ]] || APPEARANCE=$requested_appearance
		stop_process app "$APP_PID" "$APP_START" "$APP_EXE" >/dev/null
		[[ -z $(from_bundle_but_helper) ]] || die "the app did not stop; nothing was reopened"
		APP_PID="" APP_START=""
		save_state
		mv -h "$APP" "$staged/previous.app" || die "could not move the old bundle aside"
		if ! mv -h "$staged/$NAME.app" "$APP"; then
			if ! mv -h "$staged/previous.app" "$APP"; then
				trap - EXIT
				die "could not install the rebuilt app or restore the previous bundle; it is in $(tidy "$staged")"
			fi
			die "could not install the rebuilt app; restored the previous bundle"
		fi
		# A failed relaunch leaves the engine, data and state for diagnosis, retry and stop.
		launch_app
		echo "Reopened $NAME from the latest development build (app pid $APP_PID); kept its data and engine (pid $ENGINE_PID)."
		;;
	show|size|sidebar|choose)
		names "${1-}"; shift
		if [[ $cmd == show ]]; then
			if [[ $# == 3 && ${2-} == --hub && ${1-} == project:* ]]; then
				check_hub "$3"
			else
				(($# == 1)) || die "use: scripts/test-copy show $SUFFIX <conversation> | dashboard | project:<name-or-id>[#<tab-or-agent>] [--hub <fold>]"
			fi
		elif [[ $cmd == size ]]; then
			{ [[ $# == 1 && $1 == smallest ]] || [[ $# == 2 && $1 != smallest ]]; } ||
				die "use: scripts/test-copy size $SUFFIX <width> <height> | smallest"
		elif [[ $cmd == sidebar ]]; then
			[[ $# == 1 && ($1 == narrowest || $1 =~ ^[1-9][0-9]{0,4}$) ]] ||
				die "use: scripts/test-copy sidebar $SUFFIX <points> | narrowest"
		else
			(($# > 0)) || die "use: scripts/test-copy choose $SUFFIX <path>... | cancel"
		fi
		require_copy
		is_recorded "$APP_PID" "$APP_START" "$APP_EXE" || die "the copy $SUFFIX has no recorded app running"
		control="$DATA/test-copy-control"
		[[ ! -L $control ]] || die "refusing a symlink for the copy's window control folder"
		[[ -d $DATA ]] || die "the copy's data folder is missing"
		node "$ROOT/scripts/test-copy-drive.mjs" "$cmd" "$control" "$SUFFIX" "$APP_PID" "$@"
		;;
	can-click)
		names "${1-}"; shift
		(($# == 0)) || die "use: scripts/test-copy can-click $SUFFIX"
		require_copy
		is_recorded "$APP_PID" "$APP_START" "$APP_EXE" || die "the copy $SUFFIX has no recorded app running"
		control="$DATA/test-copy-control"
		[[ ! -L $control ]] || die "refusing a symlink for the copy's window control folder"
		[[ -d $DATA ]] || die "the copy's data folder is missing"
		# Three answers (#612): yes (exit 0); no, with its cause (exit 1); and cannot tell from here (exit 2), where
		# nothing a command can ask decides it. A no is only ever given for a cause that is known, since a wrong no makes
		# an agent skip the clicking it could have done. Nothing below asks macOS for a permission: each check needs none.
		no() { echo "test-copy: no, computer use cannot click in $SUFFIX: $*" >&2; exit 1; }
		cannot_tell() { echo "test-copy: cannot tell from here whether computer use can click in $SUFFIX: $*" >&2; exit 2; }
		[[ -n $(ask_macos app-running "$USUAL_ID") ]] || no "the pi² app is not running, and only the person can reopen it"
		# A copy just started or reopened draws its window a moment after its app is up: wait for it, as shot does.
		# TEST_COPY_WINDOW_WAIT shortens the wait for scripts/test-test-copy.
		window_wait=${TEST_COPY_WINDOW_WAIT:-$SHOT_LIMIT}
		[[ $window_wait =~ ^[0-9]+$ ]] || die "TEST_COPY_WINDOW_WAIT is a whole number of seconds"
		deadline=$((SECONDS + window_wait))
		until [[ -n $(ask_macos reach "$APP_PID") ]]; do
			is_recorded "$APP_PID" "$APP_START" "$APP_EXE" || no "the copy's app stopped running"
			((SECONDS < deadline)) ||
				no "no window of the copy has been in the window server for $window_wait seconds; is one open? scripts/test-copy show $SUFFIX <conversation-or-project>"
			sleep 0.5
		done
		# The copy raises its parked window within its own level and says whether its app element then gives the window
		# to accessibility where the tool's search looks: as its main or focused window, or among its windows.
		if ! out=$(node "$ROOT/scripts/test-copy-drive.mjs" expose "$control" "$SUFFIX" "$APP_PID" 2>&1); then
			out=${out#test-copy: }
			case $out in
				*"does not give its main window to accessibility"*) no "$out" ;;
				# The tool finds the window but turns it down when the window server has it elsewhere at another size,
				# or not at all (#748), or at that size where the size cannot say which window it is (#770).
				*"so the computer tool would not take it"*) no "$out" ;;
				*unknown\ test-copy\ window\ command*)
					cannot_tell "the copy's build predates the request that raises its parked window and says whether the tool can find it; rebuild the app (./app/build.sh), run scripts/test-copy reopen $SUFFIX, and ask again" ;;
				*) cannot_tell "the copy did not say whether the tool can find its window: $out" ;;
			esac
		fi
		echo "Yes: computer use can read and click $SUFFIX now. The pi² app is running, the copy's window is in the window server, and the copy raised it within its own level and gives it to accessibility, where the computer tool looks for it, at the size the window server has it."
		echo "One thing cannot be told from here: whether pi² has the Accessibility permission, which no command can read without asking macOS or the pi² app. If the tool answers that pi² does not have it, only the person can grant it, in this agent's settings under Computer use."
		;;
	answer|fill)
		names "${1-}"; shift
		if [[ $cmd == answer ]]; then
			[[ $# == 2 && ($2 == allow || $2 == deny || $2 =~ ^[[:space:]]*\{) ]] ||
				die "use: scripts/test-copy answer $SUFFIX <conversation> allow|deny or <need-id> '<json answer>'"
		else
			{ [[ $# == 1 ]] || [[ $# == 2 && ($1 == --project || $1 == project) && -n ${2-} && ${2-} != *$'\n'* && ${2-} != *$'\r'* ]]; } ||
				die "use: scripts/test-copy fill $SUFFIX <entries> | --project [<name or count>]"
		fi
		require_copy
		require_engine
		[[ ! -L $DIR/answer-key ]] || die "refusing a symlink for the copy's answer key"
		# The copy's engine takes an answer only from its app, or from a connection that gives the key it wrote here (#504).
		TEST_COPY_KEY_FILE="$DIR/answer-key" node "$ROOT/scripts/test-copy-drive.mjs" "$cmd" "$DATA/engine.sock" "$SUFFIX" "$@"
		;;
	last-copy)
		names "${1-}"; shift
		(($# == 0)) || die "use: scripts/test-copy last-copy $SUFFIX"
		require_copy
		file="$DATA/copies.jsonl"
		[[ ! -L $file ]] || die "refusing a symlink for the copy's record of Copy actions"
		[[ -f $file && -s $file ]] || die "no Copy action has been recorded in $SUFFIX"
		tail -n 1 "$file"
		;;
	shot)
		names "${1-}"; shift
		file=${1-} title="" menu=0
		shift || true
		while (($#)); do
			case $1 in
				--window) [[ -n ${2-} ]] || die "--window needs a window's title"; title=$2; shift 2 ;;
				--menu) menu=1; shift ;;
				*) die "unknown option $1" ;;
			esac
		done
		[[ -n $file ]] || die "say where to put the picture: scripts/test-copy shot $SUFFIX <file.png>"
		[[ $file == *.png ]] || die "the picture is a PNG: give a file name ending in .png"
		((menu == 0)) || [[ -z $title ]] || die "--menu captures the open menu, whatever window it belongs to: give --menu or --window, not both"
		folder=$(cd "$(dirname "$file")" 2>/dev/null && pwd -P) || die "there is no folder $(dirname "$file")"
		[[ $folder == "$ROOT" || $folder == "$ROOT/"* ]] ||
			die "refusing to write $file: a picture goes inside this checkout (app/build is ignored by git; $(tidy "$DIR") goes with the copy at stop)"
		file="$folder/$(basename "$file")"
		load_state || die "no copy named $SUFFIX was started from this checkout"
		is_recorded "$APP_PID" "$APP_START" "$APP_EXE" || die "the copy $SUFFIX is not running (its app, $APP_PID, has exited)"
		[[ ! -d $file ]] || die "the picture's path is a folder: $(tidy "$file")"
		pending_dir="" capture_problem="" copy_silent=0
		# The folder is mktemp's, inside the checkout, and holds only this capture's pictures.
		trap 'if [[ -n $pending_dir ]]; then rm -rf -- "$pending_dir"; fi' EXIT
		not_permitted="screen capture is not allowed for this shell, so nothing was captured. Do not ask for it: the prompt would appear on the person's screen. Say that the change was not seen on screen"
		# Captures the windows on the lines "<id> <x> <y> <width> <height>" (front to back, as ask_macos gives them) and
		# puts them together in $pending_dir/picture.png, each where it sits. Each is captured by itself (-a): a parked
		# window cannot be captured together with the windows attached to it, its sheets, which is why shot could not
		# take a copy with a sheet or an alert up (#779). -l takes a window without focusing it, -o leaves out the
		# shadow, -x the sound. Says what went wrong in capture_problem.
		capture_windows() {
			local lines=$1 id x y w h layers=() canvas out
			[[ -n $pending_dir ]] || pending_dir=$(mktemp -d "$folder/.test-copy-shot.XXXXXXXX")
			rm -f -- "$pending_dir/picture.png"
			canvas=$(awk 'NR == 1 { l = $2; t = $3; r = $2 + $4; b = $3 + $5 }
				{ if ($2 < l) l = $2; if ($3 < t) t = $3; if ($2 + $4 > r) r = $2 + $4; if ($3 + $5 > b) b = $3 + $5 }
				END { print l, t, r - l, b - t }' <<<"$lines")
			while read -r id x y w h; do
				[[ $id =~ ^[0-9]+$ ]] || continue
				# Window Server can list a window before it can produce an image for it: the caller tries again.
				if ! problem=$(screencapture -x -o -a -l "$id" "$pending_dir/$id.png" 2>&1) || [[ ! -s $pending_dir/$id.png ]]; then
					capture_problem=${problem:-screencapture produced no image of window $id}
					return 1
				fi
				layers+=("$pending_dir/$id.png" "$x" "$y" "$w" "$h")
			done < <(tail -r <<<"$lines")
			((${#layers[@]} > 0)) || { capture_problem="no window to capture"; return 1; }
			if ((${#layers[@]} == 5)); then
				mv -fh -- "${layers[0]}" "$pending_dir/picture.png"
				return 0
			fi
			# shellcheck disable=SC2086 # the canvas is four numbers
			out=$(ask_macos composite "$pending_dir/picture.png" $canvas "${layers[@]}")
			[[ $out == written && -s $pending_dir/picture.png ]] || { capture_problem="could not put the windows together: $out"; return 1; }
		}
		# A menu does not open by itself, so one that is not open yet is waited for only briefly.
		limit=$SHOT_LIMIT
		((menu == 0)) || limit=$MENU_LIMIT
		deadline=$((SECONDS + limit))
		while :; do
			if ((menu)); then
				lines=$(ask_macos menus "$APP_PID")
				[[ $lines != not-permitted ]] || die "$not_permitted"
				is_recorded "$APP_PID" "$APP_START" "$APP_EXE" || die "the copy $SUFFIX stopped running while waiting for its menu"
				if [[ -n $lines ]] && capture_windows "$lines"; then
					mv -fh -- "$pending_dir/picture.png" "$file"
					echo "Captured the open menu of $NAME ($(wc -l <<<"$lines" | tr -d ' ') window(s): $(cut -d' ' -f1 <<<"$lines" | tr '\n' ' ' | sed 's/ $//')) into $(tidy "$file")."
					break
				fi
			else
				wid=$(ask_macos window "$APP_PID" ${title:+"$title"})
				[[ $wid != not-permitted ]] || die "$not_permitted"
				is_recorded "$APP_PID" "$APP_START" "$APP_EXE" || die "the copy $SUFFIX stopped running while waiting for its window"
				if [[ $wid =~ ^[0-9]+$ ]]; then
					# Which windows are attached to it only the copy can say: the window server does not, and every window
					# of a parked copy sits at the same place. A copy that cannot say gets the window alone, as before.
					attached=""
					if ((!copy_silent)); then
						control="$DATA/test-copy-control"
						if [[ -L $DATA || -L $control || ! -d $control ]]; then
							said="it has no window control folder"
						elif said=$(node "$ROOT/scripts/test-copy-drive.mjs" attached "$control" "$SUFFIX" "$APP_PID" "$wid" 2>&1) &&
							[[ $said =~ ^[0-9\ ]*$ ]]; then
							attached=$said said=""
						fi
						if [[ -n $said ]]; then
							copy_silent=1
							echo "test-copy: the copy did not say which windows are attached to window $wid (${said#test-copy: }); capturing the window alone, without a sheet or alert over it" >&2
						fi
					fi
					# shellcheck disable=SC2086 # numbers separated by spaces
					lines=$(ask_macos bounds "$APP_PID" "$wid" $attached)
					if [[ $'\n'$lines == *$'\n'"$wid "* ]] && capture_windows "$lines"; then
						mv -fh -- "$pending_dir/picture.png" "$file"
						count=$(($(wc -l <<<"$lines") - 1))
						echo "Captured window $wid of $NAME$( ((count == 0)) || echo ", with the $count window(s) attached to it drawn where they sit,") into $(tidy "$file")."
						break
					fi
				fi
			fi
			if ((SECONDS >= deadline)); then
				what=window
				((menu == 0)) || what=menu
				[[ -z $capture_problem ]] || die "could not capture the copy's $what within $limit seconds: $capture_problem"
				((menu == 0)) || die "the copy has no menu open after $limit seconds; open one first, with the computer tool in a copy whose suffix begins with test"
				die "the copy has no window${title:+ called '$title'} after $SHOT_LIMIT seconds"
			fi
			sleep 0.5
		done
		;;
	conversations)
		names "${1-}"; shift
		(($# == 0)) || die "use: scripts/test-copy conversations $SUFFIX"
		require_engine
		node "$ROOT/scripts/test-copy-drive.mjs" "$cmd" "$DATA/engine.sock" "$SUFFIX"
		;;
	socket)
		names "${1-}"; shift
		(($# == 0)) || die "use: scripts/test-copy socket $SUFFIX"
		require_engine
		echo "$DATA/engine.sock"
		;;
	call)
		names "${1-}"; shift
		[[ -n ${1-} && $# -le 2 ]] || die "use: scripts/test-copy call $SUFFIX <method> [<json params>]"
		method=$1 params=${2-'{}'}
		require_engine
		[[ ! -L $DIR/answer-key ]] || die "refusing a symlink for the copy's answer key"
		node --input-type=module - "$DATA/engine.sock" "$method" "$params" "$DIR/answer-key" <<'JS'
import { readFileSync } from 'node:fs';
import { connect } from 'node:net';
const [path, method, json, keyFile] = process.argv.slice(2);
// The key the copy's engine wrote for test-copy, with which it takes answers for the person from this connection too
// (#504). Read from its file, never passed on a command line.
let key;
try { key = readFileSync(keyFile, 'utf8').trim(); } catch {}
let params;
try {
	params = JSON.parse(json);
	if (params === null || typeof params !== 'object' || Array.isArray(params)) throw new Error('expected a JSON object');
} catch (error) {
	console.error(`test-copy: invalid JSON params: ${error.message}`);
	process.exit(1);
}
const socket = connect(path);
let buffer = '', done = false;
const timer = setTimeout(() => fail('the engine did not answer within ten minutes'), 600_000);
function finish() {
	done = true;
	clearTimeout(timer);
	socket.destroy();
}
function fail(message) {
	if (done) return;
	console.error(`test-copy: ${message}`);
	process.exitCode = 1;
	finish();
}
socket.once('connect', () => {
	if (key) socket.write(JSON.stringify({ id: 0, method: 'test-copy.answerer', params: { key } }) + '\n');
	socket.write(JSON.stringify({ id: 1, method, params }) + '\n');
});
socket.once('error', error => fail(error.message));
socket.once('close', () => { if (!done) fail('the connection to the engine closed before it answered'); });
socket.setEncoding('utf8').on('data', chunk => {
	buffer += chunk;
	const lines = buffer.split('\n');
	buffer = lines.pop();
	try {
		for (const line of lines) {
			const answer = JSON.parse(line);
			if (answer.event === undefined && answer.id === 0 && answer.error !== undefined) console.error(`test-copy: the copy's engine did not take its key: ${answer.error}`);
			// Events (including a conversation event with its own id) are not the response.
			if (answer.event !== undefined || answer.id !== 1) continue;
			console.log(JSON.stringify(answer));
			if (answer.error !== undefined) process.exitCode = 1;
			finish();
			return;
		}
	} catch (error) { fail(`invalid engine response: ${error.message}`); }
});
JS
		;;
	send)
		names "${1-}"; shift
		(($# >= 2)) || die "use: scripts/test-copy send $SUFFIX <conversation> <text> [--timeout <seconds>]"
		conversation=$1 message=$2 seconds=600; shift 2
		while (($#)); do
			case $1 in
				--timeout) [[ -n ${2-} ]] || die "--timeout needs seconds"; seconds=$2; shift 2 ;;
				*) die "unknown option $1" ;;
			esac
		done
		require_engine
		node "$ROOT/scripts/test-copy-send.mjs" "$DATA/engine.sock" "$conversation" "$message" "$seconds"
		;;
	answer-of)
		names "${1-}"; shift
		(($# >= 2)) || die "use: scripts/test-copy answer-of $SUFFIX <conversation> <submission> [--timeout <seconds>]"
		conversation=$1 submission=$2 seconds=600; shift 2
		while (($#)); do
			case $1 in
				--timeout) [[ -n ${2-} ]] || die "--timeout needs seconds"; seconds=$2; shift 2 ;;
				*) die "unknown option $1" ;;
			esac
		done
		require_engine
		node "$ROOT/scripts/test-copy-send.mjs" answer-of "$DATA/engine.sock" "$conversation" "$submission" "$seconds"
		;;
	pair|attach)
		names "${1-}"; shift
		sim="" route="" phone_env=(--env PI2_TRANSPORT=remote)
		while (($#)); do
			case $1 in
				--env)
					[[ ${2-} =~ ^[A-Z][A-Z0-9_]*=. ]] || die "--env needs NAME=VALUE for the phone's app, such as PI2_HUB_ACT=send:Hello"
					case ${2%%=*} in
						PI2_PAIR|PI2_TRANSPORT|PI2_SHOW) die "--env does not take ${2%%=*}: this script sets it (--show for PI2_SHOW)" ;;
					esac
					phone_env+=(--env "$2"); shift 2 ;;
				--sim) [[ -n ${2-} ]] || die "--sim needs the name of a simulator scripts/iphone-sim create made, such as pi2-681"; sim=$2; shift 2 ;;
				--show) [[ -n ${2-} ]] || die "--show needs the phone's route, such as 'project:Demo project' (PI2_SHOW, docs/iphone-app.md)"; route=$2; shift 2 ;;
				*) die "unknown option $1" ;;
			esac
		done
		[[ $route != *$'\n'* && $route != *$'\r'* ]] || die "--show takes one line"
		require_copy
		require_engine
		((REMOTE)) || die "the copy $SUFFIX was not started with --remote, so it has no remote access for a phone: stop it, and start it again with --remote"
		[[ $cmd == pair || -n $PHONE_DEVICE ]] || die "no phone was paired with $SUFFIX: scripts/test-copy pair $SUFFIX first"
		phone_simulator "$sim"
		[[ -z $route ]] || phone_env+=(--env "PI2_SHOW=$route")

		if [[ $cmd == attach ]]; then
			[[ $SIM == "$PHONE_SIM" ]] || die "the phone paired with $SUFFIX is in the simulator $PHONE_SIM, not $SIM"
			# The simulator forgets its enrolled face when it shuts down: enrolled again, the phone's presence key still
			# signs under its Face ID there.
			"$ROOT/scripts/iphone-sim" face-id "$SIM" enrol >/dev/null || die "could not enrol a face in $SIM"
			before=$(engine_call devices.watch | from_json "r.sessions.map((s) => s.session).join(' ')")
			since=$(($(date +%s) * 1000))
			pid=$(launch_phone "${phone_env[@]}")
			echo "Launched the app in $SIM (process $pid); answering its Face ID with a matching face."
			attach_phone 120 "$before" "$since"
			exit 0
		fi

		# A phone paired before is unpaired first, as the person would remove it on the Devices page: the fresh install
		# below has no keys of it left.
		if [[ -n $PHONE_DEVICE ]]; then
			engine_call devices.revoke "{\"device\":\"$PHONE_DEVICE\"}" >/dev/null
			echo "Revoked $PHONE_DEVICE, the phone paired before."
			PHONE_DEVICE="" PHONE_SIM="" PHONE_ADDRESS=""
			save_state
		fi
		# The new phone knows the new pairing's address alone.
		stop_forward

		# Face ID enrolled, which making the phone's keys needs; this boots the simulator too, which can take a minute or
		# two, before the pairing's five minutes start.
		"$ROOT/scripts/iphone-sim" face-id "$SIM" enrol >/dev/null || die "could not enrol a face in $SIM"

		# 1. A pairing, opened as the Devices page opens one: the payload the Mac would show as a QR code. pi² Remote starts
		#    for it, and is held to 127.0.0.1 before the phone is given the code.
		devices=$(engine_call devices.watch)
		[[ $(from_json 'r.remote.on && r.remote.preview && r.remote.home && !r.remote.direct' <<<"$devices") == true ]] ||
			die "remote access is no longer on as start --remote left it in $SUFFIX: $(from_json r.remote <<<"$devices")"
		payload=$(engine_call devices.pairStart | from_json r.payload)
		[[ $payload == pi2://pair\?* ]] || die "the copy's engine gave no pairing payload"
		addresses=$(node -e 'console.log(new URL(process.argv[1]).searchParams.get("a"))' "$payload")
		[[ $addresses =~ ^127\.0\.0\.1:[0-9]+$ ]] || { engine_call devices.pairCancel >/dev/null; die "the pairing names addresses other than 127.0.0.1 ($addresses); nothing was given to the phone"; }
		require_loopback_helper
		echo "Opened a pairing on $NAME; its pi² Remote listens on $addresses alone."

		# 2. The code, as the phone would scan it: a fresh install of the debug build, given it in PI2_PAIR, which it takes
		#    as scanned.
		since=$(($(date +%s) * 1000))
		pid=$(launch_phone --fresh "${phone_env[@]}" --env "PI2_PAIR=$payload")
		echo "Gave the code to a fresh install of the app in $SIM (process $pid)."

		# 3. The six digits the phone shows, read from its log (the debug build says them there, in the simulator, for a
		#    code from PI2_PAIR), once the copy's engine has the phone's claim.
		deadline=$((SECONDS + 120)) digits=""
		while [[ -z $digits ]]; do
			sleep 2
			devices=$(engine_call devices.watch)
			if [[ $(from_json 'r.pairingWindow === null' <<<"$devices") == true ]]; then
				die "the pairing closed before the phone's digits were typed: $(from_json 'r.closed && r.closed.why' <<<"$devices")"
			fi
			claim=$(from_json 'r.pairingWindow.claim && r.pairingWindow.claim.name' <<<"$devices")
			logged=$(xcrun simctl spawn "$UDID" log show --last 10m --style compact \
				--predicate "subsystem == \"dev.pi2.ios\" AND category == \"pairing\" AND processID == $pid" 2>/dev/null || true)
			shown=$(grep -o 'digits shown: [0-9]\{6\}' <<<"$logged" | sort -u || true)
			if [[ $logged == *"the keys were not made"* ]]; then
				engine_call devices.pairCancel >/dev/null
				die "the phone could not make its keys, so it sent no claim: ${logged##*\] }"
			fi
			if [[ -n $claim && -n $shown ]]; then
				# One claim, and one set of digits from this launch: anything else is not typed.
				(($(wc -l <<<"$shown") == 1)) || { engine_call devices.pairCancel >/dev/null; die "the phone showed more than one set of digits: $shown"; }
				digits=${shown#digits shown: }
			elif ((SECONDS >= deadline)); then
				engine_call devices.pairCancel >/dev/null
				die "no claim with digits within 120 seconds (claim: ${claim:-none}; the phone's pairing log: ${logged:-nothing}); see the phone with scripts/iphone-sim shot $SIM <file.png>"
			fi
		done
		echo "The phone ($claim) shows $digits; typing them on the Mac."

		# 4. Typed on the Mac, as the person types them in the sheet. The engine compares them with the claim's, and pairs
		#    only if they match; if not, the pairing is closed and nothing is tried again.
		if ! confirmed=$("$ROOT/scripts/test-copy" call "$SUFFIX" devices.pairConfirm "{\"digits\":\"$digits\"}" 2>&1); then
			engine_call devices.pairCancel >/dev/null
			die "the Mac refused the digits the phone shows, so nothing was paired: $confirmed"
		fi
		PHONE_DEVICE=$(from_json r.device <<<"$confirmed")
		[[ $PHONE_DEVICE =~ ^dev_[A-Za-z0-9_-]+$ ]] || die "the copy's engine paired no device: $confirmed"
		PHONE_SIM=$SIM PHONE_ADDRESS=$addresses
		save_state
		echo "Paired $PHONE_DEVICE with $NAME."

		# 5. Attached: the app goes on by itself after "Paired", and asks Face ID for its session.
		attach_phone 120 "" "$since"
		echo "Picture it with scripts/iphone-sim shot $SIM <file.png>; launch it again, attached, with scripts/test-copy attach $SUFFIX [--show <route>]."
		;;
	remote-off|remote-on)
		names "${1-}"; shift
		(($# == 0)) || die "use: scripts/test-copy $cmd $SUFFIX"
		require_copy
		require_engine
		((REMOTE)) || die "the copy $SUFFIX was not started with --remote, so it has no remote access to turn off or on: stop it, and start it again with --remote"
		if [[ $cmd == remote-off ]]; then
			# Off as the person turns it off in Settings › Devices: the engine stops pi² Remote, and the port the phone knows
			# is left with nothing on it.
			stop_forward
			out=$(engine_call devices.set '{"on":false}')
			[[ $(from_json 'r.remote.on' <<<"$out") == false ]] || die "the copy's engine did not turn remote access off: $out"
			waited=0
			while [[ -n $(helper_pids) ]]; do
				((waited < STOP_LIMIT * 2)) ||
					die "remote access is off in $NAME, but its pi² Remote ($(helper_pids | tr '\n' ' ')) still runs $STOP_LIMIT seconds later"
				sleep 0.5
				waited=$((waited + 1))
			done
			echo "Remote access is off in $NAME, and its pi² Remote has stopped${PHONE_DEVICE:+: the phone paired with it is out of reach}. Turn it on again with scripts/test-copy remote-on $SUFFIX."
			exit 0
		fi
		before=$(engine_call devices.watch | from_json "r.sessions.map((s) => s.session).join(' ')")
		since=$(($(date +%s) * 1000))
		remote_on
		if [[ -z $PHONE_DEVICE ]]; then
			echo "Remote access is on in $NAME; its pi² Remote starts with a pairing (scripts/test-copy pair $SUFFIX)."
			exit 0
		fi
		# pi² Remote starts again for the paired phone, on a port of its own choosing; held to 127.0.0.1 before the phone's
		# address is forwarded to it.
		waited=0 port=""
		while port=$(helper_port) && [[ -z $port ]]; do
			((waited < START_LIMIT * 2)) ||
				die "the copy's pi² Remote was not listening within $START_LIMIT seconds of remote access going on; $(tidy "$DATA")/remote.log may say why"
			sleep 0.5
			waited=$((waited + 1))
		done
		if ! why=$(loopback_helper_problem); then
			engine_call devices.set '{"on":false}' >/dev/null
			die "$why; remote access was turned off again, and nothing was forwarded"
		fi
		forward_phone_address "$port"
		phone_simulator "$PHONE_SIM"
		"$ROOT/scripts/iphone-sim" face-id "$SIM" enrol >/dev/null || die "could not enrol a face in $SIM"
		echo "Remote access is on in $NAME; waiting for the phone to come back (it tries again within a minute), answering its Face ID with a matching face."
		attach_phone 120 "$before" "$since"
		;;
	stop)
		names "${1-}"
		[[ -d $DIR ]] ||
			die "no copy named $SUFFIX was started from this checkout ($(tidy "$DIR") is not there). A copy is stopped from the checkout that started it"
		echo "Stopping $NAME ($ID):"
		stop_copy
		echo "Stopped and removed $NAME. Nothing of it is left: no process, copy, data folder, preferences, Keychain item,"
		echo "Launch Services entry or browser files."
		;;
	status)
		if [[ -z ${1-} ]]; then
			found=0
			for d in "$COPIES"/*/; do
				[[ -d $d ]] || continue
				found=1
				"$0" status "$(basename "$d")" || true
			done
			((found)) || echo "No copies started from this checkout."
			exit 0
		fi
		names "$1"
		[[ -d $DIR ]] || die "no copy named $SUFFIX was started from this checkout"
		load_state || true
		follow_engine
		state() { if is_recorded "$1" "$2" "$3"; then echo "$1, running"; elif [[ -n $1 ]]; then echo "$1, exited"; else echo "none recorded"; fi; }
		echo "$NAME ($ID)${SHOW:+, showing $SHOW}${APPEARANCE:+, $APPEARANCE appearance}"
		echo "  copy              $(tidy "$APP")"
		echo "  data folder       $(tidy "$DATA")"
		echo "  Keychain service  $SERVICE"
		echo "  app pid           $(state "$APP_PID" "$APP_START" "$APP_EXE")"
		echo "  engine pid        $(state "$ENGINE_PID" "$ENGINE_START" "$ENGINE_EXE")"
		((REMOTE == 0)) || echo "  remote access     on (start --remote)${PHONE_DEVICE:+; paired with $PHONE_DEVICE in the simulator $PHONE_SIM}"
		[[ -z $FORWARD_PID ]] || echo "  forwarder         $(state "$FORWARD_PID" "$FORWARD_START" "$FORWARD_EXE"), from $PHONE_ADDRESS, the address the phone knows"
		;;
	""|-h|--help|help) usage ;;
	*) usage >&2; exit 1 ;;
esac
