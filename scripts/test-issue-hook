#!/bin/bash
# Checks scripts/issue-hook by feeding it the JSON Claude Code sends, against
# throwaway git repositories in a temporary folder and transcripts written by
# hand. Touches no GitHub issue and no file outside that folder. The hook takes
# "this repository" to be the one it is in, so each throwaway repository gets a
# copy of it, and the copy that is run is the one the session's project has.
#
#   scripts/test-issue-hook

set -uo pipefail

source_hook="$(cd -P -- "$(dirname -- "$0")" && pwd -P)/issue-hook"
command -v jq >/dev/null || { echo "test-issue-hook: needs jq" >&2; exit 1; }

T=$(mktemp -d)
trap 'rm -rf "$T"' EXIT
R=$(cd -P -- "$T" && pwd -P) # the real path, in case $T is reached through a link

git_() { git -c user.name=test -c user.email=test@example.invalid -c commit.gpgsign=false "$@" >/dev/null 2>&1; }

# give_hook <repository>: a copy of the hook in its scripts/, committed, so
# that its worktrees have one too.
give_hook() {
	mkdir -p "$1/scripts"
	cp "$source_hook" "$1/scripts/issue-hook"
	git_ -C "$1" add scripts/issue-hook
	git_ -C "$1" commit -q -m hook
}

repo=$R/repo
mkdir -p "$repo/src" "$repo/.claude" "$R/elsewhere"
git_ init -q "$repo"
give_hook "$repo"
echo x >"$repo/src/a.txt"
ln -s "$repo" "$R/link"            # the same repository reached through a link
git_ -C "$repo" worktree add -q "$R/wt"
inner=$repo/.claude/worktrees/in    # a worktree where pi² and Claude Code put theirs
git_ -C "$repo" worktree add -q "$inner"
mkdir -p "$inner/src" "$inner/.claude"
echo x >"$inner/src/a.txt"
mkdir -p "$R/my repo/src"
git_ init -q "$R/my repo"
give_hook "$R/my repo"
mkdir -p "$repo/nested/src"         # another repository, inside this one's folder
git_ init -q "$repo/nested"
give_hook "$repo/nested"
cp "$source_hook" "$R/elsewhere/issue-hook" # a copy in no repository

hook=$repo/scripts/issue-hook       # the hook of the project the session is in

# Transcript lines as Claude Code writes them, one JSON object a line.
# call <id> <command>: the agent runs a shell command.
call() {
	jq -cn --arg id "$1" --arg c "$2" '{type: "assistant", message: {role: "assistant",
		content: [{type: "tool_use", id: $id, name: "Bash", input: {command: $c, description: "x"}}]}}'
}
# result <id> <output>: what it printed, as a string; result_parts as text parts.
result() {
	jq -cn --arg id "$1" --arg o "$2" '{type: "user", message: {role: "user",
		content: [{type: "tool_result", tool_use_id: $id, content: $o, is_error: false}]},
		toolUseResult: {stdout: $o, stderr: "", interrupted: false}}'
}
result_parts() {
	jq -cn --arg id "$1" --arg o "$2" '{type: "user", message: {role: "user",
		content: [{type: "tool_result", tool_use_id: $id, content: [{type: "text", text: $o}]}]}}'
}
# read_file <id> <path>: the agent calls another tool, here Read.
read_file() {
	jq -cn --arg id "$1" --arg p "$2" '{type: "assistant", message: {role: "assistant",
		content: [{type: "tool_use", id: $id, name: "Read", input: {file_path: $p}}]}}'
}
# says <text>: the agent writes text; asks <text>: the person does.
says() { jq -cn --arg t "$1" '{type: "assistant", message: {role: "assistant", content: [{type: "text", text: $t}]}}'; }
asks() { jq -cn --arg t "$1" '{type: "user", message: {role: "user", content: $t}}'; }
# bang <command> <output>: the person runs a command with "!".
bang() {
	jq -cn --arg c "$1" '{type: "user", message: {role: "user", content: ("<bash-input>" + $c + "</bash-input>")}}'
	jq -cn --arg o "$2" '{type: "user", message: {role: "user",
		content: ("<bash-stdout>" + $o + "</bash-stdout><bash-stderr></bash-stderr>")}}'
}

take7='[pi2-issue] working on #7 https://example.invalid/7'
wait7='[pi2-issue] paused #7 (waiting)'
# Another session's transcript, as an agent might print it: the line is there
# both inside its JSON and on a line of its own.
other='{"type":"user","message":{"content":[{"type":"tool_result","content":"[pi2-issue] working on #7 https://example.invalid/7"}]}}
[pi2-issue] working on #7 https://example.invalid/7'

: >"$R/none.jsonl"
{ call a 'scripts/issue take 7'; result a "$take7"; } >"$R/active.jsonl"
{ call a 'scripts/issue take 7'; result a "$take7"; call b 'scripts/issue wait 7 "a decision"'; result b "$wait7"; } >"$R/paused.jsonl"
{ call a 'scripts/issue skip "no network"'; result a '[pi2-issue] skipped: no network'; } >"$R/skipped.jsonl"
ln -s "$R/active.jsonl" "$R/active-link.jsonl"

# A line the session only quoted is not its own (#184). Each of these has one
# such line for #7 and no issue of the session's own.
{ call a 'cat ../other/session.jsonl'; result a "$other"; } >"$R/quoted-cat.jsonl"
{ call a 'gh issue view 7 --comments'; result_parts a "$other"; } >"$R/quoted-gh.jsonl"
{ call a 'cat notes.txt scripts/issue'; result a "$take7"; } >"$R/quoted-named.jsonl"
{ call a "scripts/issue-hook stop <input.json; cat log.txt"; result a "$take7"; } >"$R/quoted-other-script.jsonl"
{ call a 'scripts/issue list'; result a "  #7  $take7"; } >"$R/quoted-mid-line.jsonl"
{ read_file a scripts/issue; result a "$take7"; } >"$R/quoted-read.jsonl"
{ says "$take7"; } >"$R/quoted-said.jsonl"
{ asks "$take7"; } >"$R/quoted-asked.jsonl"
{ result a "$take7"; } >"$R/quoted-no-call.jsonl"
{ bang 'cat ../other/session.jsonl' "$other"; } >"$R/quoted-bang.jsonl"
{ bang 'scripts/issue list' '== in progress'; bang 'cat ../other/session.jsonl' "$other"; } >"$R/quoted-bang-after.jsonl"
{ bang 'scripts/issue list' '== in progress'; asks 'look at this'; asks "<bash-stdout>$take7</bash-stdout>"; } >"$R/quoted-bang-gap.jsonl"

# And these are the session's own: scripts/issue run in other ways, or printed
# among other lines.
{ call a './scripts/issue take 7'; result a "$take7"; } >"$R/own-dot.jsonl"
{ call a '"$CLAUDE_PROJECT_DIR"/scripts/issue take 7'; result a "$take7"; } >"$R/own-project-dir.jsonl"
{ call a "$repo/scripts/issue take 7"; result a "$take7"; } >"$R/own-absolute.jsonl"
{ call a "cd src && ../scripts/issue take 7 2>&1"; result a "$take7"; } >"$R/own-after-cd.jsonl"
{ call a $'git status\nscripts/issue take 7'; result a $'On branch main\n'"$take7"; } >"$R/own-second-line.jsonl"
{ call a 'scripts/issue take 7'; result_parts a "$take7"; } >"$R/own-parts.jsonl"
{ call a 'scripts/issue take 7'; echo '{not json'; result a "$take7"; } >"$R/own-bad-line.jsonl"
{ bang 'scripts/issue take 7' "$take7"; } >"$R/own-bang.jsonl"
# Its own line first, then quoted ones that would close or pause it.
{ call a 'scripts/issue take 7'; result a "$take7"; call b 'cat ../other/session.jsonl'
	result b $'[pi2-issue] closed #7 (completed)\n[pi2-issue] paused #7 (waiting)'; } >"$R/own-then-quoted.jsonl"
{ call a 'cat ../other/session.jsonl'; result a '[pi2-issue] closed #7 (completed)'
	call b 'scripts/issue take 7'; result b "$take7"; } >"$R/own-after-quoted.jsonl"

pass=0 fail=0

# expect <allow|deny|paused> <description> <cwd> <file> <transcript> [env...]
# runs $hook, as Claude Code runs the project's own.
expect() {
	local want=$1 what=$2 cwd=$3 file=$4 transcript=$5 out got
	shift 5
	out=$(jq -n --arg c "$cwd" --arg f "$file" --arg t "$transcript" \
		'{session_id: "s", transcript_path: $t, cwd: $c, hook_event_name: "PreToolUse",
		  tool_name: "Write", tool_input: {file_path: $f, content: "x"}}' |
		env "$@" "$hook" edit)
	if [[ -z $out ]]; then got=allow
	elif [[ $out == *'waiting or blocked'* ]]; then got=paused
	elif [[ $out == *'"deny"'* ]]; then got=deny
	else got="unexpected output: $out"
	fi
	report "$want" "$got" "edit: $what"
}

# A stand-in for gh, first on the PATH the stop check is run with. It answers
# "gh issue view N --json state,labels" as GH_ANSWER_N, or else GH_ANSWER, says
# (open, closed, waiting, garbage, fail or hang), and notes where it ran and
# what it was asked in $R/gh-calls.
mkdir "$R/gh-bin"
cat >"$R/gh-bin/gh" <<'EOF'
#!/bin/bash
echo "$PWD $*" >>"$GH_CALLS"
v=GH_ANSWER_$3
case ${!v:-${GH_ANSWER:-open}} in
	open) echo '{"labels":[{"name":"agent"},{"name":"in progress"}],"state":"OPEN"}' ;;
	closed) echo '{"labels":[{"name":"agent"}],"state":"CLOSED"}' ;;
	waiting) echo '{"labels":[{"name":"agent"},{"name":"waiting"}],"state":"OPEN"}' ;;
	garbage) echo 'not what was asked for' ;;
	fail) echo 'error connecting to api.github.com' >&2; exit 1 ;;
	hang) echo $$ >"$GH_PID"; exec sleep 60 ;;
esac
EOF
chmod +x "$R/gh-bin/gh"

# expect_stop <block|quiet|warn|unasked> <description> <transcript> [stop_hook_active [env...]]
# block: it asks for the issue's status; warn: it tells the person GitHub could
# not be asked; quiet: it said nothing after asking GitHub; unasked: it said
# nothing and did not ask. Passes when gh was asked only what it should be.
expect_stop() {
	local want=$1 what=$2 transcript=$3 active=${4-false} out got
	shift 3; shift || true
	: >"$R/gh-calls"
	out=$(jq -n --arg t "$transcript" --argjson a "$active" \
		'{session_id: "s", transcript_path: $t, hook_event_name: "Stop", stop_hook_active: $a}' |
		env PATH="$R/gh-bin:$PATH" GH_CALLS="$R/gh-calls" GH_PID="$R/gh-pid" "$@" "$hook" stop)
	if [[ -z $out && ! -s $R/gh-calls ]]; then got=unasked
	elif [[ -n $(grep -v "^$repo/scripts issue view [0-9]* --json state,labels\$" "$R/gh-calls") ]]; then
		got="gh asked: $(cat "$R/gh-calls")"
	elif [[ -z $out ]]; then got=quiet
	elif [[ $out == *'"block"'*'#7'* ]]; then got=block
	elif [[ $out == *'"systemMessage"'*'#7'* ]]; then got=warn
	else got="unexpected output: $out"
	fi
	report "$want" "$got" "stop: $what"
}

report() {
	if [[ $1 == "$2" ]]; then
		pass=$((pass + 1))
	else
		fail=$((fail + 1))
		echo "FAIL $3: expected $1, got $2"
	fi
}

none=$R/none.jsonl active=$R/active.jsonl paused=$R/paused.jsonl

for base in "$repo" "$R/link" "$T/repo"; do
	expect deny "no issue, existing file, via $base" "$base" "$base/src/a.txt" "$none"
	expect deny "no issue, new file in new folders, via $base" "$base" "$base/new/deeper/b.txt" "$none"
	expect allow "issue in progress, via $base" "$base" "$base/src/a.txt" "$active"
	expect allow "issue in progress, new folders, via $base" "$base" "$base/new/deeper/b.txt" "$active"
	expect paused "issue paused, via $base" "$base" "$base/src/a.txt" "$paused"
	expect allow "skipped, via $base" "$base" "$base/src/a.txt" "$R/skipped.jsonl"
	expect allow ".git/, via $base" "$base" "$base/.git/info/exclude" "$none"
	expect allow ".claude/, via $base" "$base" "$base/.claude/settings.local.json" "$none"
	expect allow ".claude/, new folder, via $base" "$base" "$base/.claude/new/x.md" "$none"
	expect allow "outside the repository, via $base" "$base" "$R/elsewhere/x.txt" "$none"
	expect allow "outside, new folder, via $base" "$base" "$R/elsewhere/new/x.txt" "$none"
done

# The session in one form, the file in the other.
expect deny "cwd real, file through the link" "$repo" "$R/link/src/a.txt" "$none"
expect deny "cwd through the link, file real" "$R/link" "$repo/src/a.txt" "$none"
expect deny "cwd in a subfolder" "$R/link/src" "$repo/src/a.txt" "$none"

# Paths given relative to cwd, and ones with . and .. in them.
expect deny "relative path" "$R/link" "src/a.txt" "$none"
expect deny "relative path into new folders" "$R/link" "new/b.txt" "$none"
expect allow "relative path, issue in progress" "$R/link" "src/a.txt" "$active"
expect allow "relative path to .claude/" "$R/link/src" "../.claude/x.md" "$none"
expect allow "relative path out of the repository" "$R/link" "../elsewhere/x.txt" "$none"
expect deny "existing folder then .." "$R/link" "$R/link/src/../b.txt" "$none"
expect deny "new folder then .." "$R/link" "$R/link/new/../b.txt" "$none"
expect allow "new folder then .. out of the repository" "$R/link" "$R/link/new/../../elsewhere/b.txt" "$none"
expect deny ".claude/ then .. back into the repository" "$R/link" "$R/link/.claude/../src/b.txt" "$none"

# A worktree is a checkout of its own, with its own top, and a copy of the hook
# of its own: a session started in it runs that one.
hook=$R/wt/scripts/issue-hook
expect deny "worktree, no issue" "$R/wt" "$R/wt/src/a.txt" "$none"
expect allow "worktree, issue in progress" "$R/wt" "$R/wt/src/a.txt" "$active"
expect allow "worktree, its .claude/" "$R/wt" "$R/wt/.claude/x.md" "$none"
hook=$inner/scripts/issue-hook
expect deny "worktree under .claude/worktrees, no issue" "$inner" "$inner/src/a.txt" "$none"
expect allow "worktree under .claude/worktrees, issue in progress" "$inner" "$inner/src/a.txt" "$active"
expect allow "worktree under .claude/worktrees, its .claude/" "$inner" "$inner/.claude/x.md" "$none"

# A file is judged by the checkout it is in, whichever one the session is in.
# From a worktree to the main checkout:
for from in "$R/wt" "$inner" "$R/link/.claude/worktrees/in" "$T/wt"; do
	hook=$from/scripts/issue-hook
	expect deny "session in $from, file in the main checkout" "$from" "$repo/src/a.txt" "$none"
	expect deny "session in $from, new file in the main checkout" "$from" "$repo/new/deeper/b.txt" "$none"
	expect allow "session in $from, file in the main checkout, issue in progress" "$from" "$repo/src/a.txt" "$active"
	expect paused "session in $from, file in the main checkout, issue paused" "$from" "$repo/src/a.txt" "$paused"
	expect allow "session in $from, the main checkout's .git/" "$from" "$repo/.git/info/exclude" "$none"
	expect allow "session in $from, the main checkout's .claude/" "$from" "$repo/.claude/settings.local.json" "$none"
	expect allow "session in $from, outside any repository" "$from" "$R/elsewhere/x.txt" "$none"
	expect allow "session in $from, another repository" "$from" "$R/my repo/src/a.txt" "$none"
done
hook=$R/wt/scripts/issue-hook
expect deny "worktree session, main checkout through the link" "$R/wt" "$R/link/src/a.txt" "$none"
expect deny "worktree session, relative path into the main checkout" "$R/wt" "../repo/src/a.txt" "$none"
hook=$inner/scripts/issue-hook
expect deny "worktree under .claude/worktrees, relative path up into the main checkout" "$inner" "../../../src/a.txt" "$none"
expect allow "worktree under .claude/worktrees, relative path up into the main checkout's .claude/" "$inner" "../../x.md" "$none"

# From the main checkout to a worktree, also one under its own .claude/:
hook=$repo/scripts/issue-hook
for base in "$repo" "$R/link" "$repo/src"; do
	expect deny "session in $base, file in a worktree under .claude/worktrees" "$base" "$inner/src/a.txt" "$none"
	expect deny "session in $base, new file in that worktree" "$base" "$inner/new/deeper/b.txt" "$none"
	expect deny "session in $base, that worktree through the link" "$base" "$R/link/.claude/worktrees/in/src/a.txt" "$none"
	expect allow "session in $base, file in that worktree, issue in progress" "$base" "$inner/src/a.txt" "$active"
	expect paused "session in $base, file in that worktree, issue paused" "$base" "$inner/src/a.txt" "$paused"
	expect allow "session in $base, that worktree's own .claude/" "$base" "$inner/.claude/x.md" "$none"
	expect allow "session in $base, that worktree's own git folder" "$base" "$repo/.git/worktrees/in/info/exclude" "$none"
	expect deny "session in $base, file in a worktree elsewhere" "$base" "$R/wt/src/a.txt" "$none"
	expect allow "session in $base, .claude/worktrees but in no worktree" "$base" "$repo/.claude/worktrees/x.md" "$none"
	expect allow "session in $base, .claude/worktrees, a folder that is no worktree" "$base" "$repo/.claude/worktrees/none/src/a.txt" "$none"
done
expect deny "relative path into a worktree under .claude/worktrees" "$repo" ".claude/worktrees/in/src/a.txt" "$none"
expect deny ".claude/ then .. into a worktree's files" "$repo" "$inner/.claude/../src/a.txt" "$none"

# From one worktree to another.
hook=$R/wt/scripts/issue-hook
expect deny "worktree session, file in another worktree" "$R/wt" "$inner/src/a.txt" "$none"
expect allow "worktree session, file in another worktree, issue in progress" "$R/wt" "$inner/src/a.txt" "$active"
expect allow "worktree session, another worktree's .claude/" "$R/wt" "$inner/.claude/x.md" "$none"
hook=$inner/scripts/issue-hook
expect deny "worktree session, file in another worktree, the other way" "$inner" "$R/wt/src/a.txt" "$none"
hook=$repo/scripts/issue-hook

# A different repository is not this one's business, wherever it is.
expect allow "another repository" "$repo" "$R/my repo/src/a.txt" "$none"
expect allow "another repository, new folders" "$repo" "$R/my repo/new/deeper/b.txt" "$none"
expect allow "another repository inside this one's folder" "$repo" "$repo/nested/src/a.txt" "$none"
# The repository is the hook's, not the one the session's folder has moved to:
# a session can move into another repository, or out of any, and still edit
# files here.
for away in "$R/my repo" "$R/my repo/src" "$repo/nested" "$R/elsewhere"; do
	expect deny "session moved to $away, file in this repository" "$away" "$repo/src/a.txt" "$none"
	expect deny "session moved to $away, new file in this repository" "$away" "$repo/new/deeper/b.txt" "$none"
	expect deny "session moved to $away, file in a worktree of it" "$away" "$inner/src/a.txt" "$none"
	expect allow "session moved to $away, file in this repository, issue in progress" "$away" "$repo/src/a.txt" "$active"
	expect paused "session moved to $away, file in this repository, issue paused" "$away" "$repo/src/a.txt" "$paused"
	expect allow "session moved to $away, this repository's .git/" "$away" "$repo/.git/info/exclude" "$none"
	expect allow "session moved to $away, this repository's .claude/" "$away" "$repo/.claude/settings.local.json" "$none"
	expect allow "session moved to $away, a file there" "$away" "$away/x.txt" "$none"
done
expect deny "session moved to another repository, relative path back" "$R/my repo" "../repo/src/a.txt" "$none"
hook=$inner/scripts/issue-hook
expect deny "worktree session moved to another repository, file in the main checkout" "$R/my repo" "$repo/src/a.txt" "$none"
expect deny "worktree session moved out of any repository, file in its worktree" "$R/elsewhere" "$inner/src/a.txt" "$none"
expect allow "worktree session moved to another repository, a file there" "$R/my repo" "$R/my repo/src/a.txt" "$none"
hook=$R/link/scripts/issue-hook
expect deny "the hook run through a link" "$R/elsewhere" "$repo/src/a.txt" "$none"
expect allow "the hook run through a link, another repository" "$R/elsewhere" "$R/my repo/src/a.txt" "$none"
cd "$R/link/src" || exit 1
hook=../scripts/issue-hook
expect deny "the hook run by a relative path" "$R/elsewhere" "$repo/src/a.txt" "$none"
cd "$R" || exit 1
hook=$R/elsewhere/issue-hook
expect allow "a hook in no repository" "$repo" "$repo/src/a.txt" "$none"

# The repository inside this one's folder, and the other repository, are other
# projects, with copies of the hook of their own.
hook=$repo/nested/scripts/issue-hook
expect deny "session in the repository inside, its own file" "$repo/nested" "$repo/nested/src/a.txt" "$none"
expect allow "session in the repository inside, file in the one around it" "$repo/nested" "$repo/src/a.txt" "$none"
hook="$R/my repo/scripts/issue-hook"
expect allow "session in another repository, file in this one" "$R/my repo" "$repo/src/a.txt" "$none"

# A path with a space.
expect deny "space in path, no issue" "$R/my repo" "$R/my repo/src/a b.txt" "$none"
expect allow "space in path, issue in progress" "$R/my repo" "$R/my repo/src/a b.txt" "$active"
expect allow "space in path, outside" "$R/my repo" "$R/elsewhere/a b.txt" "$none"
hook=$repo/scripts/issue-hook

# Not in a repository at all, a missing transcript, and the switches.
expect allow "cwd not in a repository" "$R/elsewhere" "$R/elsewhere/x.txt" "$none"
expect deny "transcript missing" "$repo" "$repo/src/a.txt" "$R/missing.jsonl"
expect allow "transcript through a link" "$R/link" "$R/link/src/a.txt" "$R/active-link.jsonl"
expect allow "PI2_ISSUES=off" "$R/link" "$R/link/src/a.txt" "$none" PI2_ISSUES=off

# Without jq the hook lets everything through quietly.
mkdir "$R/bin"
for tool in git cat grep awk sort cut env; do ln -s "$(command -v "$tool")" "$R/bin/$tool"; done
expect allow "jq missing" "$repo" "$repo/src/a.txt" "$none" PATH="$R/bin"

quoted=("$R"/quoted-*.jsonl) own=("$R"/own-*.jsonl)
for t in "${quoted[@]}"; do
	name=${t##*/quoted-}
	expect deny "line quoted (${name%.jsonl})" "$repo" "$repo/src/a.txt" "$t"
	expect_stop unasked "line quoted (${name%.jsonl})" "$t"
done
for t in "${own[@]}"; do
	name=${t##*/own-}
	expect allow "its own line (${name%.jsonl})" "$repo" "$repo/src/a.txt" "$t"
	expect_stop block "its own line (${name%.jsonl})" "$t"
done

expect_stop block "issue in progress" "$active"
expect_stop block "issue in progress, transcript through a link" "$R/active-link.jsonl"
expect_stop unasked "no issue" "$none"
expect_stop unasked "transcript missing" "$R/missing.jsonl"
expect_stop unasked "issue paused" "$paused"
expect_stop unasked "only skipped" "$R/skipped.jsonl"
expect_stop unasked "already asked once" "$active" true
expect_stop unasked "PI2_ISSUES=off" "$active" false PI2_ISSUES=off

# What GitHub says decides: only an issue still open and in progress there
# holds up the turn.
expect_stop quiet "issue closed on GitHub" "$active" false GH_ANSWER=closed
expect_stop quiet "issue waiting on GitHub" "$active" false GH_ANSWER=waiting
# GitHub cannot be asked: the turn ends, and the person is told.
expect_stop warn "gh fails" "$active" false GH_ANSWER=fail
expect_stop warn "gh answers something else" "$active" false GH_ANSWER=garbage
started=$SECONDS
expect_stop warn "gh does not answer" "$active" false GH_ANSWER=hang PI2_ISSUES_GH_SECONDS=1
report within-5s "$( ((SECONDS - started <= 5)) && echo within-5s || echo "$((SECONDS - started))s")" "stop: gh not answering is given up on"
report stopped "$(kill -0 "$(cat "$R/gh-pid")" 2>/dev/null && echo "still running" || echo stopped)" "stop: gh not answering is stopped"
mkdir "$R/nogh"
for tool in jq git cat grep awk sort cut env mktemp rm sleep; do ln -s "$(command -v "$tool")" "$R/nogh/$tool"; done
expect_stop warn "gh missing" "$active" false PATH="$R/nogh"

# Several issues: each is asked about, and only the one in progress is named.
{ call a 'scripts/issue take 7'; result a "$take7"; call b 'scripts/issue start "Eight"'
	result b '[pi2-issue] opened #8 https://example.invalid/8'; call c 'scripts/issue take 9'
	result c '[pi2-issue] working on #9 https://example.invalid/9'; } >"$R/three.jsonl"
expect_stop block "three issues, one in progress" "$R/three.jsonl" false GH_ANSWER_8=closed GH_ANSWER_9=fail
report 3 "$(wc -l <"$R/gh-calls" | tr -d ' ')" "stop: three issues, each asked about"
out=$(jq -n --arg t "$R/three.jsonl" '{transcript_path: $t, hook_event_name: "Stop"}' |
	env PATH="$R/gh-bin:$PATH" GH_CALLS="$R/gh-calls" GH_ANSWER_8=closed GH_ANSWER_9=fail "$hook" stop)
report "update #7" "$(jq -r '.reason' <<<"$out" | grep -oE 'update [#0-9, ]*[0-9]')" "stop: three issues, only #7 named"

echo "$pass passed, $fail failed"
((fail == 0))
