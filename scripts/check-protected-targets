#!/bin/bash
# Checks that app/Package.swift still builds the owner's targets from the owner's folders, and nothing else (#674).
#
# app/Package.swift is not an owner's path: other pull requests add shared targets to it all the time, and each would
# wait for the owner. But it decides what the targets in the owner's folders are built from, so a pull request that
# changed a protected target's path, left files out, gave it a dependency, a setting, unsafe flags or a plugin, or
# added a package, could get round CODEOWNERS and be merged by scripts/auto-merge. CI's App (build) job runs this on
# every pull request, and fails it if any of that changed. This script is an owner's path itself (.github/CODEOWNERS);
# the issue that adds a protected target adds its line to TARGETS below.
#
# It also fails if any Swift file outside RemoteKit and its two checks names @_spi(Vectors), the entry points that
# take a fixed ephemeral key and the unverified steps of opening an item, which only the checks may use; if any Swift
# file names `@testable import` of RemoteKit or pi² Remote, which would reach what they keep internal; if the package's
# Swift tools version is not the one the owner reviewed; and if the package sets a language mode of its own, which could
# put the protected targets in Swift 5 mode and turn off its data-race checks (a target's own mode is a setting, which
# the list below already refuses).
#
#   scripts/check-protected-targets                  reads `swift package dump-package` of app/
#   scripts/check-protected-targets --dump FILE      reads FILE instead (scripts/test-check-protected-targets)
#   scripts/check-protected-targets --root DIR       looks for @_spi(Vectors) under DIR instead of the checkout
#
# Exits 0 when everything holds, 1 naming each thing that does not, 2 for a wrong argument.

set -uo pipefail

root="$(cd -P -- "$(dirname -- "$0")/.." && pwd -P)"
dump=""
while [[ $# -gt 0 ]]; do
	case $1 in
		--dump) [[ $# -ge 2 ]] || { echo "check-protected-targets: --dump needs a file" >&2; exit 2; }; dump=$2; shift 2 ;;
		--root) [[ $# -ge 2 ]] || { echo "check-protected-targets: --root needs a folder" >&2; exit 2; }; root=$2; shift 2 ;;
		*) echo "check-protected-targets: unknown argument $1" >&2; exit 2 ;;
	esac
done
command -v jq >/dev/null || { echo "check-protected-targets: needs jq" >&2; exit 2; }
command -v perl >/dev/null || { echo "check-protected-targets: needs perl" >&2; exit 2; }

# Each protected target: its name, its type, what it may exclude (a JSON list), the targets it may depend on (a JSON
# list of names, in order) and the build settings it has (a JSON list, as dump-package writes them; none for most).
# Its path must be Sources/<name>, with nothing else in its description: no sources list, no resources, no other
# settings (unsafe flags among them), no plugins, no dependency on a product.
#
# pi² Remote (#675) is three: pi2-remote, the helper's code, whose one setting is PI2_DEVELOPMENT in a debug build (the
# development paths are compiled only under it, and the Keychain, Secure Enclave and Bonjour calls only without it);
# pi2-remote-helper, its program; and pi2-remote-helper-check.
PI2_DEVELOPMENT_IN_DEBUG='[{"condition":{"config":"debug","platformNames":[]},"kind":{"define":{"_0":"PI2_DEVELOPMENT"}},"tool":"swift"}]'
TARGETS=(
	'RemoteKit|regular|[]|[]|[]'
	'pi2-remote-check|executable|["vectors"]|["RemoteKit"]|[]'
	'pi2-remote-fuzz|executable|[]|["RemoteKit"]|[]'
	"pi2-remote|regular|[]|[\"RemoteKit\"]|$PI2_DEVELOPMENT_IN_DEBUG"
	'pi2-remote-helper|executable|[]|["pi2-remote"]|[]'
	'pi2-remote-helper-check|executable|[]|["pi2-remote","RemoteKit"]|[]'
)
# The protected targets no product of the package may name: the checks (a library or executable product would hand the
# test-only entry points, or a stand-in for the checks, to whatever builds on the package) and pi² Remote, which runs
# only as the engine's own child inside the app's bundle (a product would hand it to the iPhone app's project).
NO_PRODUCT='["pi2-remote-check","pi2-remote-fuzz","pi2-remote","pi2-remote-helper","pi2-remote-helper-check"]'
# The targets that may depend on each of pi² Remote's three: its code on its program and its check, and nothing on
# either of those, which carry its code with them.
REMOTE_USERS='{"pi2-remote":["pi2-remote-helper","pi2-remote-helper-check"],"pi2-remote-helper":[],"pi2-remote-helper-check":[]}'
# The Swift tools version the owner reviewed: a new one can change what a description means, and is the owner's.
TOOLS_VERSION='6.0.0'
# The packages app/Package.swift may depend on, by address. A new one is the owner's to allow.
PACKAGES='["https://github.com/sparkle-project/Sparkle"]'
# The fields a target's description may have, as `swift package dump-package` writes them. A field this list does not
# know (a new toolchain's) fails until it is read and added here.
FIELDS='["dependencies","exclude","name","packageAccess","path","pluginUsages","resources","settings","sources","type"]'

if [[ -z $dump ]]; then
	dump=$(mktemp)
	trap 'rm -f "$dump"' EXIT
	if ! (cd "$root/app" && swift package dump-package) >"$dump"; then
		echo "check-protected-targets: swift package dump-package failed" >&2
		exit 1
	fi
fi
jq -e 'type == "object" and (.targets | type == "array")' "$dump" >/dev/null 2>&1 || {
	echo "check-protected-targets: $dump is not a package description" >&2
	exit 1
}

failures=0
fail() {
	echo "check-protected-targets: $*" >&2
	failures=$((failures + 1))
}

protected_paths=()
for entry in "${TARGETS[@]}"; do
	IFS='|' read -r name type exclude dependencies settings <<<"$entry"
	protected_paths+=("Sources/$name")
	count=$(jq --arg name "$name" '[.targets[] | select(.name == $name)] | length' "$dump")
	if [[ $count != 1 ]]; then
		fail "$name: there are $count targets of that name, not one"
		continue
	fi
	target=$(jq -c --arg name "$name" '.targets[] | select(.name == $name)' "$dump")
	unknown=$(jq -r --argjson fields "$FIELDS" 'keys - $fields | join(", ")' <<<"$target")
	[[ -z $unknown ]] || fail "$name: fields this check does not know: $unknown"
	[[ $(jq -r '.path // ""' <<<"$target") == "Sources/$name" ]] || fail "$name: its path is not Sources/$name"
	[[ $(jq -r '.type' <<<"$target") == "$type" ]] || fail "$name: it is not a $type target"
	jq -e --argjson want "$exclude" '(.exclude // []) == $want' <<<"$target" >/dev/null || fail "$name: it excludes other files than $exclude"
	jq -e '.sources == null' <<<"$target" >/dev/null || fail "$name: it lists its sources, which can leave files out"
	jq -e '(.resources // []) == []' <<<"$target" >/dev/null || fail "$name: it has resources"
	jq -e --argjson want "$settings" '(.settings // []) == $want' <<<"$target" >/dev/null ||
		fail "$name: it has other build settings than $settings (unsafe flags among them, or defines)"
	jq -e '(.pluginUsages // []) == []' <<<"$target" >/dev/null || fail "$name: it uses a plugin"
	jq -e --argjson want "$dependencies" '
		(.dependencies // []) | length == ($want | length)
		and all(.[]; has("byName") and (.byName | length == 2) and .byName[1] == null)
		and ([.[].byName[0]] == $want)' <<<"$target" >/dev/null ||
		fail "$name: it depends on other than $dependencies, or on a product, or on a condition"
done

# No other target may be built from a protected folder, or from inside one.
while IFS=$'\t' read -r name path; do
	for protected in "${protected_paths[@]}"; do
		if [[ $path == "$protected" || $path == "$protected/"* ]]; then
			fail "$name: it is built from $path, which is ${protected#Sources/}'s"
		fi
	done
done < <(jq -r --argjson names "$(printf '%s\n' "${TARGETS[@]}" | cut -d'|' -f1 | jq -R . | jq -s .)" '
	.targets[] | select(.name as $n | $names | index($n) | not) | [.name, (.path // ("Sources/" + .name))] | @tsv' "$dump")

# Products: none may name a check or pi² Remote. Products for other targets (PiModels, EngineKit, TranscriptKit for the
# iPhone app) are not this script's to judge.
while IFS= read -r product; do
	fail "the product $product names one of RemoteKit's checks or pi² Remote, which no product may"
done < <(jq -r --argjson checks "$NO_PRODUCT" '
	(.products // [])[] | select([.targets[]?] | any(. as $t | $checks | index($t))) | .name' "$dump")

# pi² Remote's code: only its program and its check depend on it, and nothing on either of them, in any way.
while IFS=$'\t' read -r name used; do
	fail "$name: it depends on $used, $(jq -r --arg used "$used" '.[$used] | if length == 0 then "which no target may depend on" else "which only " + join(" and ") + " may" end' <<<"$REMOTE_USERS")"
done < <(jq -r --argjson users "$REMOTE_USERS" '
	.targets[] | .name as $n | [(.dependencies // [])[] | (.byName // .target // .product // [])[0]] as $deps
	| $users | to_entries[] | select(.key as $k | $deps | index($k)) | select(.value | index($n) | not) | [$n, .key] | @tsv' "$dump")

# The tools version, and no language mode for the whole package.
[[ $(jq -r '.toolsVersion._version // ""' "$dump") == "$TOOLS_VERSION" ]] ||
	fail "the Swift tools version is $(jq -r '.toolsVersion._version // "unknown"' "$dump"), not $TOOLS_VERSION: a new one is the owner's to review"
jq -e '(.swiftLanguageModes // null) == null and (.swiftLanguageVersions // null) == null' "$dump" >/dev/null ||
	fail "the package sets its Swift language modes, which could put the protected targets in Swift 5 mode and turn off their data-race checks"

# Packages: only those allowed, by address; none from a folder on disk.
while IFS= read -r package; do
	fail "a package dependency that is not allowed: $package"
done < <(jq -r --argjson allowed "$PACKAGES" '
	(.dependencies // [])[] |
	if has("sourceControl") then
		(.sourceControl[0].location.remote[0].urlString // "an unknown address") as $url
		| select($allowed | index($url) | not) | $url
	else (to_entries[0].key + " " + (tostring)) end' "$dump")

# @_spi(Vectors): named in RemoteKit, which declares it, and its two checks, which use it; nowhere else.
while IFS= read -r file; do
	relative=${file#"$root"/}
	case $relative in
		app/Sources/RemoteKit/* | app/Sources/pi2-remote-check/* | app/Sources/pi2-remote-fuzz/*) ;;
		*) fail "$relative names @_spi(Vectors), which only RemoteKit's checks may use" ;;
	esac
done < <(grep -rlE --include='*.swift' --exclude-dir=.build --exclude-dir=.git '_spi[[:space:]]*\([[:space:]]*Vectors' "$root" 2>/dev/null)

# @testable import of RemoteKit or pi² Remote: nowhere. Their checks use what is public, or package-wide (`package`).
# Read with line comments taken out, lines joined and block comments taken out, so that an attribute on a line of its
# own or a comment between the words counts; an import of one declaration (`import struct pi2_remote.Startup`) too.
while IFS= read -r file; do
	# Comments and strings read as Swift reads them, from the start: a line comment to its line's end, a block comment
	# to its own end, block comments nested, and neither opening inside the other or inside a string (plain, raw or
	# multi-line), which is taken out whole.
	if perl -0777 -ne 'my $o = ""; my $d = 0; pos($_) = 0;
		while (pos($_) < length) {
			if ($d) { m{\G(/\*|\*/|.)}gcs; $d++ if $1 eq "/*"; $d-- if $1 eq "*/" }
			elsif (m{\G(#*)"""(?s:.*?)"""\1}gc || m{\G(#+)".*?"\1}gc || m{\G"(?:\\.|[^"\\\n])*"}gc) { $o .= q{""} }
			else { m{\G(//[^\n]*|/\*|.)}gcs; if ($1 eq "/*") { $d = 1; $o .= " " } elsif (substr($1, 0, 2) eq "//") { $o .= " " } else { $o .= $1 } }
		}
		$o =~ s/\n/ /g; print $o' "$file" |
		grep -qE '@testable([[:space:]]+@[A-Za-z_]+(\([^)]*\))?)*[[:space:]]+import[[:space:]]+((typealias|struct|class|enum|protocol|let|var|func|actor|macro)[[:space:]]+)?(RemoteKit|pi2_remote)([^A-Za-z0-9_]|$)'; then
		fail "${file#"$root"/} names @testable import of RemoteKit or pi² Remote, which nothing may"
	fi
done < <(grep -rlF --include='*.swift' --exclude-dir=.build --exclude-dir=.git '@testable' "$root" 2>/dev/null)

if [[ $failures -gt 0 ]]; then
	echo "check-protected-targets: $failures thing(s) wrong. The owner's targets must be built from the owner's folders as they are (.github/CODEOWNERS)." >&2
	exit 1
fi
echo "check-protected-targets: ${#TARGETS[@]} protected targets as they should be, Swift tools $TOOLS_VERSION with no package language mode, no product naming a check or pi² Remote, nothing else using pi² Remote's code, no other package, @_spi(Vectors) only in RemoteKit's checks, and no @testable import of either."
