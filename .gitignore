# macOS
.DS_Store

# Engine (Node)
node_modules/
*.log

# App (Swift)
app/.build/
app/build/
*.xcuserstate
xcuserdata/

# iPhone app (Xcode): each person's own data and build output. The project, its shared scheme and its workspace's
# shared data are kept.
iphone/build/
iphone/DerivedData/
*.xcresult

# Local secrets and settings
.env
.env.*

# Working copies made for parallel work, and local Claude Code settings.
# The shared settings (the issue hooks) are kept.
.claude/*
!.claude/settings.json
